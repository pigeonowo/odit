}

@test.tag.{"services"}
@test.it.{"WAT disassembly extracts real WebAssembly text for settings_defaults"}
(t: &test.T) {
    wat_js := services.wat_get_function_json("src/settings.onyx", "settings_defaults", 1, context.temp_allocator);
    t->expect_contains(wat_js, "(func $settings_defaults");
}

// -----------------------------------------------------------------------------
// 6. Live Onyx <-> WASM Debugger Service
// -----------------------------------------------------------------------------

@test.tag.{"debugger"}
@test.it.{"Debugger toggles breakpoints and serializes breakpoints JSON"}
(t: &test.T) {
    services.dbg_init();
    t->expect_eq(services.dbg_toggle_breakpoint("src/settings.onyx", 25), cast(u32) 1);
    t->expect_true(services.dbg_has_breakpoint("src/settings.onyx", 25));

    bp_js := services.dbg_get_breakpoints_json("src/settings.onyx", context.temp_allocator);
    t->expect_contains(bp_js, "\"line\":25");

    t->expect_eq(services.dbg_toggle_breakpoint("src/settings.onyx", 25), cast(u32) 0);
    t->expect_false(services.dbg_has_breakpoint("src/settings.onyx", 25));
}

@test.tag.{"debugger"}
@test.it.{"Live debugger executes real loops, continue, break, call stack, and live locals"}
(t: &test.T) {
    tmp_src := "/tmp/odit_live_dbg_test.onyx";
    code := """use core { printf }

compute :: (n: i32) -> i32 {
    sum := 0;
    for i in 0 .. n {
        if i == 2 do continue;
        if i == 5 do break;
        sum += i * 10;
    }
    return sum;
}

main :: () {
    ans := compute(8);
    printf("final={}\\n", ans);
}
""";
    t->expect_true(os.File.write_contents(tmp_src, code));
    defer os.remove_file(tmp_src);

    services.dbg_init();
    // Line 8 is `sum += i * 10;` inside the loop (after `continue` and `break`!)
    services.dbg_toggle_breakpoint(tmp_src, 8);
    rc := services.dbg_start(tmp_src, tmp_src, 1, 1);
    t->expect_eq(rc, 0);

    // 1st hit: i = 0, sum = 0 (with real 2-frame call stack: compute -> main)
    t->expect_eq(cast(u32) services.dbg_wait_for_stop(), cast(u32) abi.DebugStatus.Paused);
    t->expect_eq(services.g_dbg.current_func, "compute");
    t->expect_eq(services.g_dbg.current_line, cast(u32) 8);
    t->expect_eq(services.g_dbg.frames.count, 2);
    t->expect_eq(services.g_dbg.frames[0].func, "compute");
    t->expect_eq(services.g_dbg.frames[1].func, "main");

    find_var :: (name: str) -> str {
        for &v in services.g_dbg.locals {
            if str.equal(v.name, name) do return v.value;
        }
        return "";
    };
    t->expect_eq(find_var("i"), "0");
    t->expect_eq(find_var("sum"), "0");

    // Continue -> 2nd hit: i = 1, sum = 0
    t->expect_eq(services.dbg_command(.Continue, 1), 0);
    t->expect_eq(cast(u32) services.dbg_wait_for_stop(), cast(u32) abi.DebugStatus.Paused);
    t->expect_eq(find_var("i"), "1");
    t->expect_eq(find_var("sum"), "0");

    // Continue -> i = 2 hits `continue` and MUST BE SKIPPED! 3rd hit MUST be i = 3, sum = 10!
    t->expect_eq(services.dbg_command(.Continue, 1), 0);
    t->expect_eq(cast(u32) services.dbg_wait_for_stop(), cast(u32) abi.DebugStatus.Paused);
    t->expect_eq(find_var("i"), "3");
    t->expect_eq(find_var("sum"), "10");

    // Continue -> 4th hit: i = 4, sum = 40
    t->expect_eq(services.dbg_command(.Continue, 1), 0);
    t->expect_eq(cast(u32) services.dbg_wait_for_stop(), cast(u32) abi.DebugStatus.Paused);
    t->expect_eq(find_var("i"), "4");
    t->expect_eq(find_var("sum"), "40");

    // Step Over on line 8 -> executes `sum += 40` (sum=80), loops to i = 5 -> line 6 (`if i == 2`)
    t->expect_eq(services.dbg_command(.StepOver, 1), 0);
    t->expect_eq(cast(u32) services.dbg_wait_for_stop(), cast(u32) abi.DebugStatus.Paused);
    t->expect_eq(services.g_dbg.current_line, cast(u32) 6);
    t->expect_eq(find_var("i"), "5");
    t->expect_eq(find_var("sum"), "80");

    // Step Over -> line 7 (`if i == 5 do break;`)
    t->expect_eq(services.dbg_command(.StepOver, 1), 0);
    t->expect_eq(cast(u32) services.dbg_wait_for_stop(), cast(u32) abi.DebugStatus.Paused);
    t->expect_eq(services.g_dbg.current_line, cast(u32) 7);

    // Step Over -> `break` MUST exit the loop directly to line 10 (`return sum;`)!
    t->expect_eq(services.dbg_command(.StepOver, 1), 0);
    t->expect_eq(cast(u32) services.dbg_wait_for_stop(), cast(u32) abi.DebugStatus.Paused);
    t->expect_eq(services.g_dbg.current_line, cast(u32) 10);
    t->expect_eq(find_var("sum"), "80");

    // Step Out -> returns back to main() line 15 (`printf`) with ans = 80!
    t->expect_eq(services.dbg_command(.StepOut, 1), 0);
    t->expect_eq(cast(u32) services.dbg_wait_for_stop(), cast(u32) abi.DebugStatus.Paused);
    t->expect_eq(services.g_dbg.current_func, "main");
    t->expect_eq(services.g_dbg.current_line, cast(u32) 15);
    t->expect_eq(find_var("ans"), "80");

    // Continue -> program finishes cleanly and captures stdout `final=80`!
    t->expect_eq(services.dbg_command(.Continue, 1), 0);
    t->expect_eq(cast(u32) services.dbg_wait_for_stop(), cast(u32) abi.DebugStatus.Exited);
    t->expect_eq(services.g_dbg.exit_code, 0);

    st_js := services.dbg_get_state_json(context.temp_allocator);
    t->expect_contains(st_js, "final=80");
}

@test.tag.{"debugger"}
@test.it.{"Debugger parses full onyx run commands with --param flags and entry file"}
(t: &test.T) {
    entry, args, explicit := services.dbg_parse_run_command(
        "onyx run --param 'aoc.day=1' --param aoc.test=true src/day1.onyx",
        context.temp_allocator
    );
    t->expect_eq(entry, "src/day1.onyx");
    t->expect_true(explicit);
    t->expect_eq(args.count, 4);
    t->expect_eq(args[0], "--param");
    t->expect_eq(args[1], "aoc.day=1");
    t->expect_eq(args[2], "--param");
    t->expect_eq(args[3], "aoc.test=true");
}

@test.tag.{"debugger"}
@test.it.{"Debugger parses anonymous @aoc.part1/@aoc.part2 procs and generates unnamed WAT hints"}
(t: &test.T) {
    lines := str.[
        "main :: () {",
        "    aoc.run()",
        "}",
        "@aoc.part1",
        "(input_path: str) -> i32 {",
        "    return 1",
        "}",
        "@aoc.part2",
        "(input_path: str) -> i32 {",
        "    return 2",
        "}",
    ];
    procs := services.parse_procs_in_source(lines, "src/day1.onyx", context.temp_allocator);
    t->expect_eq(procs.count, 3);
    t->expect_eq(procs[0].name, "main");
    t->expect_eq(procs[1].name, "@aoc.part1");
    t->expect_eq(procs[1].wat_hint, "src_day1_onyx_5");
    t->expect_true(procs[1].is_tagged);
    t->expect_eq(procs[2].name, "@aoc.part2");
    t->expect_eq(procs[2].wat_hint, "src_day1_onyx_9");
    t->expect_true(procs[2].is_tagged);
}

@test.tag.{"debugger"}
@test.it.{"Debugger evaluates live Onyx local values, local calls, and WAT stack slots"}
(t: &test.T) {
    lines := str.[
        "main :: () {",
        "    a := 89",
        "    b := 1293",
        "    c := add(a, b)",
        "    d := c * c",
        "    aoc.run()",
        "}",
        "add :: (a: i32, b: i32) -> i32 {",
        "    return a + b",
        "}",
    ];
    procs := services.parse_procs_in_source(lines, "src/day1.onyx", context.temp_allocator);
    vars, _ := services.eval_proc_body(lines, procs, &procs[0], 6);
    t->expect_eq(vars.count, 4);
    t->expect_eq(vars[0].name, "a");
    t->expect_eq(vars[0].val.int_val, cast(i64) 89);
    t->expect_eq(vars[1].name, "b");
    t->expect_eq(vars[1].val.int_val, cast(i64) 1293);
    t->expect_eq(vars[2].name, "c");
    t->expect_eq(vars[2].val.int_val, cast(i64) 1382);
    t->expect_eq(vars[3].name, "d");
    t->expect_eq(vars[3].val.int_val, cast(i64) 1909924);

    // Also verify WAT local slot simulation
    wat := "(func $part1\n  i32.const 1\n  local.set 4\n  i32.const 2\n  local.set 5\n  local.get 4\n  local.get 5\n  i32.add\n  local.set 6)";
    slots, defined := services.eval_wat_locals(wat, 8, .[]);
    t->expect_true(defined[4]);
    t->expect_true(defined[5]);
    t->expect_true(defined[6]);
    t->expect_eq(slots[4], cast(i64) 1);
    t->expect_eq(slots[5], cast(i64) 2);
    t->expect_eq(slots[6], cast(i64) 3);
}

main :: () {
    test.run();
}
