package odit.editor

// =============================================================================
// Onyx Editor ("odit") — Line-Based Code Buffer, File I/O & Undo
// =============================================================================

use core { memory, os, Array }
use odit.abi

GutterMarker :: struct {
    path: str;
    line: u32; // 1-based
    kind: u32; // abi.GutterMarkerKind
    rgba: u32;
}

TextBuffer :: struct {
    path:            str;
    lines:           [..] [..] u8;
    cursor_line:     i32; // 0-based
    cursor_col:      i32; // 0-based byte/char column
    has_sel:         bool;
    sel_anchor_line: i32;
    sel_anchor_col:  i32;
    version:         u32;
    dirty:           bool;

    // Simple undo snapshots (UTF-8 full-buffer text)
    undo_stack:      [..] str;
    gutter_markers:  [..] GutterMarker;
}

buffer_init :: (b: &TextBuffer) {
    b.path            = "";
    b.lines           = make([..] [..] u8);
    b.undo_stack      = make([..] str);
    b.gutter_markers  = make([..] GutterMarker);
    b.cursor_line     = 0;
    b.cursor_col      = 0;
    b.has_sel         = false;
    b.sel_anchor_line = 0;
    b.sel_anchor_col  = 0;
    b.version         = 1;
    b.dirty           = false;

    // Start with one empty line
    first := make([..] u8);
    b.lines << first;
}

buffer_clear_lines :: (b: &TextBuffer) {
    for &ln in b.lines {
        delete(ln);
    }
    Array.clear(&b.lines);
}

buffer_set_text :: (b: &TextBuffer, text: str) {
    buffer_clear_lines(b);

    start := 0;
    for i in 0 .. text.count {
        if text[i] == '\n' {
            end := i;
            if end > start && text[end - 1] == '\r' do end -= 1;
            ln := make([..] u8, end - start + 8);
            for k in start .. end do ln << text[k];
            b.lines << ln;
            start = i + 1;
        }
    }
    // Last line
    end := text.count;
    if end > start && text[end - 1] == '\r' do end -= 1;
    ln := make([..] u8, end - start + 8);
    for k in start .. end do ln << text[k];
    b.lines << ln;

    if b.lines.count == 0 {
        empty := make([..] u8);
        b.lines << empty;
    }

    b.cursor_line = 0;
    b.cursor_col  = 0;
    b.has_sel     = false;
    b.version += 1;
}

buffer_to_string :: (b: &TextBuffer, allocator := context.allocator) -> str {
    total := 0;
    for &ln in b.lines {
        total += ln.count + 1;
    }
    if total > 0 do total -= 1;

    out := make([] u8, total, allocator);
    pos := 0;
    for i in 0 .. b.lines.count {
        ln := &b.lines[i];
        if ln.count > 0 {
            memory.copy(&out[pos], ln.data, ln.count);
            pos += ln.count;
        }
        if i + 1 < b.lines.count {
            out[pos] = '\n';
            pos += 1;
        }
    }
    return out;
}

buffer_byte_len :: (b: &TextBuffer) -> i32 {
    total := 0;
    for &ln in b.lines {
        total += ln.count + 1;
    }
    if total > 0 do total -= 1;
    return total;
}

buffer_cursor_byte_offset :: (b: &TextBuffer) -> u32 {
    off: u32 = 0;
    for i in 0 .. b.cursor_line {
        if i < b.lines.count {
            off += cast(u32) b.lines[i].count + 1;
        }
    }
    off += cast(u32) b.cursor_col;
    return off;
}

buffer_get_abi_cursor :: (b: &TextBuffer) -> abi.EditorCursor {
    off := buffer_cursor_byte_offset(b);
    return .{
        line           = cast(u32) (b.cursor_line + 1),
        column         = cast(u32) (b.cursor_col + 1),
        byte_offset    = off,
        sel_start      = off,
        sel_end        = off,
        buffer_version = b.version,
        is_dirty       = 1 if b.dirty else 0,
    };
}

buffer_load_file :: (b: &TextBuffer, path: str) -> bool {
    contents := os.get_contents(path);
    if contents.data == null && !os.file_exists(path) {
        return false;
    }
    defer delete(&contents);

    b.path = str.copy(path);
    Array.clear(&b.undo_stack);
    buffer_set_text(b, contents);
    b.dirty = false;
    return true;
}

buffer_save_file :: (b: &TextBuffer) -> bool {
    if b.path.count == 0 do return false;
    text := buffer_to_string(b, context.temp_allocator);
    if os.File.write_contents(b.path, text) {
        b.dirty = false;
        b.version += 1;
        return true;
    }
    return false;
}

buffer_push_undo :: (b: &TextBuffer) {
    if b.undo_stack.count >= 64 {
        oldest := b.undo_stack[0];
        str.free(oldest);
        Array.remove_at(&b.undo_stack, 0);
    }
    b.undo_stack << buffer_to_string(b, context.allocator);
}

buffer_undo :: (b: &TextBuffer) -> bool {
    if b.undo_stack.count == 0 do return false;
    snap := b.undo_stack[b.undo_stack.count - 1];
    Array.pop(&b.undo_stack);
    saved_line := b.cursor_line;
    saved_col  := b.cursor_col;
    buffer_set_text(b, snap);
    str.free(snap);
    b.cursor_line = saved_line;
    b.cursor_col  = saved_col;
    buffer_clamp_cursor(b);
    b.dirty = true;
    return true;
}

buffer_clamp_cursor :: (b: &TextBuffer) {
    if b.lines.count == 0 {
        empty := make([..] u8);
        b.lines << empty;
    }
    if b.cursor_line < 0 do b.cursor_line = 0;
    if b.cursor_line >= b.lines.count do b.cursor_line = b.lines.count - 1;
    max_col := b.lines[b.cursor_line].count;
    if b.cursor_col < 0 do b.cursor_col = 0;
    if b.cursor_col > max_col do b.cursor_col = max_col;
}

buffer_set_cursor_1based :: (b: &TextBuffer, line: i32, col: i32) {
    b.cursor_line = line - 1;
    b.cursor_col  = col - 1;
    buffer_clamp_cursor(b);
}

buffer_insert_char :: (b: &TextBuffer, ch: u8) {
    buffer_clamp_cursor(b);
    ln := &b.lines[b.cursor_line];
    Array.insert(ln, b.cursor_col, ch);
    b.cursor_col += 1;
    b.dirty = true;
    b.version += 1;
}

buffer_insert_newline :: (b: &TextBuffer, auto_indent: bool = true) {
    buffer_push_undo(b);
    buffer_clamp_cursor(b);

    cur := &b.lines[b.cursor_line];
    // Preserve leading whitespace indentation when auto_indent is enabled
    indent := 0;
    if auto_indent {
        while indent < cur.count && indent < b.cursor_col && (cur.data[indent] == ' ' || cur.data[indent] == '\t') {
            indent += 1;
        }
    }

    new_ln := make([..] u8, indent + (cur.count - b.cursor_col) + 8);
    for i in 0 .. indent do new_ln << cur.data[i];
    for i in b.cursor_col .. cur.count do new_ln << cur.data[i];

    cur.count = b.cursor_col;
    Array.insert(&b.lines, b.cursor_line + 1, new_ln);
    b.cursor_line += 1;
    b.cursor_col = indent;
    b.dirty = true;
    b.version += 1;
}

buffer_backspace :: (b: &TextBuffer) {
    buffer_clamp_cursor(b);
    if b.cursor_col > 0 {
        ln := &b.lines[b.cursor_line];
        Array.remove_at(ln, b.cursor_col - 1);
        b.cursor_col -= 1;
        b.dirty = true;
        b.version += 1;
    } elseif b.cursor_line > 0 {
        buffer_push_undo(b);
        prev := &b.lines[b.cursor_line - 1];
        cur  := &b.lines[b.cursor_line];
        join_col := prev.count;
        for i in 0 .. cur.count do *prev << cur.data[i];
        delete(cur);
        Array.remove_at(&b.lines, b.cursor_line);
        b.cursor_line -= 1;
        b.cursor_col = join_col;
        b.dirty = true;
        b.version += 1;
    }
}

buffer_delete_char :: (b: &TextBuffer) {
    buffer_clamp_cursor(b);
    ln := &b.lines[b.cursor_line];
    if b.cursor_col < ln.count {
        Array.remove_at(ln, b.cursor_col);
        b.dirty = true;
        b.version += 1;
    } elseif b.cursor_line + 1 < b.lines.count {
        buffer_push_undo(b);
        next := &b.lines[b.cursor_line + 1];
        for i in 0 .. next.count do *ln << next.data[i];
        delete(next);
        Array.remove_at(&b.lines, b.cursor_line + 1);
        b.dirty = true;
        b.version += 1;
    }
}

buffer_delete_line :: (b: &TextBuffer) {
    buffer_push_undo(b);
    buffer_clamp_cursor(b);
    if b.lines.count <= 1 {
        b.lines[0].count = 0;
        b.cursor_col = 0;
    } else {
        delete(&b.lines[b.cursor_line]);
        Array.remove_at(&b.lines, b.cursor_line);
        buffer_clamp_cursor(b);
    }
    b.dirty = true;
    b.version += 1;
}

buffer_clear_selection :: (b: &TextBuffer) {
    b.has_sel = false;
}

buffer_start_selection :: (b: &TextBuffer) {
    if !b.has_sel {
        b.has_sel         = true;
        b.sel_anchor_line = b.cursor_line;
        b.sel_anchor_col  = b.cursor_col;
    }
}

buffer_select_all :: (b: &TextBuffer) {
    buffer_clamp_cursor(b);
    b.has_sel         = true;
    b.sel_anchor_line = 0;
    b.sel_anchor_col  = 0;
    b.cursor_line     = b.lines.count - 1;
    b.cursor_col      = b.lines[b.cursor_line].count;
}

buffer_get_selection_bounds :: (b: &TextBuffer) -> (sl: i32, sc: i32, el: i32, ec: i32, active: bool) {
    if !b.has_sel do return 0, 0, 0, 0, false;
    al := b.sel_anchor_line;
    ac := b.sel_anchor_col;
    cl := b.cursor_line;
    cc := b.cursor_col;
    if al < 0 do al = 0;
    if al >= b.lines.count do al = b.lines.count - 1;
    if ac < 0 do ac = 0;
    if ac > b.lines[al].count do ac = b.lines[al].count;
    if al == cl && ac == cc do return 0, 0, 0, 0, false;
    if al < cl || (al == cl && ac < cc) {
        return al, ac, cl, cc, true;
    }
    return cl, cc, al, ac, true;
}

buffer_get_selected_text :: (b: &TextBuffer, allocator := context.temp_allocator) -> str {
    buffer_clamp_cursor(b);
    sl, sc, el, ec, active := buffer_get_selection_bounds(b);
    if !active {
        // VS Code-style fallback: copy current line + newline when no selection is active
        ln := &b.lines[b.cursor_line];
        out := make([..] u8, ln.count + 2, allocator);
        for i in 0 .. ln.count do out << ln.data[i];
        out << '\n';
        return str.{ out.data, out.count };
    }
    out := make([..] u8, 64, allocator);
    if sl == el {
        ln := &b.lines[sl];
        for i in sc .. ec do out << ln.data[i];
    } else {
        first := &b.lines[sl];
        for i in sc .. first.count do out << first.data[i];
        out << '\n';
        for li in (sl + 1) .. el {
            mid := &b.lines[li];
            for i in 0 .. mid.count do out << mid.data[i];
            out << '\n';
        }
        last := &b.lines[el];
        for i in 0 .. ec do out << last.data[i];
    }
    return str.{ out.data, out.count };
}

buffer_delete_selection :: (b: &TextBuffer) -> bool {
    buffer_clamp_cursor(b);
    sl, sc, el, ec, active := buffer_get_selection_bounds(b);
    if !active do return false;

    buffer_push_undo(b);
    if sl == el {
        ln := &b.lines[sl];
        del_n := ec - sc;
        for _ in 0 .. del_n {
            Array.remove_at(ln, sc);
        }
    } else {
        first := &b.lines[sl];
        last  := &b.lines[el];
        first.count = sc;
        for i in ec .. last.count do *first << last.data[i];
        // Remove lines (sl + 1) ..= el
        for _ in 0 .. (el - sl) {
            delete(&b.lines[sl + 1]);
            Array.remove_at(&b.lines, sl + 1);
        }
    }
    b.cursor_line = sl;
    b.cursor_col  = sc;
    b.has_sel     = false;
    b.dirty       = true;
    b.version    += 1;
    return true;
}

buffer_insert_text :: (b: &TextBuffer, text: str) {
    if text.count == 0 do return;
    buffer_clamp_cursor(b);
    if !buffer_delete_selection(b) {
        buffer_push_undo(b);
    }

    // Split text by `\n` (stripping `\r`) and insert cleanly at cursor
    for i in 0 .. text.count {
        c := text[i];
        if c == '\r' do continue;
        if c == '\n' {
            cur := &b.lines[b.cursor_line];
            new_ln := make([..] u8, (cur.count - b.cursor_col) + 8);
            for k in b.cursor_col .. cur.count do new_ln << cur.data[k];
            cur.count = b.cursor_col;
            Array.insert(&b.lines, b.cursor_line + 1, new_ln);
            b.cursor_line += 1;
            b.cursor_col   = 0;
        } elseif c == '\t' {
            ln := &b.lines[b.cursor_line];
            for _ in 0 .. 4 {
                Array.insert(ln, b.cursor_col, ' ');
                b.cursor_col += 1;
            }
        } elseif c >= 32 {
            ln := &b.lines[b.cursor_line];
            Array.insert(ln, b.cursor_col, c);
            b.cursor_col += 1;
        }
    }
    b.dirty    = true;
    b.version += 1;
}

buffer_set_gutter_marker :: (b: &TextBuffer, path: str, line: u32, kind: u32, rgba: u32) {
    for &m in b.gutter_markers {
        if m.line == line && m.kind == kind && str.equal(m.path, path) {
            m.rgba = rgba;
            return;
        }
    }
    b.gutter_markers << .{ str.copy(path), line, kind, rgba };
}

buffer_clear_gutter_markers :: (b: &TextBuffer, kind: u32) {
    i := 0;
    while i < b.gutter_markers.count {
        if kind == 0 || b.gutter_markers[i].kind == kind {
            Array.remove_at(&b.gutter_markers, i);
        } else {
            i += 1;
        }
    }
}
