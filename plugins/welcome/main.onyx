// =============================================================================
// Onyx Editor ("odit") — Reference & Verification WASM Plugin ("Inspector")
// =============================================================================
// Showcases the modernized declarative `odit.sdk`:
//   - `@sdk.Plugin.{ ... }` struct decorator (auto-generates manifest & state)
//   - `@sdk.PluginInit`, `@sdk.PluginShutdown`, `@sdk.PluginEvent`, `@sdk.PluginRender`
//   - Typed `sdk.Event` tagged union (`case .Command as cmd`, etc.)
//   - Trailing `Code`-block macros (`sdk.card`, `sdk.on_click`, `sdk.each_json_object`)
//   - `sdk.VStack` vertical layout helper

#load "../../abi/abi.onyx"
#load "../../sdk/plugin_sdk.onyx"

use core { memory }
use odit.abi
use odit.sdk

@sdk.Plugin.{
    id             = "odit.inspector",
    title          = "WASM Inspector (Demo)",
    version        = "0.3.0",
    default_slot   = 0,
    default_width  = 360.0f,
    default_height = 280.0f,
    event_mask     = 95,
    allow_multiple = false,
}
InspectorPlugin :: struct {
    clicks:      u32;
    events_seen: u32;
    lsp_syms:    u32;
    lsp_diags:   u32;
    note_buf:    [128] u8;
    note_len:    u32;
    last_event:  str;
}

@sdk.PluginInit
init :: (self: &InspectorPlugin, window_id: u32) -> i32 {
    sdk.log_info("WASM plugin 'odit.inspector' initialized!");
    sdk.register_command("inspector.ping",  "Inspector: Ping Host Notification", "");
    sdk.register_command("inspector.reset", "Inspector: Reset Counter", "");

    initial := "Hello from modern WASM SDK!";
    memory.copy(&self.note_buf[0], initial.data, initial.count);
    self.note_len   = cast(u32) initial.count;
    self.last_event = "None";
    return 0;
}

@sdk.PluginShutdown
shutdown :: (self: &InspectorPlugin, window_id: u32) {
    sdk.log_info("WASM plugin 'odit.inspector' shut down.");
}

@sdk.PluginEvent
on_event :: (self: &InspectorPlugin, window_id: u32, event: sdk.Event) {
    self.events_seen += 1;

    switch event {
        case .Command as cmd {
            self.last_event = "CommandInvoked";
            if cmd == "inspector.ping" {
                sdk.notify(.Info, "Pong from sandboxed WASM plugin!");
            } elseif cmd == "inspector.reset" {
                self.clicks = 0;
                sdk.notify(.Info, "Inspector click counter reset.");
            }
        }
        case .ActiveFileChanged {
            self.last_event = "ActiveFileChanged";
            refresh_lsp_counts(self);
        }
        case .SymbolsUpdated {
            self.last_event = "SymbolsUpdated";
            refresh_lsp_counts(self);
        }
        case .DiagnosticsUpdated {
            self.last_event = "DiagnosticsUpdated";
            refresh_lsp_counts(self);
        }
        case .BufferModified do self.last_event = "BufferModified";
        case .CursorMoved    do self.last_event = "CursorMoved";
        case _               do self.last_event = "Event";
    }
}

@sdk.PluginRender
render :: (self: &InspectorPlugin, window_id: u32, ctx: &abi.FrameContext) {
    pad: f32 = 12.0f;
    w := ctx.width - pad * 2.0f;
    if w < 120.0f do w = 120.0f;

    v := sdk.vstack(pad, pad, w, 8.0f);

    // Header badge strip
    by := v->next(24.0f);
    pw  := sdk.pill(pad, by, "WASM",      sdk.theme_color(.Accent),  0x11111BFF);
    pw2 := sdk.pill(pad + pw + 6.0f, by, "ABI v1.0", sdk.theme_color(.Success), 0x11111BFF);
    sdk.pill(pad + pw + pw2 + 12.0f, by, "MODERN SDK", sdk.theme_color(.Info), 0x11111BFF);

    // Live Editor & LSP Context Card (trailing Code-block macro!)
    card_y := v->next(110.0f);
    sdk.card(pad, card_y, w, 110.0f, "Active Editor & Onyx LSP Context") {
        active_path := sdk.editor_active_path();
        if active_path.count == 0 do active_path = "(untitled)";
        sdk.draw_text(pad + 10.0f, card_y + 34.0f, active_path, 13.5f, sdk.theme_color(.TextPrimary), .Mono);

        cur := sdk.editor_cursor();
        buf_len := abi.editor_get_buffer_len();
        line_buf: [96] u8;
        sdk.draw_text(pad + 10.0f, card_y + 56.0f, format_cursor_line(&line_buf, cur.line, cur.column, buf_len),
                      12.5f, sdk.theme_color(.Info), .Mono);

        lsp_buf: [96] u8;
        sdk.draw_text(pad + 10.0f, card_y + 76.0f, format_lsp_line(&lsp_buf, self.lsp_syms, self.lsp_diags),
                      12.0f, sdk.theme_color(.Success) if self.lsp_diags == 0 else sdk.theme_color(.Warning), .Mono);

        ev_buf: [96] u8;
        sdk.draw_text(pad + 10.0f, card_y + 92.0f, format_event_line(&ev_buf, self.events_seen, self.last_event),
                      11.5f, sdk.theme_color(.TextSecondary));
    }

    // Interactive buttons using `sdk.on_click` trailing Code blocks
    btn_y := v->next(28.0f);
    bw := (w - 8.0f) * 0.5f;
    sdk.on_click(1, pad, btn_y, bw, 28.0f, "Click +1", .Primary) {
        self.clicks += 1;
        sdk.notify(.Info, "WASM button clicked!");
    }
    sdk.on_click(2, pad + bw + 8.0f, btn_y, bw, 28.0f, "Ping Host", .Ghost) {
        sdk.notify(.Info, "Pong from sandboxed WASM plugin!");
    }

    cnt_buf: [48] u8;
    v->text(format_clicks(&cnt_buf, self.clicks), 12.5f, sdk.theme_color(.TextSecondary));

    // Plugin text input
    inp_y := v->next(28.0f);
    sdk.input_text(3, pad, inp_y, w, 28.0f, self.note_buf, &self.note_len, "Type a note...");
}

#local
refresh_lsp_counts :: (self: &InspectorPlugin) {
    self.lsp_syms  = 0;
    self.lsp_diags = 0;

    syms_js := sdk.ast_symbols_json("", context.temp_allocator);
    sdk.each_json_object(syms_js, [obj] {
        _ := obj;
        self.lsp_syms += 1;
    });

    diag_js := "";
    needed := abi.ast_get_diagnostics(0, 0, 0, 0);
    if needed > 0 {
        buf := make([] u8, needed, context.temp_allocator);
        got := abi.ast_get_diagnostics(0, 0, cast(u32) buf.data, cast(u32) buf.count);
        if got > 0 do diag_js = buf[0 .. got];
    }
    sdk.each_json_object(diag_js, [obj] {
        _ := obj;
        self.lsp_diags += 1;
    });
}

#local
append_s :: (dst: [&] u8, pos: &i32, cap: i32, s: str) {
    for i in 0 .. s.count {
        if *pos >= cap do break;
        dst[*pos] = s[i];
        *pos += 1;
    }
}

#local
append_u32 :: (dst: [&] u8, pos: &i32, cap: i32, v: u32) {
    if v == 0 { append_s(dst, pos, cap, "0"); return; }
    tmp: [16] u8;
    n := 0;
    x := v;
    while x > 0 && n < 16 {
        tmp[n] = cast(u8) ('0' + (x % 10));
        x /= 10;
        n += 1;
    }
    while n > 0 {
        n -= 1;
        if *pos < cap { dst[*pos] = tmp[n]; *pos += 1; }
    }
}

#local
format_cursor_line :: (buf: &[96] u8, line, col: u32, bytes: i32) -> str {
    p := 0;
    append_s(&(*buf)[0], &p, 96, "Cursor: Ln ");
    append_u32(&(*buf)[0], &p, 96, line);
    append_s(&(*buf)[0], &p, 96, ", Col ");
    append_u32(&(*buf)[0], &p, 96, col);
    append_s(&(*buf)[0], &p, 96, "  |  ");
    append_u32(&(*buf)[0], &p, 96, cast(u32) (bytes if bytes > 0 else 0));
    append_s(&(*buf)[0], &p, 96, " bytes");
    return str.{ &(*buf)[0], p };
}

#local
format_lsp_line :: (buf: &[96] u8, syms, diags: u32) -> str {
    p := 0;
    append_s(&(*buf)[0], &p, 96, "LSP: ");
    append_u32(&(*buf)[0], &p, 96, syms);
    append_s(&(*buf)[0], &p, 96, " symbols, ");
    append_u32(&(*buf)[0], &p, 96, diags);
    append_s(&(*buf)[0], &p, 96, " diagnostics");
    return str.{ &(*buf)[0], p };
}

#local
format_event_line :: (buf: &[96] u8, count: u32, last: str) -> str {
    p := 0;
    append_s(&(*buf)[0], &p, 96, "Events: ");
    append_u32(&(*buf)[0], &p, 96, count);
    append_s(&(*buf)[0], &p, 96, " (last: ");
    append_s(&(*buf)[0], &p, 96, last);
    append_s(&(*buf)[0], &p, 96, ")");
    return str.{ &(*buf)[0], p };
}

#local
format_clicks :: (buf: &[48] u8, clicks: u32) -> str {
    p := 0;
    append_s(&(*buf)[0], &p, 48, "Button clicks: ");
    append_u32(&(*buf)[0], &p, 48, clicks);
    return str.{ &(*buf)[0], p };
}
