package {
    name "odit" 
    author "Jonas Stiller <jonas.stiller@t-online.de>" 
    url "" 
    description "Onyx IDE" 
    version "0.0.1" 
}

config {
    dependency_source_path "./lib" 
    dependency_binary_path "./bin" 
}

dependencies {
    raylib "0.0.8" git="http://github.com/onyx-lang/pkg-raylib" 
    "http://github.com/pigeonowo/onyx_testing_framework" "0.2.0" git="http://github.com/pigeonowo/onyx_testing_framework" 
}

lsp {
    mode "project" 
    source_files "src/main.onyx" 
    include_dirs "" 
    working_dir "." 
}

build {
    default {
        target "target/main.wasm" 
        source "src/main.onyx" 
    }
}

