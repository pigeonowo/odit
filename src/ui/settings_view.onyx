package odit.ui

// =============================================================================
// Onyx Editor ("odit") — Interactive Settings Overlay (`Ctrl+,`)
// =============================================================================
// Lets users adjust typography (font size, UI scale, line height), themes
// (Mocha, Tokyo Night, Gruvbox, Light), and editor behavior live with instant
// preview and automatic persistence to `odit.json`.

use core { package }
use raylib
use odit.theme
use odit.settings

SettingsView :: struct {
    open:           bool;
    scroll_y:       f32;
    editing_ps_idx: i32; // -1 when not editing a string plugin setting
    edit_buf:       [256] u8;
    edit_len:       i32;
}

SettingsAction :: enum {
    None;
    Changed;
    Reset;
    OpenJsonFile;
}

#local
btn_rect :: (x, y, w, h: f32, label: str, fs: f32, active: bool = false, primary: bool = false) -> bool {
    mpos := raylib.GetMousePosition();
    hov := mpos.x >= x && mpos.x <= (x + w) && mpos.y >= y && mpos.y <= (y + h);

    bg := theme.get_color(.BgSurface);
    fg := theme.get_color(.TextPrimary);
    border := theme.get_color(.Border);

    if primary {
        bg = theme.get_color(.BorderFocused);
        fg = 0x11111BFF;
        border = 0;
    } elseif active {
        bg = theme.get_color(.Accent);
        fg = 0x11111BFF;
        border = 0;
    } elseif hov {
        bg = theme.get_color(.BgHover);
        border = theme.get_color(.BorderFocused);
    }

    theme.draw_rect(x, y, w, h, bg, 5.0f, border, 1.0f if border != 0 else 0.0f);
    tw := theme.measure_text(label, fs);
    theme.draw_text(x + (w - tw) * 0.5f, y + (h - fs) * 0.5f, label, fs, fg);
    return hov && raylib.IsMouseButtonPressed(.LEFT);
}

#local
draw_stepper_row :: (x, y, w, row_h, fs: f32, label: str, value_str: str) -> i32 {
    theme.draw_text(x, y + (row_h - fs) * 0.5f, label, fs, theme.get_color(.TextPrimary));

    btn_w := row_h * 1.15f;
    val_w := 84.0f * settings.g_settings.ui_scale;
    rx := x + w;

    delta: i32 = 0;
    if btn_rect(rx - btn_w, y + 2.0f, btn_w, row_h - 4.0f, "+", fs) do delta = 1;

    vx := rx - btn_w - val_w - 6.0f;
    theme.draw_rect(vx, y + 2.0f, val_w, row_h - 4.0f, theme.get_color(.BgBase), 4.0f, theme.get_color(.Border), 1.0f);
    vw := theme.measure_text(value_str, fs);
    theme.draw_text(vx + (val_w - vw) * 0.5f, y + (row_h - fs) * 0.5f, value_str, fs, theme.get_color(.Info));

    if btn_rect(vx - btn_w - 6.0f, y + 2.0f, btn_w, row_h - 4.0f, "-", fs) do delta = -1;
    return delta;
}

#local
draw_toggle_row :: (x, y, w, row_h, fs: f32, label: str, on: bool) -> bool {
    theme.draw_text(x, y + (row_h - fs) * 0.5f, label, fs, theme.get_color(.TextPrimary));
    tw := 78.0f * settings.g_settings.ui_scale;
    return btn_rect(x + w - tw, y + 2.0f, tw, row_h - 4.0f, "ON" if on else "OFF", fs, active = on);
}

settings_view_update_and_draw :: (sv: &SettingsView, screen_w, screen_h: f32) -> SettingsAction {
    if !sv.open do return .None;

    if raylib.IsKeyPressed(.ESCAPE) {
        if sv.editing_ps_idx > 0 {
            sv.editing_ps_idx = 0;
            return .None;
        }
        sv.open = false;
        return .None;
    }

    // Dimmed backdrop
    raylib.DrawRectangle(0, 0, cast(i32) screen_w, cast(i32) screen_h, .{ 0, 0, 0, 130 });

    s := settings.g_settings.ui_scale;
    pw := 560.0f * s;
    if pw > screen_w - 40.0f do pw = screen_w - 40.0f;

    row_h := 32.0f * s;
    pad := 18.0f * s;
    fs := 13.5f * s;
    fs_title := 16.0f * s;
    fs_sec := 12.0f * s;

    // Count registered plugin settings for modal sizing
    ps_vis := 0;
    for &ps in settings.g_plugin_settings {
        if ps.registered do ps_vis += 1;
    }
    extra_ps_h := (24.0f * s + cast(f32) ps_vis * (row_h + 4.0f) + 8.0f) if ps_vis > 0 else 0.0f;
    ph := pad * 2.0f + 36.0f * s + row_h * 11.2f + extra_ps_h + 44.0f * s;
    if ph > screen_h - 40.0f do ph = screen_h - 40.0f;

    px := (screen_w - pw) * 0.5f;
    py := (screen_h - ph) * 0.5f;

    // Click outside closes modal
    mpos := raylib.GetMousePosition();
    if raylib.IsMouseButtonPressed(.LEFT) {
        if mpos.x < px || mpos.x > (px + pw) || mpos.y < py || mpos.y > (py + ph) {
            sv.open = false;
            return .None;
        }
    }

    theme.draw_rect(px, py, pw, ph, theme.get_color(.BgPanel), 10.0f, theme.get_color(.BorderFocused), 1.5f);

    // Header
    ix := px + pad;
    iw := pw - pad * 2.0f;
    cy := py + pad;

    theme.draw_text(ix, cy, "Settings (odit.json)", fs_title, theme.get_color(.TextPrimary));
    if btn_rect(ix + iw - 72.0f * s, cy - 2.0f, 72.0f * s, 26.0f * s, "Close", fs_sec) {
        sv.open = false;
        return .None;
    }
    cy += 34.0f * s;
    raylib.DrawLine(cast(i32) ix, cast(i32) cy, cast(i32) (ix + iw), cast(i32) cy, theme.get_rl(.Border));
    cy += 8.0f * s;

    // Scrollable body region between header and pinned footer
    btn_h := 30.0f * s;
    footer_y := py + ph - pad - btn_h;
    body_top := cy;
    body_h := footer_y - 10.0f * s - body_top;
    if body_h < 60.0f do body_h = 60.0f;

    // Handle mouse-wheel scrolling inside the Settings modal
    if mpos.x >= px && mpos.x <= (px + pw) && mpos.y >= body_top && mpos.y <= (body_top + body_h) {
        wheel := raylib.GetMouseWheelMove();
        if wheel != 0.0f {
            sv.scroll_y -= wheel * row_h * 2.0f;
            if sv.scroll_y < 0.0f do sv.scroll_y = 0.0f;
        }
    }

    raylib.BeginScissorMode(cast(i32) px, cast(i32) body_top, cast(i32) pw, cast(i32) body_h);
    cy = body_top - sv.scroll_y;

    action := SettingsAction.None;
    cfg := &settings.g_settings;

    // --- Typography Section ---
    theme.draw_text(ix, cy, "TYPOGRAPHY & SCALING", fs_sec, theme.get_color(.Accent));
    cy += 20.0f * s;

    if d := draw_stepper_row(ix, cy, iw, row_h, fs, "Editor Font Size (Ctrl + / -)", core.tprintf("{} px", cast(i32) cfg.editor_font_size)); d != 0 {
        cfg.editor_font_size += cast(f32) d * 2.0f;
        action = .Changed;
    }
    cy += row_h + 4.0f;

    scale_pct := cast(i32) (cfg.ui_scale * 100.0f + 0.5f);
    if d := draw_stepper_row(ix, cy, iw, row_h, fs, "UI & Plugin Scale", core.tprintf("{}%", scale_pct)); d != 0 {
        cfg.ui_scale += cast(f32) d * 0.1f;
        action = .Changed;
    }
    cy += row_h + 4.0f;

    lh_tenths := cast(i32) (cfg.line_height_factor * 10.0f + 0.5f);
    if d := draw_stepper_row(ix, cy, iw, row_h, fs, "Line Height Factor", core.tprintf("{}.{}x", lh_tenths / 10, lh_tenths % 10)); d != 0 {
        cfg.line_height_factor += cast(f32) d * 0.1f;
        action = .Changed;
    }
    cy += row_h + 12.0f;

    // --- Theme Section ---
    theme.draw_text(ix, cy, "COLOR THEME", fs_sec, theme.get_color(.Accent));
    cy += 20.0f * s;

    ThemePreset :: struct { id: str; label: str; }
    presets := ThemePreset.[
        .{ "mocha",       "Mocha" },
        .{ "tokyo_night", "Tokyo" },
        .{ "gruvbox",     "Gruvbox" },
        .{ "light",       "Light" },
    ];
    gap := 8.0f;
    pill_w := (iw - gap * 3.0f) * 0.25f;
    for p, idx in presets {
        bx := ix + cast(f32) idx * (pill_w + gap);
        is_cur := str.equal(cfg.theme, p.id);
        if btn_rect(bx, cy, pill_w, row_h - 2.0f, p.label, fs, active = is_cur) {
            cfg.theme = str.copy(p.id);
            theme.theme_apply_preset(cfg.theme);
            action = .Changed;
        }
    }
    cy += row_h + 12.0f;

    // --- Editor Behavior Section ---
    theme.draw_text(ix, cy, "EDITOR BEHAVIOR", fs_sec, theme.get_color(.Accent));
    cy += 20.0f * s;

    if d := draw_stepper_row(ix, cy, iw, row_h, fs, "Tab Size (Spaces)", core.tprintf("{}", cfg.tab_size)); d != 0 {
        cfg.tab_size += d;
        action = .Changed;
    }
    cy += row_h + 4.0f;

    if draw_toggle_row(ix, cy, iw, row_h, fs, "Modal Editing (Normal / Insert)", cfg.modal_editing) {
        cfg.modal_editing = !cfg.modal_editing;
        action = .Changed;
    }
    cy += row_h + 4.0f;

    if draw_toggle_row(ix, cy, iw, row_h, fs, "Show Line Numbers", cfg.show_line_numbers) {
        cfg.show_line_numbers = !cfg.show_line_numbers;
        action = .Changed;
    }
    cy += row_h + 4.0f;

    if draw_toggle_row(ix, cy, iw, row_h, fs, "Highlight Current Line", cfg.highlight_current_line) {
        cfg.highlight_current_line = !cfg.highlight_current_line;
        action = .Changed;
    }
    cy += row_h + 4.0f;

    if draw_toggle_row(ix, cy, iw, row_h, fs, "Auto-Indent on Enter", cfg.auto_indent) {
        cfg.auto_indent = !cfg.auto_indent;
        action = .Changed;
    }
    cy += row_h + 12.0f;

    // --- Plugin Settings Section (registered dynamically by WASM plugins) ---
    if ps_vis > 0 {
        theme.draw_text(ix, cy, "PLUGIN SETTINGS", fs_sec, theme.get_color(.Accent));
        cy += 20.0f * s;

        for pi in 0 .. settings.g_plugin_settings.count {
            ps := &settings.g_plugin_settings[pi];
            if !ps.registered do continue;

            if ps.kind == 1 {
                // Bool toggle
                on := ps.value.count > 0 && (ps.value[0] == 't' || ps.value[0] == 'T' || ps.value[0] == '1');
                if draw_toggle_row(ix, cy, iw, row_h, fs, ps.label, on) {
                    if ps.value.count > 0 do str.free(ps.value);
                    ps.value = str.copy("false" if on else "true");
                    action = .Changed;
                }
            } elseif ps.kind == 2 {
                // Int stepper
                v := parse_i32_s(ps.value);
                if d := draw_stepper_row(ix, cy, iw, row_h, fs, ps.label, core.tprintf("{}", v)); d != 0 {
                    if ps.value.count > 0 do str.free(ps.value);
                    ps.value = str.copy(core.tprintf("{}", v + d));
                    action = .Changed;
                }
            } elseif ps.kind == 3 {
                // Float stepper (tenths)
                t10 := parse_f32_tenths(ps.value);
                disp := core.tprintf("{}.{}", t10 / 10, (t10 % 10) if t10 >= 0 else ((-t10) % 10));
                if d := draw_stepper_row(ix, cy, iw, row_h, fs, ps.label, disp); d != 0 {
                    nt := t10 + d;
                    if nt < 0 do nt = 0;
                    if ps.value.count > 0 do str.free(ps.value);
                    ps.value = str.copy(core.tprintf("{}.{}", nt / 10, nt % 10));
                    action = .Changed;
                }
            } else {
                // String inline editable box
                theme.draw_text(ix, cy + (row_h - fs) * 0.5f, ps.label, fs, theme.get_color(.TextPrimary));
                bw_s := 190.0f * s;
                bx_s := ix + iw - bw_s;
                hov_s := mpos.x >= bx_s && mpos.x <= (bx_s + bw_s) && mpos.y >= cy + 2.0f && mpos.y <= (cy + row_h - 2.0f);
                is_ed := sv.editing_ps_idx == (pi + 1);
                if hov_s && raylib.IsMouseButtonPressed(.LEFT) {
                    sv.editing_ps_idx = pi + 1;
                    n := ps.value.count if ps.value.count < 255 else 255;
                    for k in 0 .. n do sv.edit_buf[k] = ps.value[k];
                    sv.edit_len = n;
                    is_ed = true;
                }
                if is_ed {
                    while true {
                        ch := raylib.GetCharPressed();
                        if ch <= 0 do break;
                        if ch >= 32 && ch < 127 && sv.edit_len < 255 {
                            sv.edit_buf[sv.edit_len] = cast(u8) ch;
                            sv.edit_len += 1;
                        }
                    }
                    if (raylib.IsKeyPressed(.BACKSPACE) || raylib.IsKeyPressedRepeat(.BACKSPACE)) && sv.edit_len > 0 {
                        sv.edit_len -= 1;
                    }
                    if raylib.IsKeyPressed(.ENTER) || raylib.IsKeyPressed(.KP_ENTER) {
                        if ps.value.count > 0 do str.free(ps.value);
                        ps.value = str.copy(str.{ &sv.edit_buf[0], sv.edit_len });
                        sv.editing_ps_idx = 0;
                        action = .Changed;
                    }
                }
                bcol := theme.get_color(.BorderFocused) if is_ed else theme.get_color(.Border);
                theme.draw_rect(bx_s, cy + 2.0f, bw_s, row_h - 4.0f, theme.get_color(.BgBase), 4.0f, bcol, 1.5f if is_ed else 1.0f);
                disp_s := str.{ &sv.edit_buf[0], sv.edit_len } if is_ed else ps.value;
                theme.draw_text(bx_s + 6.0f, cy + (row_h - fs) * 0.5f, disp_s, fs, theme.get_color(.TextPrimary));
            }
            cy += row_h + 4.0f;
        }
        cy += 8.0f;
    }

    // Clamp scroll_y to actual content height & end body scissor
    content_h := (cy + sv.scroll_y) - body_top;
    max_scroll := content_h - body_h;
    if max_scroll < 0.0f do max_scroll = 0.0f;
    if sv.scroll_y > max_scroll do sv.scroll_y = max_scroll;
    raylib.EndScissorMode();

    // Pinned footer buttons
    raylib.DrawLine(cast(i32) ix, cast(i32) (footer_y - 6.0f * s), cast(i32) (ix + iw), cast(i32) (footer_y - 6.0f * s), theme.get_rl(.Border));
    bw := (iw - gap * 2.0f) / 3.0f;
    if btn_rect(ix, footer_y, bw, btn_h, "Edit odit.json", fs) {
        settings.settings_save();
        sv.open = false;
        action = .OpenJsonFile;
    }
    if btn_rect(ix + bw + gap, footer_y, bw, btn_h, "Reset Defaults", fs) {
        action = .Reset;
    }
    if btn_rect(ix + (bw + gap) * 2.0f, footer_y, bw, btn_h, "Done", fs, primary = true) {
        sv.open = false;
    }

    if action == .Changed {
        settings.settings_clamp(cfg);
        settings.settings_save();
    } elseif action == .Reset {
        settings.settings_reset();
        theme.theme_apply_preset(cfg.theme);
    }

    return action;
}


#local
parse_i32_s :: (s: str) -> i32 {
    if s.count == 0 do return 0;
    neg := false;
    i := 0;
    if s[0] == '-' { neg = true; i = 1; }
    v: i32 = 0;
    while i < s.count && s[i] >= '0' && s[i] <= '9' {
        v = v * 10 + cast(i32)(s[i] - '0');
        i += 1;
    }
    return -v if neg else v;
}

#local
parse_f32_tenths :: (s: str) -> i32 {
    if s.count == 0 do return 0;
    i := 0;
    whole: i32 = 0;
    while i < s.count && s[i] >= '0' && s[i] <= '9' {
        whole = whole * 10 + cast(i32)(s[i] - '0');
        i += 1;
    }
    frac: i32 = 0;
    if i < s.count && s[i] == '.' && i + 1 < s.count && s[i + 1] >= '0' && s[i + 1] <= '9' {
        frac = cast(i32)(s[i + 1] - '0');
    }
    return whole * 10 + frac;
}
