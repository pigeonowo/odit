package odit.services

// =============================================================================
// Onyx Editor ("odit") — Real Live Onyx Debugger Service
// =============================================================================
// Runs the user's actual Onyx program inside a non-destructive shadow workspace
// (`.odit/dbg_shadow/`) with scope-aware source instrumentation and a live
// loopback TCP protocol (`127.0.0.1:<ephemeral>`).
//
// Features:
//   - 100% real Onyx execution: loops (`for`, `while`), `break`, `continue`,
//     `if`/`elseif`/`else`, `switch`, recursion, `defer`, `use`, `--param`
//     flags, indirect calls (`aoc.run()`), file I/O, and live stdout/stderr.
//   - Real breakpoints across multiple files (dynamically synced mid-session).
//   - Real Step Over (`F10`), Step Into (`F11`), Step Out (`Shift+F11`),
//     Continue (`F5`), Pause, and Stop (`Shift+F5`).
//   - Live local variable & parameter inspection with change highlighting,
//     real call stack frames, program console output, and optional WAT view.

use core { package, os, Array, tprintf }
use odit.abi

#library "odit_wasm_host"

#local
#foreign "odit_wasm_host" {
    native_proc_spawn       :: (cmd_ptr: rawptr, cmd_len: i32, args_ptr: rawptr, args_len: i32, cwd_ptr: rawptr, cwd_len: i32) -> u32 ---
    native_proc_read        :: (handle: u32, stream_mask: i32, out_ptr: rawptr, out_cap: i32) -> i32 ---
    native_proc_poll        :: (handle: u32, out_exit_code: &i32) -> u32 ---
    native_proc_kill        :: (handle: u32) -> i32 ---

    native_dbg_server_start  :: () -> i32 ---
    native_dbg_server_accept :: () -> i32 ---
    native_dbg_server_read   :: (out_ptr: rawptr, out_cap: i32) -> i32 ---
    native_dbg_server_write  :: (src_ptr: rawptr, src_len: i32) -> i32 ---
    native_dbg_server_close  :: () -> void ---
}

#local dbg_proc_spawn :: native_proc_spawn
#local dbg_proc_read  :: native_proc_read
#local dbg_proc_poll  :: native_proc_poll
#local dbg_proc_kill  :: native_proc_kill
#local dbg_srv_start  :: native_dbg_server_start
#local dbg_srv_accept :: native_dbg_server_accept
#local dbg_srv_read   :: native_dbg_server_read
#local dbg_srv_write  :: native_dbg_server_write
#local dbg_srv_close  :: native_dbg_server_close

Breakpoint :: struct {
    path: str;
    line: u32; // 1-based line number
}

LiveFrame :: struct {
    func: str;
    path: str;
    line: u32;
}

LiveVar :: struct {
    name:    str;
    type:    str;
    value:   str;
    changed: bool;
}

ParsedProc :: struct {
    name:       str;
    wat_hint:   str;
    start_line: u32;
    end_line:   u32;
    sig_line:   str;
    is_tagged:  bool;
}

DebuggerState :: struct {
    status:           abi.DebugStatus;
    entry_path:       str;
    explicit_entry:   bool;
    extra_args:       [..] str;
    prog_args:        [..] str;

    source_path:      str;
    current_line:     u32;
    current_func:     str;
    pause_reason:     str;
    exit_code:        i32;
    current_wat_line: i32;
    wat_text:         str;
    wat_line_count:   i32;
    last_wat_func:    str;
    last_wat_path:    str;
    last_error:       str;

    breakpoints:      [..] Breakpoint;
    line_map:         [..] abi.SourceWatMap;
    locals:           [..] LiveVar;
    frames:           [..] LiveFrame;
    output_lines:     [..] str;
    output_partial:   [..] u8;

    // Live child process + TCP IPC state
    proc_handle:      u32;
    tcp_port:         i32;
    tcp_connected:    bool;
    rx_buf:           [..] u8;
    collecting_pause: bool;
    pend_file:        str;
    pend_func:        str;
    pend_line:        u32;
    pend_reason:      str;
    pend_frames:      [..] LiveFrame;
    pend_vars:        [..] LiveVar;
    buf_version:      u32;

    dirty:            bool;
    markers_dirty:    bool;
}

g_dbg: DebuggerState;

dbg_init :: () {
    g_dbg.status           = .Idle;
    g_dbg.entry_path       = "";
    g_dbg.explicit_entry   = false;
    g_dbg.extra_args       = make([..] str);
    g_dbg.prog_args        = make([..] str);
    g_dbg.source_path      = "";
    g_dbg.current_line     = 0;
    g_dbg.current_func     = "";
    g_dbg.pause_reason     = "";
    g_dbg.exit_code        = 0;
    g_dbg.current_wat_line = -1;
    g_dbg.wat_text         = "";
    g_dbg.wat_line_count   = 0;
    g_dbg.last_wat_func    = "";
    g_dbg.last_wat_path    = "";
    g_dbg.last_error       = "";

    g_dbg.breakpoints      = make([..] Breakpoint);
    g_dbg.line_map         = make([..] abi.SourceWatMap);
    g_dbg.locals           = make([..] LiveVar);
    g_dbg.frames           = make([..] LiveFrame);
    g_dbg.output_lines     = make([..] str);
    g_dbg.output_partial   = make([..] u8);

    g_dbg.proc_handle      = 0;
    g_dbg.tcp_port         = -1;
    g_dbg.tcp_connected    = false;
    g_dbg.rx_buf           = make([..] u8, 2048);
    g_dbg.collecting_pause = false;
    g_dbg.pend_file        = "";
    g_dbg.pend_func        = "";
    g_dbg.pend_line        = 0;
    g_dbg.pend_reason      = "";
    g_dbg.pend_frames      = make([..] LiveFrame);
    g_dbg.pend_vars        = make([..] LiveVar);
    g_dbg.buf_version      = 0;

    g_dbg.dirty            = false;
    g_dbg.markers_dirty    = false;
}

// -----------------------------------------------------------------------------
// Breakpoint Management
// -----------------------------------------------------------------------------

dbg_has_breakpoint :: (path: str, line: u32) -> bool {
    for &bp in g_dbg.breakpoints {
        if bp.line == line && str.equal(bp.path, path) do return true;
    }
    return false;
}

/// Toggles a breakpoint at `(path, line)`. Returns `1` if now set, `0` if removed.
dbg_toggle_breakpoint :: (path: str, line: u32) -> u32 {
    if path.count == 0 || line == 0 do return 0;
    for i in 0 .. g_dbg.breakpoints.count {
        if g_dbg.breakpoints[i].line == line && str.equal(g_dbg.breakpoints[i].path, path) {
            str.free(g_dbg.breakpoints[i].path);
            Array.remove_at(&g_dbg.breakpoints, i);
            g_dbg.dirty         = true;
            g_dbg.markers_dirty = true;
            if g_dbg.tcp_connected do sync_breakpoints_to_child();
            return 0;
        }
    }
    g_dbg.breakpoints << .{ str.copy(path), line };
    g_dbg.dirty         = true;
    g_dbg.markers_dirty = true;
    if g_dbg.tcp_connected do sync_breakpoints_to_child();
    return 1;
}

dbg_clear_breakpoints :: () {
    for &bp in g_dbg.breakpoints {
        if bp.path.count > 0 do str.free(bp.path);
    }
    Array.clear(&g_dbg.breakpoints);
    g_dbg.dirty         = true;
    g_dbg.markers_dirty = true;
    if g_dbg.tcp_connected do sync_breakpoints_to_child();
}

dbg_get_breakpoints_json :: (path: str, allocator := context.temp_allocator) -> str {
    out := make(dyn_str, 256, allocator);
    Array.concat(&out, "[");
    first := true;
    for &bp in g_dbg.breakpoints {
        if path.count > 0 && !str.equal(bp.path, path) do continue;
        if !first do Array.concat(&out, ",");
        first = false;
        Array.concat(&out, tprintf("{{\"path\":\"{}\",\"line\":{}}}", json_esc_wat(bp.path), bp.line));
    }
    Array.concat(&out, "]");
    return out;
}

// -----------------------------------------------------------------------------
// Shared Source Parsing Helpers (Used by Instrumenter, Eval & Unit Tests)
// -----------------------------------------------------------------------------

#package
trim_s :: (s: str) -> str {
    a := 0;
    b := s.count;
    while a < b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r' || s[a] == '\n') do a += 1;
    while b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r' || s[b - 1] == '\n') do b -= 1;
    return s[a .. b];
}

#package
is_ident_ch :: (c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

#package
split_lines :: (src: str, allocator := context.temp_allocator) -> [..] str {
    lines := make([..] str, 64, allocator);
    start := 0;
    for i in 0 .. (src.count + 1) {
        if i == src.count || src[i] == '\n' {
            e := i;
            if e > start && src[e - 1] == '\r' do e -= 1;
            lines << src[start .. e];
            start = i + 1;
        }
    }
    return lines;
}

#local
make_unnamed_wat_hint :: (source_path: str, line_1: u32, allocator := context.temp_allocator) -> str {
    out := make(dyn_str, source_path.count + 16, allocator);
    for i in 0 .. source_path.count {
        c := source_path[i];
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
            out << c;
        } else {
            out << '_';
        }
    }
    Array.concat(&out, tprintf("_{}", line_1));
    return out;
}

#local
find_brace_block_end :: (lines: [] str, start_i: i32) -> (end_i: i32, found: bool) {
    depth := 0;
    found_brace := false;
    res_end := start_i;
    j := start_i;
    while j < lines.count {
        l := lines[j];
        in_s := false;
        for k in 0 .. l.count {
            c := l[k];
            if c == '"' && (k == 0 || l[k - 1] != '\\') { in_s = !in_s; continue; }
            if in_s do continue;
            if c == '/' && k + 1 < l.count && l[k + 1] == '/' do break;
            if c == '{' { depth += 1; found_brace = true; }
            elseif c == '}' { depth -= 1; }
        }
        res_end = j;
        if found_brace && depth <= 0 do break;
        if !found_brace && j > start_i + 4 do break;
        j += 1;
    }
    return res_end, found_brace;
}

parse_procs_in_source :: (lines: [] str, source_path: str = "", allocator := context.temp_allocator) -> [..] ParsedProc {
    procs := make([..] ParsedProc, 16, allocator);
    pending_tag := "";
    pending_tag_line: i32 = -10;

    i := 0;
    while i < lines.count {
        ln := trim_s(lines[i]);
        if ln.count == 0 || str.starts_with(ln, "//") {
            i += 1;
            continue;
        }
        if ln[0] == '@' {
            pending_tag = ln;
            pending_tag_line = i;
            i += 1;
            continue;
        }

        has_tag := (i - pending_tag_line) <= 2 && pending_tag.count > 0;

        // 1. Named procedure: `<name> :: (`
        col_pos := -1;
        if ln.count >= 2 do for k in 0 .. (ln.count - 1) {
            if ln[k] == ':' && ln[k + 1] == ':' {
                col_pos = k;
                break;
            }
        }
        if col_pos > 0 {
            name := trim_s(ln[0 .. col_pos]);
            rest := trim_s(ln[(col_pos + 2) .. ln.count]);
            short_name := name;
            for k in 0 .. name.count {
                if name[k] == '.' do short_name = name[(k + 1) .. name.count];
            }
            if short_name.count > 0 && rest.count > 0 && rest[0] == '(' {
                end_i, found_brace := find_brace_block_end(lines, i);
                if found_brace {
                    procs << .{
                        name       = short_name,
                        wat_hint   = short_name,
                        start_line = cast(u32) (i + 1),
                        end_line   = cast(u32) (end_i + 1),
                        sig_line   = ln,
                        is_tagged  = has_tag,
                    };
                    pending_tag = "";
                    i = end_i + 1;
                    continue;
                }
            }
        }

        // 2. Anonymous tagged procedure: `@aoc.part1` followed by `(input_file: str) -> i64 {`
        if has_tag && ln[0] == '(' {
            end_i, found_brace := find_brace_block_end(lines, i);
            if found_brace {
                line_1 := cast(u32) (i + 1);
                hint   := make_unnamed_wat_hint(source_path, line_1, allocator) if source_path.count > 0 else tprintf("_{}", line_1);
                procs << .{
                    name       = pending_tag,
                    wat_hint   = hint,
                    start_line = line_1,
                    end_line   = cast(u32) (end_i + 1),
                    sig_line   = ln,
                    is_tagged  = true,
                };
                pending_tag = "";
                i = end_i + 1;
                continue;
            }
        }

        if !str.starts_with(ln, "#") do pending_tag = "";
        i += 1;
    }
    return procs;
}

/// Parses an optional full run command (e.g. `onyx run --param "aoc.day=1" --param "aoc.part=0" src/day1.onyx`)
/// OR a bare `.onyx` file path into `(entry_file, extra_compiler_args, explicit_entry)`.
dbg_parse_run_command :: (cmd_line: str, allocator := context.temp_allocator) -> (entry: str, args: [..] str, explicit: bool) {
    tokens := make([..] str, 16, allocator);
    i := 0;
    n := cmd_line.count;
    while i < n {
        while i < n && (cmd_line[i] == ' ' || cmd_line[i] == '\t' || cmd_line[i] == '\r' || cmd_line[i] == '\n') do i += 1;
        if i >= n do break;
        buf := make([..] u8, 32, allocator);
        quote: u8 = 0;
        while i < n {
            c := cmd_line[i];
            if quote != 0 {
                if c == quote { quote = 0; i += 1; continue; }
                buf << c;
                i += 1;
            } else {
                if c == ' ' || c == '\t' || c == '\r' || c == '\n' do break;
                if c == '\'' || c == '"' { quote = c; i += 1; continue; }
                buf << c;
                i += 1;
            }
        }
        if buf.count > 0 do tokens << str.{ buf.data, buf.count };
    }

    out_entry := "";
    out_args := make([..] str, 8, allocator);
    explicit = false;

    ti := 0;
    if ti < tokens.count && (str.equal(tokens[ti], "onyx") || str.ends_with(tokens[ti], "/onyx")) {
        explicit = true;
        ti += 1;
    }
    if ti < tokens.count && (str.equal(tokens[ti], "run") || str.equal(tokens[ti], "build") || str.equal(tokens[ti], "build-exe") || str.equal(tokens[ti], "check")) {
        explicit = true;
        ti += 1;
    }

    while ti < tokens.count {
        tok := tokens[ti];
        if str.equal(tok, "--") do break;
        if str.equal(tok, "-o") || str.equal(tok, "--output") {
            ti += 2;
            continue;
        }
        if str.equal(tok, "--param") || str.equal(tok, "-r") || str.equal(tok, "--runtime") || str.equal(tok, "-I") {
            out_args << tok;
            if ti + 1 < tokens.count {
                out_args << tokens[ti + 1];
                ti += 2;
                continue;
            }
            ti += 1;
            continue;
        }
        if str.starts_with(tok, "-") {
            out_args << tok;
            ti += 1;
            continue;
        }
        if str.ends_with(tok, ".onyx") || out_entry.count == 0 {
            out_entry = tok;
        } else {
            out_args << tok;
        }
        ti += 1;
    }

    if out_args.count > 0 do explicit = true;
    return out_entry, out_args, explicit;
}

#local
parse_prog_args_after_dd :: (cmd_line: str, allocator := context.temp_allocator) -> [..] str {
    out := make([..] str, 4, allocator);
    found_dd := false;
    i := 0;
    n := cmd_line.count;
    while i < n {
        while i < n && (cmd_line[i] == ' ' || cmd_line[i] == '\t') do i += 1;
        if i >= n do break;
        buf := make([..] u8, 32, allocator);
        quote: u8 = 0;
        while i < n {
            c := cmd_line[i];
            if quote != 0 {
                if c == quote { quote = 0; i += 1; continue; }
                buf << c; i += 1;
            } else {
                if c == ' ' || c == '\t' do break;
                if c == '\'' || c == '"' { quote = c; i += 1; continue; }
                buf << c; i += 1;
            }
        }
        tok := str.{ buf.data, buf.count };
        if found_dd {
            if tok.count > 0 do out << tok;
        } elseif str.equal(tok, "--") {
            found_dd = true;
        }
    }
    return out;
}

// -----------------------------------------------------------------------------
// Shadow Workspace Builder & Live Process Lifecycle
// -----------------------------------------------------------------------------

#local
ensure_parent_dirs :: (path: str) {
    for i in 1 .. path.count {
        if path[i] == '/' {
            dir := path[0 .. i];
            if !os.Directory.exists(dir) do os.Directory.create(dir);
        }
    }
}

#local
relative_to_shadow_root :: (rel_path: str, allocator := context.temp_allocator) -> str {
    // Count `/` depth inside rel_path so e.g. `src/day1.onyx` -> `../__odit_dbg_rt.onyx`
    out := make(dyn_str, 32, allocator);
    for i in 0 .. rel_path.count {
        if rel_path[i] == '/' do Array.concat(&out, "../");
    }
    Array.concat(&out, "__odit_dbg_rt.onyx");
    return out;
}

#local
prepare_shadow_workspace :: (entry_path: str, port: i32) -> (shadow_entry: str, ok: bool) {
    is_abs := entry_path.count > 0 && entry_path[0] == '/';
    shadow_root := "/tmp/odit_dbg_shadow" if is_abs else ".odit/dbg_shadow";

    if !is_abs {
        if !os.Directory.exists(".odit") do os.Directory.create(".odit");
    }
    if !os.Directory.exists(shadow_root) do os.Directory.create(shadow_root);

    // 1. Write the live debugger TCP runtime
    rt_path := tprintf("{}/__odit_dbg_rt.onyx", shadow_root);
    rt_src  := generate_dbg_runtime_source(port, context.temp_allocator);
    if !os.File.write_contents(rt_path, rt_src) {
        return "", false;
    }

    // 2. Absolute standalone file (e.g. unit test in /tmp/foo.onyx)
    if is_abs {
        use raw := os.get_contents(entry_path);
        if raw.count == 0 do return "", false;
        instr := instrument_onyx_source(raw, entry_path, "./__odit_dbg_rt.onyx", true, context.temp_allocator);
        dst := tprintf("{}/__entry.onyx", shadow_root);
        if !os.File.write_contents(dst, instr) do return "", false;
        return str.copy(dst, context.temp_allocator), true;
    }

    // 3. Project workspace: symlink `lib` and `bin` so `#load "./../lib/packages"` works untouched!
    if os.Directory.exists("lib") {
        lib_link := tprintf("{}/lib", shadow_root);
        if !os.Directory.exists(lib_link) {
            os.File.symlink("../../lib", lib_link);
        }
    }
    if os.Directory.exists("bin") {
        bin_link := tprintf("{}/bin", shadow_root);
        if !os.Directory.exists(bin_link) {
            os.File.symlink("../../bin", bin_link);
        }
    }

    // 4. Instrument all workspace `.onyx` files (skipping lib/, build/, .odit/)
    ws_files := workspace_find_files(".", ".onyx", context.temp_allocator);
    entry_done := false;

    for rel in ws_files {
        if str.starts_with(rel, "lib/") || str.starts_with(rel, "build/") || str.starts_with(rel, ".odit/") {
            continue;
        }
        // Skip plugins/ and tests/ unless entry_path itself is inside them
        if str.starts_with(rel, "plugins/") && !str.starts_with(entry_path, "plugins/") do continue;
        if str.starts_with(rel, "tests/")   && !str.starts_with(entry_path, "tests/")   do continue;

        use raw := os.get_contents(rel);
        if raw.count == 0 do continue;
        is_ent := str.equal(rel, entry_path);
        if is_ent do entry_done = true;

        rt_rel := relative_to_shadow_root(rel, context.temp_allocator);
        instr := instrument_onyx_source(raw, rel, rt_rel, is_ent, context.temp_allocator);
        dst := tprintf("{}/{}", shadow_root, rel);
        ensure_parent_dirs(dst);
        os.File.write_contents(dst, instr);
    }

    // Ensure entry_path itself is instrumented even if outside normal scan
    if !entry_done {
        use raw := os.get_contents(entry_path);
        if raw.count == 0 do return "", false;
        rt_rel := relative_to_shadow_root(entry_path, context.temp_allocator);
        instr := instrument_onyx_source(raw, entry_path, rt_rel, true, context.temp_allocator);
        dst := tprintf("{}/{}", shadow_root, entry_path);
        ensure_parent_dirs(dst);
        if !os.File.write_contents(dst, instr) do return "", false;
    }

    return tprintf("{}/{}", shadow_root, entry_path), true;
}

#local
send_tcp_line :: (s: str) {
    if !g_dbg.tcp_connected || s.count == 0 do return;
    dbg_srv_write(s.data, s.count);
}

#local
sync_breakpoints_to_child :: () {
    if !g_dbg.tcp_connected do return;
    buf := make(dyn_str, 256, context.temp_allocator);
    Array.concat(&buf, "CLRBP\n");
    for &bp in g_dbg.breakpoints {
        Array.concat(&buf, tprintf("BP\t{}\t{}\n", bp.path, bp.line));
    }
    send_tcp_line(buf);
}

#local
clear_live_arrays :: () {
    for &v in g_dbg.locals {
        if v.name.count > 0  do str.free(v.name);
        if v.type.count > 0  do str.free(v.type);
        if v.value.count > 0 do str.free(v.value);
    }
    Array.clear(&g_dbg.locals);

    for &f in g_dbg.frames {
        if f.func.count > 0 do str.free(f.func);
        if f.path.count > 0 do str.free(f.path);
    }
    Array.clear(&g_dbg.frames);
}

#local
clear_pending_pause :: () {
    if g_dbg.pend_file.count > 0   { str.free(g_dbg.pend_file);   g_dbg.pend_file = ""; }
    if g_dbg.pend_func.count > 0   { str.free(g_dbg.pend_func);   g_dbg.pend_func = ""; }
    if g_dbg.pend_reason.count > 0 { str.free(g_dbg.pend_reason); g_dbg.pend_reason = ""; }
    g_dbg.pend_line = 0;
    for &f in g_dbg.pend_frames {
        if f.func.count > 0 do str.free(f.func);
        if f.path.count > 0 do str.free(f.path);
    }
    Array.clear(&g_dbg.pend_frames);
    for &v in g_dbg.pend_vars {
        if v.name.count > 0  do str.free(v.name);
        if v.type.count > 0  do str.free(v.type);
        if v.value.count > 0 do str.free(v.value);
    }
    Array.clear(&g_dbg.pend_vars);
    g_dbg.collecting_pause = false;
}

#local
clear_output :: () {
    for l in g_dbg.output_lines {
        if l.count > 0 do str.free(l);
    }
    Array.clear(&g_dbg.output_lines);
    Array.clear(&g_dbg.output_partial);
}

#local
append_output_chunk :: (data: [] u8) {
    if data.count == 0 do return;
    for i in 0 .. data.count {
        c := data[i];
        if c == '\r' do continue;
        if c == '\n' {
            if g_dbg.output_lines.count >= 300 {
                if g_dbg.output_lines[0].count > 0 do str.free(g_dbg.output_lines[0]);
                Array.remove_at(&g_dbg.output_lines, 0);
            }
            ln := str.{ g_dbg.output_partial.data, g_dbg.output_partial.count };
            g_dbg.output_lines << str.copy(ln);
            Array.clear(&g_dbg.output_partial);
            g_dbg.dirty = true;
        } else {
            g_dbg.output_partial << c;
        }
    }
}

#local
flush_output_partial :: () {
    if g_dbg.output_partial.count > 0 {
        if g_dbg.output_lines.count >= 300 {
            if g_dbg.output_lines[0].count > 0 do str.free(g_dbg.output_lines[0]);
            Array.remove_at(&g_dbg.output_lines, 0);
        }
        ln := str.{ g_dbg.output_partial.data, g_dbg.output_partial.count };
        g_dbg.output_lines << str.copy(ln);
        Array.clear(&g_dbg.output_partial);
    }
}

#local
stop_live_session :: () {
    if g_dbg.tcp_connected {
        send_tcp_line("STOP\n");
    }
    dbg_srv_close();
    g_dbg.tcp_connected = false;
    g_dbg.tcp_port      = -1;

    if g_dbg.proc_handle != 0 {
        dbg_proc_kill(g_dbg.proc_handle);
        g_dbg.proc_handle = 0;
    }
    Array.clear(&g_dbg.rx_buf);
    clear_pending_pause();
}

#local
parse_u32_s :: (s: str) -> u32 {
    v: u32 = 0;
    for i in 0 .. s.count {
        c := s[i];
        if c >= '0' && c <= '9' do v = v * 10 + cast(u32) (c - '0');
    }
    return v;
}

#local
split_tabs :: (line: str, allocator := context.temp_allocator) -> [..] str {
    parts := make([..] str, 8, allocator);
    start := 0;
    for i in 0 .. (line.count + 1) {
        if i == line.count || line[i] == '\t' {
            parts << line[start .. i];
            start = i + 1;
        }
    }
    return parts;
}

#local
refresh_wat_cache_if_needed :: () {
    if g_dbg.source_path.count == 0 || g_dbg.current_func.count == 0 do return;
    if str.equal(g_dbg.source_path, g_dbg.last_wat_path) && str.equal(g_dbg.current_func, g_dbg.last_wat_func) {
        return;
    }
    // Look up matching proc for WAT hint
    use src := os.get_contents(g_dbg.source_path);
    if src.count == 0 do return;
    lines := split_lines(src, context.temp_allocator);
    procs := parse_procs_in_source(lines, g_dbg.source_path, context.temp_allocator);
    wat_hint := g_dbg.current_func;
    for &p in procs {
        if str.equal(p.name, g_dbg.current_func) {
            wat_hint = p.wat_hint;
            break;
        }
    }

    wat_entry := g_dbg.entry_path if g_dbg.entry_path.count > 0 else g_dbg.source_path;
    wat_txt, _fidx, ok, _err := wat_get_function_raw(wat_entry, wat_hint, g_dbg.buf_version, g_dbg.extra_args, g_dbg.explicit_entry);
    if ok {
        if g_dbg.wat_text.count > 0 do str.free(g_dbg.wat_text);
        g_dbg.wat_text = str.copy(wat_txt);
        wlines := split_lines(g_dbg.wat_text, context.temp_allocator);
        g_dbg.wat_line_count   = wlines.count;
        g_dbg.current_wat_line = 0;
        if g_dbg.last_wat_path.count > 0 do str.free(g_dbg.last_wat_path);
        if g_dbg.last_wat_func.count > 0 do str.free(g_dbg.last_wat_func);
        g_dbg.last_wat_path = str.copy(g_dbg.source_path);
        g_dbg.last_wat_func = str.copy(g_dbg.current_func);
    }
}

#local
commit_pause_snapshot :: () {
    if g_dbg.source_path.count > 0  do str.free(g_dbg.source_path);
    if g_dbg.current_func.count > 0 do str.free(g_dbg.current_func);
    if g_dbg.pause_reason.count > 0 do str.free(g_dbg.pause_reason);

    g_dbg.source_path  = str.copy(g_dbg.pend_file);
    g_dbg.current_func = str.copy(g_dbg.pend_func);
    g_dbg.current_line = g_dbg.pend_line;
    g_dbg.pause_reason = str.copy(g_dbg.pend_reason);

    // Mark which locals changed compared to previous pause!
    for &nv in g_dbg.pend_vars {
        nv.changed = true;
        for &ov in g_dbg.locals {
            if str.equal(ov.name, nv.name) {
                nv.changed = !str.equal(ov.value, nv.value);
                break;
            }
        }
    }

    clear_live_arrays();
    for &f in g_dbg.pend_frames {
        g_dbg.frames << .{ str.copy(f.func), str.copy(f.path), f.line };
    }
    for &v in g_dbg.pend_vars {
        g_dbg.locals << .{ str.copy(v.name), str.copy(v.type), str.copy(v.value), v.changed };
    }
    clear_pending_pause();

    g_dbg.status        = .Paused;
    g_dbg.dirty         = true;
    g_dbg.markers_dirty = true;
}

#local
handle_ipc_line :: (line: str) {
    if line.count == 0 do return;
    if str.equal(line, "HELLO") {
        sync_breakpoints_to_child();
        if g_dbg.breakpoints.count > 0 {
            send_tcp_line("CONT\n");
        } else {
            send_tcp_line("INTO\n");
        }
        return;
    }

    parts := split_tabs(line, context.temp_allocator);
    if parts.count == 0 do return;
    tag := parts[0];

    if str.equal(tag, "PAUSE") && parts.count >= 6 {
        clear_pending_pause();
        g_dbg.collecting_pause = true;
        g_dbg.pend_file   = str.copy(parts[1]);
        g_dbg.pend_func   = str.copy(parts[2]);
        g_dbg.pend_line   = parse_u32_s(parts[3]);
        g_dbg.pend_reason = str.copy(parts[5]);
    } elseif str.equal(tag, "FRAME") && parts.count >= 4 && g_dbg.collecting_pause {
        g_dbg.pend_frames << .{ str.copy(parts[1]), str.copy(parts[2]), parse_u32_s(parts[3]) };
    } elseif str.equal(tag, "VAR") && parts.count >= 4 && g_dbg.collecting_pause {
        g_dbg.pend_vars << .{ str.copy(parts[1]), str.copy(parts[2]), str.copy(parts[3]), false };
    } elseif str.equal(tag, "END") && g_dbg.collecting_pause {
        commit_pause_snapshot();
    }
}

/// Polls the live debugged child process (stdout/stderr + TCP IPC). Call once per frame!
dbg_poll :: () {
    if g_dbg.proc_handle == 0 do return;

    // 1. Drain child stdout & stderr into console log
    out_tmp: [4096] u8;
    for _ in 0 .. 8 {
        n1 := dbg_proc_read(g_dbg.proc_handle, 1, &out_tmp[0], out_tmp.count);
        if n1 > 0 do append_output_chunk(out_tmp[0 .. n1]);
        n2 := dbg_proc_read(g_dbg.proc_handle, 2, &out_tmp[0], out_tmp.count);
        if n2 > 0 do append_output_chunk(out_tmp[0 .. n2]);
        if n1 <= 0 && n2 <= 0 do break;
    }

    // 2. Accept TCP connection from instrumented child runtime
    if !g_dbg.tcp_connected && g_dbg.tcp_port > 0 {
        acc := dbg_srv_accept();
        if acc == 1 {
            g_dbg.tcp_connected = true;
        }
    }

    // 3. Read & dispatch incoming IPC lines non-blockingly
    if g_dbg.tcp_connected {
        ipc_tmp: [4096] u8;
        for _ in 0 .. 16 {
            r := dbg_srv_read(&ipc_tmp[0], ipc_tmp.count);
            if r > 0 {
                for i in 0 .. r do g_dbg.rx_buf << ipc_tmp[i];
            } else {
                if r < 0 do g_dbg.tcp_connected = false;
                break;
            }
        }
        // Process all complete newline-delimited messages
        while true {
            nl := -1;
            for i in 0 .. g_dbg.rx_buf.count {
                if g_dbg.rx_buf[i] == '\n' { nl = i; break; }
            }
            if nl < 0 do break;
            end := nl;
            if end > 0 && g_dbg.rx_buf[end - 1] == '\r' do end -= 1;
            ln := make([] u8, end, context.temp_allocator);
            for k in 0 .. end do ln[k] = g_dbg.rx_buf[k];
            rem := g_dbg.rx_buf.count - (nl + 1);
            for k in 0 .. rem do g_dbg.rx_buf[k] = g_dbg.rx_buf[nl + 1 + k];
            g_dbg.rx_buf.count = rem;
            handle_ipc_line(str.{ ln.data, ln.count });
        }
    }

    // 4. Poll child process exit
    ec: i32 = 0;
    st := dbg_proc_poll(g_dbg.proc_handle, &ec);
    if st != 1 { // Not Running (Exited / Killed)
        // Final drain of stdout/stderr
        for _ in 0 .. 8 {
            n1 := dbg_proc_read(g_dbg.proc_handle, 1, &out_tmp[0], out_tmp.count);
            if n1 > 0 do append_output_chunk(out_tmp[0 .. n1]);
            n2 := dbg_proc_read(g_dbg.proc_handle, 2, &out_tmp[0], out_tmp.count);
            if n2 > 0 do append_output_chunk(out_tmp[0 .. n2]);
            if n1 <= 0 && n2 <= 0 do break;
        }
        flush_output_partial();
        dbg_proc_kill(g_dbg.proc_handle);
        g_dbg.proc_handle   = 0;
        dbg_srv_close();
        g_dbg.tcp_connected = false;
        g_dbg.tcp_port      = -1;
        g_dbg.exit_code     = ec;

        if ec != 0 {
            if g_dbg.last_error.count > 0 do str.free(g_dbg.last_error);
            // Extract first non-empty error line if available
            err_msg := tprintf("Program exited with code {}", ec);
            for l in g_dbg.output_lines {
                tl := trim_s(l);
                if str.contains(tl, "error:") || str.contains(tl, "Error") {
                    err_msg = tl;
                    break;
                }
            }
            g_dbg.last_error = str.copy(err_msg);
        }

        g_dbg.status           = .Exited;
        g_dbg.current_line     = 0;
        g_dbg.current_wat_line = -1;
        g_dbg.dirty            = true;
        g_dbg.markers_dirty    = true;
    }
}

/// Starts a real live Onyx debug session on `run_cmd_or_entry`.
dbg_start :: (run_cmd_or_entry: str, active_file: str, cursor_line: u32, buf_version: u32) -> i32 {
    stop_live_session();
    clear_live_arrays();
    clear_output();
    Array.clear(&g_dbg.line_map);
    if g_dbg.wat_text.count > 0      { str.free(g_dbg.wat_text);      g_dbg.wat_text = ""; }
    if g_dbg.last_wat_path.count > 0 { str.free(g_dbg.last_wat_path); g_dbg.last_wat_path = ""; }
    if g_dbg.last_wat_func.count > 0 { str.free(g_dbg.last_wat_func); g_dbg.last_wat_func = ""; }
    if g_dbg.last_error.count > 0    { str.free(g_dbg.last_error);    g_dbg.last_error = ""; }
    g_dbg.current_line     = 0;
    g_dbg.current_wat_line = -1;
    g_dbg.exit_code        = 0;
    g_dbg.buf_version      = buf_version;

    parsed_entry, parsed_args, is_explicit := dbg_parse_run_command(run_cmd_or_entry, context.temp_allocator);
    parsed_prog := parse_prog_args_after_dd(run_cmd_or_entry, context.temp_allocator);

    eff_entry := parsed_entry if parsed_entry.count > 0 else active_file;
    if eff_entry.count == 0 do eff_entry = "src/main.onyx";

    // If user didn't pass an explicit entry and active file lacks `main ::`, fall back to `src/main.onyx`
    if !is_explicit {
        use check_src := os.get_contents(eff_entry);
        if !str.contains(check_src, "main ::") {
            if os.file_exists("src/main.onyx") do eff_entry = "src/main.onyx";
            elseif os.file_exists("main.onyx") do eff_entry = "main.onyx";
        }
    }

    if g_dbg.entry_path.count > 0 do str.free(g_dbg.entry_path);
    g_dbg.entry_path     = str.copy(eff_entry);
    g_dbg.explicit_entry = is_explicit && parsed_entry.count > 0;

    for a in g_dbg.extra_args do if a.count > 0 do str.free(a);
    Array.clear(&g_dbg.extra_args);
    for a in parsed_args do g_dbg.extra_args << str.copy(a);

    for a in g_dbg.prog_args do if a.count > 0 do str.free(a);
    Array.clear(&g_dbg.prog_args);
    for a in parsed_prog do g_dbg.prog_args << str.copy(a);

    // 1. Start loopback TCP debug server
    port := dbg_srv_start();
    if port <= 0 {
        g_dbg.last_error = str.copy("Failed to bind local debugger TCP server");
        g_dbg.status = .Idle;
        g_dbg.dirty = true;
        return cast(i32) abi.AbiError.ProcessFailed;
    }
    g_dbg.tcp_port      = port;
    g_dbg.tcp_connected = false;

    // 2. Instrument shadow workspace
    shadow_entry, prep_ok := prepare_shadow_workspace(g_dbg.entry_path, port);
    if !prep_ok {
        dbg_srv_close();
        g_dbg.tcp_port   = -1;
        g_dbg.last_error = str.copy(tprintf("Failed to instrument '{}'", g_dbg.entry_path));
        g_dbg.status     = .Idle;
        g_dbg.dirty      = true;
        return cast(i32) abi.AbiError.NotFound;
    }

    // 3. Build `onyx run --no-colors [extra_args...] <shadow_entry> [-- prog_args...]`
    onyx_exe := resolve_onyx_executable();
    arg_buf := make(dyn_str, 256, context.temp_allocator);
    Array.concat(&arg_buf, "run\n--no-colors\n");
    for a in g_dbg.extra_args {
        Array.concat(&arg_buf, a);
        Array.concat(&arg_buf, "\n");
    }
    Array.concat(&arg_buf, shadow_entry);
    if g_dbg.prog_args.count > 0 {
        Array.concat(&arg_buf, "\n--");
        for pa in g_dbg.prog_args {
            Array.concat(&arg_buf, "\n");
            Array.concat(&arg_buf, pa);
        }
    }

    cwd := ".";
    ph := dbg_proc_spawn(onyx_exe.data, onyx_exe.count, arg_buf.data, arg_buf.count, cwd.data, cwd.count);
    if ph == 0 {
        dbg_srv_close();
        g_dbg.tcp_port   = -1;
        g_dbg.last_error = str.copy("Failed to spawn onyx process");
        g_dbg.status     = .Idle;
        g_dbg.dirty      = true;
        return cast(i32) abi.AbiError.ProcessFailed;
    }

    g_dbg.proc_handle   = ph;
    g_dbg.status        = .Running;
    g_dbg.dirty         = true;
    g_dbg.markers_dirty = true;
    return 0;
}

/// Executes a live debugger control command.
dbg_command :: (cmd: abi.DebugCommand, buf_version: u32) -> i32 {
    if cmd == .Stop {
        stop_live_session();
        g_dbg.status           = .Idle;
        g_dbg.current_line     = 0;
        g_dbg.current_wat_line = -1;
        g_dbg.dirty            = true;
        g_dbg.markers_dirty    = true;
        return 0;
    }

    if g_dbg.status != .Paused && g_dbg.status != .Running {
        return cast(i32) abi.AbiError.NotReady;
    }

    switch cmd {
        case .Continue {
            if !g_dbg.tcp_connected do return cast(i32) abi.AbiError.NotReady;
            sync_breakpoints_to_child();
            send_tcp_line("CONT\n");
            g_dbg.status        = .Running;
            g_dbg.dirty         = true;
            g_dbg.markers_dirty = true;
        }
        case .StepOver {
            if !g_dbg.tcp_connected do return cast(i32) abi.AbiError.NotReady;
            sync_breakpoints_to_child();
            send_tcp_line("OVER\n");
            g_dbg.status        = .Running;
            g_dbg.dirty         = true;
            g_dbg.markers_dirty = true;
        }
        case .StepInto {
            if !g_dbg.tcp_connected do return cast(i32) abi.AbiError.NotReady;
            sync_breakpoints_to_child();
            send_tcp_line("INTO\n");
            g_dbg.status        = .Running;
            g_dbg.dirty         = true;
            g_dbg.markers_dirty = true;
        }
        case .StepOut {
            if !g_dbg.tcp_connected do return cast(i32) abi.AbiError.NotReady;
            sync_breakpoints_to_child();
            send_tcp_line("OUT\n");
            g_dbg.status        = .Running;
            g_dbg.dirty         = true;
            g_dbg.markers_dirty = true;
        }
        case .Pause {
            if !g_dbg.tcp_connected do return cast(i32) abi.AbiError.NotReady;
            send_tcp_line("PAUSE\n");
        }
        case .StepInstruction {
            // Load/advance WAT disassembly view for the currently paused function
            refresh_wat_cache_if_needed();
            if g_dbg.wat_line_count > 0 {
                if g_dbg.current_wat_line + 1 < g_dbg.wat_line_count {
                    g_dbg.current_wat_line += 1;
                } else {
                    g_dbg.current_wat_line = 0;
                }
                g_dbg.dirty = true;
            }
        }
        case _ {}
    }

    return 0;
}

/// Synchronously polls until the live debugger pauses or exits (used in automated tests).
dbg_wait_for_stop :: (max_iters: i32 = 8000) -> abi.DebugStatus {
    for _ in 0 .. max_iters {
        dbg_poll();
        if g_dbg.status == .Paused || g_dbg.status == .Exited || g_dbg.status == .Idle {
            return g_dbg.status;
        }
        // Small busy-yield via OS poll-friendly loop (each iter ~1ms with tiny work)
        os.sleep(1);
    }
    return g_dbg.status;
}

dbg_get_state_json :: (allocator := context.temp_allocator) -> str {
    out := make(dyn_str, g_dbg.wat_text.count + 2048, allocator);
    Array.concat(&out, tprintf("{{\"status\":{},\"source_path\":\"", cast(u32) g_dbg.status));
    Array.concat(&out, json_esc_wat(g_dbg.source_path));
    Array.concat(&out, tprintf("\",\"current_line\":{},\"current_func\":\"", g_dbg.current_line));
    Array.concat(&out, json_esc_wat(g_dbg.current_func));
    Array.concat(&out, "\",\"pause_reason\":\"");
    Array.concat(&out, json_esc_wat(g_dbg.pause_reason));
    Array.concat(&out, tprintf("\",\"exit_code\":{},\"current_wat_line\":{},\"wat_text\":\"", g_dbg.exit_code, g_dbg.current_wat_line));
    Array.concat(&out, json_esc_wat(g_dbg.wat_text));
    Array.concat(&out, "\",\"line_map\":[");
    for i in 0 .. g_dbg.line_map.count {
        m := &g_dbg.line_map[i];
        if i > 0 do Array.concat(&out, ",");
        Array.concat(&out, tprintf("{{\"onyx_line\":{},\"wat_start_line\":{},\"wat_end_line\":{}}}",
            m.onyx_line, m.wat_start_line, m.wat_end_line));
    }
    Array.concat(&out, "],\"locals\":[");
    for i in 0 .. g_dbg.locals.count {
        v := &g_dbg.locals[i];
        if i > 0 do Array.concat(&out, ",");
        Array.concat(&out, tprintf("{{\"name\":\"{}\",\"type\":\"{}\",\"value\":\"{}\",\"changed\":{}}}",
            json_esc_wat(v.name), json_esc_wat(v.type), json_esc_wat(v.value),
            "true" if v.changed else "false"));
    }
    Array.concat(&out, "],\"frames\":[");
    for i in 0 .. g_dbg.frames.count {
        f := &g_dbg.frames[i];
        if i > 0 do Array.concat(&out, ",");
        Array.concat(&out, tprintf("{{\"func\":\"{}\",\"path\":\"{}\",\"line\":{}}}",
            json_esc_wat(f.func), json_esc_wat(f.path), f.line));
    }
    Array.concat(&out, "],\"output\":\"");
    for i in 0 .. g_dbg.output_lines.count {
        if i > 0 do Array.concat(&out, "\\n");
        Array.concat(&out, json_esc_wat(g_dbg.output_lines[i]));
    }
    Array.concat(&out, "\",\"last_error\":\"");
    Array.concat(&out, json_esc_wat(g_dbg.last_error));
    Array.concat(&out, "\"}");
    return out;
}
