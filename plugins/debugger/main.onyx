// =============================================================================
// ODIT Plugin: Real Live Onyx Debugger (`build/plugins/debugger.wasm`)
// =============================================================================
// Full IDE debugger panel backed by real shadow-instrumented Onyx execution:
//   - Toolbar: Debug/Continue (F5), Pause, Step Over (F10), Step Into (F11),
//     Step Out (Shift+F11), Stop (Shift+F5), status & live location pills
//   - Editable `Cmd:` bar supporting full `onyx run --param ... file.onyx -- args`
//   - Left pane: Source view with clickable breakpoint gutter (red dots) and
//     highlighted active execution line (`>`) with auto-centering
//   - Right pane: Tabbed live inspector:
//       * Locals  — live runtime values & types with change highlighting + copy
//       * Stack   — real call stack frames (click to jump)
//       * BPs     — all workspace breakpoints (click to jump or remove)
//       * Out     — live captured stdout / stderr console
//       * WAT     — on-demand WebAssembly Text disassembly of active function

#load "../../abi/abi.onyx"
#load "../../sdk/plugin_sdk.onyx"

use core { package, Array, tprintf }
use odit.abi
use odit.sdk

LocalVar :: struct {
    name:    str;
    type:    str;
    value:   str;
    changed: bool;
}

StackFrame :: struct {
    func: str;
    path: str;
    line: u32;
}

BpItem :: struct {
    path: str;
    line: u32;
}

InspectorTab :: enum (i32) {
    Locals      :: 0;
    Stack       :: 1;
    Breakpoints :: 2;
    Output      :: 3;
    Wat         :: 4;
}

@sdk.Plugin.{
    id             = "odit.debugger",
    title          = "Live Debugger",
    version        = "0.2.0",
    default_slot   = 0,
    default_width  = 640.0f,
    default_height = 460.0f,
    event_mask     = 0x3FF,
    allow_multiple = false,
}
DebuggerPlugin :: struct {
    status:           abi.DebugStatus;
    source_path:      str;
    view_path:        str; // May differ from source_path when inspecting a caller stack frame
    view_line:        u32;
    current_line:     u32;
    current_func:     str;
    pause_reason:     str;
    exit_code:        i32;
    current_wat_line: i32;
    last_error:       str;

    src_lines:        [..] str;
    wat_lines:        [..] str;
    out_lines:        [..] str;
    all_bps:          [..] BpItem;
    locals:           [..] LocalVar;
    frames:           [..] StackFrame;

    active_tab:       InspectorTab;
    src_scroll_y:     f32;
    src_scroll_x:     f32;
    right_scroll_y:   f32;
    wat_scroll_x:     f32;

    cmd_buf:          [256] u8;
    cmd_len:          u32;
    cmd_user_edited:  bool;
    needs_sync:       bool;
    auto_scroll_req:  bool;
}

#local
clear_str_list :: (list: &[..] str) {
    for s in *list do sdk.free_str(s);
    Array.clear(list);
}

#local
split_into_lines :: (dst: &[..] str, text: str) {
    clear_str_list(dst);
    if text.count == 0 do return;
    start := 0;
    for i in 0 .. (text.count + 1) {
        if i == text.count || text[i] == '\n' {
            e := i;
            if e > start && text[e - 1] == '\r' do e -= 1;
            *dst << sdk.copy_str(text[start .. e]);
            start = i + 1;
        }
    }
}

#local
refresh_breakpoints :: (self: &DebuggerPlugin) {
    for &b in self.all_bps do sdk.free_str(b.path);
    Array.clear(&self.all_bps);
    js := sdk.debug_get_breakpoints_json("", context.temp_allocator);
    if js.count == 0 do return;
    sdk.each_json_object(js, [obj] {
        bp_path := sdk.json_get_str(obj, "path", context.temp_allocator);
        bp_line := sdk.json_get_i32(obj, "line");
        if bp_path.count > 0 && bp_line > 0 {
            self.all_bps << .{ sdk.copy_str(bp_path), cast(u32) bp_line };
        }
    });
}

#local
has_bp_in_view :: (self: &DebuggerPlugin, line: u32) -> bool {
    for &b in self.all_bps {
        if b.line == line && str.equal(b.path, self.view_path) do return true;
    }
    return false;
}

#local
set_default_cmd :: (self: &DebuggerPlugin, path: str) {
    if self.cmd_user_edited || path.count == 0 do return;
    def := tprintf("onyx run {}", path);
    n := def.count if def.count < 255 else 255;
    for i in 0 .. n do self.cmd_buf[i] = def[i];
    self.cmd_len = cast(u32) n;
}

#local
current_run_cmd :: (self: &DebuggerPlugin) -> str {
    if self.cmd_len > 0 {
        return str.{ &self.cmd_buf[0], cast(i32) self.cmd_len };
    }
    return self.view_path;
}

#local
load_view_file :: (self: &DebuggerPlugin, path: str, focus_line: u32, force_reload: bool = false, scroll_to_line: bool = true) {
    if path.count == 0 do return;
    set_default_cmd(self, path);
    if force_reload || !str.equal(path, self.view_path) || self.src_lines.count == 0 {
        sdk.free_str(self.view_path);
        self.view_path = sdk.copy_str(path);
        src := sdk.workspace_read_file(path, context.temp_allocator);
        split_into_lines(&self.src_lines, src);
    }
    self.view_line = focus_line;
    if scroll_to_line && focus_line > 0 {
        self.auto_scroll_req = true;
    }
}

#local
apply_state_json :: (self: &DebuggerPlugin, js: str) {
    if js.count == 0 do return;

    prev_status := self.status;
    prev_line   := self.current_line;
    prev_path   := str.temp_copy(self.source_path);
    self.status           = cast(abi.DebugStatus) sdk.json_get_i32(js, "status");
    self.current_line     = cast(u32) sdk.json_get_i32(js, "current_line");
    self.exit_code        = sdk.json_get_i32(js, "exit_code");
    self.current_wat_line = sdk.json_get_i32(js, "current_wat_line");

    sp := sdk.json_get_str(js, "source_path", context.temp_allocator);
    if sp.count == 0 do sp = sdk.editor_active_path(context.temp_allocator);

    if !str.equal(sp, self.source_path) {
        sdk.free_str(self.source_path);
        self.source_path = sdk.copy_str(sp);
    }

    fn := sdk.json_get_str(js, "current_func", context.temp_allocator);
    sdk.free_str(self.current_func);
    self.current_func = sdk.copy_str(fn);

    pr := sdk.json_get_str(js, "pause_reason", context.temp_allocator);
    sdk.free_str(self.pause_reason);
    self.pause_reason = sdk.copy_str(pr);

    le := sdk.json_get_str(js, "last_error", context.temp_allocator);
    sdk.free_str(self.last_error);
    self.last_error = sdk.copy_str(le);

    wt := sdk.json_get_str(js, "wat_text", context.temp_allocator);
    split_into_lines(&self.wat_lines, wt);

    out_txt := sdk.json_get_str(js, "output", context.temp_allocator);
    split_into_lines(&self.out_lines, out_txt);

    // Parse live locals
    for &v in self.locals {
        sdk.free_str(v.name);
        sdk.free_str(v.type);
        sdk.free_str(v.value);
    }
    Array.clear(&self.locals);
    loc_arr := sdk.json_get_array_slice(js, "locals");
    if loc_arr.count > 0 {
        sdk.each_json_object(loc_arr, [obj] {
            self.locals << .{
                name    = sdk.copy_str(sdk.json_get_str(obj, "name", context.temp_allocator)),
                type    = sdk.copy_str(sdk.json_get_str(obj, "type", context.temp_allocator)),
                value   = sdk.copy_str(sdk.json_get_str(obj, "value", context.temp_allocator)),
                changed = sdk.json_get_bool(obj, "changed"),
            };
        });
    }

    // Parse live call stack frames
    for &f in self.frames {
        sdk.free_str(f.func);
        sdk.free_str(f.path);
    }
    Array.clear(&self.frames);
    fr_arr := sdk.json_get_array_slice(js, "frames");
    if fr_arr.count > 0 {
        sdk.each_json_object(fr_arr, [obj] {
            self.frames << .{
                func = sdk.copy_str(sdk.json_get_str(obj, "func", context.temp_allocator)),
                path = sdk.copy_str(sdk.json_get_str(obj, "path", context.temp_allocator)),
                line = cast(u32) sdk.json_get_i32(obj, "line"),
            };
        });
    }

    // Auto-switch to Output tab if program failed with an error on exit
    if self.status == .Exited && prev_status == .Running && self.exit_code != 0 && self.out_lines.count > 0 {
        self.active_tab = .Output;
    }

    if self.source_path.count > 0 {
        moved := self.current_line != prev_line || !str.equal(self.source_path, prev_path) || self.status != prev_status;
        restarted := prev_status != .Running && prev_status != .Paused && (self.status == .Running || self.status == .Paused);
        load_view_file(self, self.source_path, self.current_line, restarted, moved);
    }
    refresh_breakpoints(self);
}

#local
sync_all :: (self: &DebuggerPlugin) {
    js := sdk.debug_get_state_json(context.temp_allocator);
    if js.count > 0 {
        apply_state_json(self, js);
    } else {
        ap := sdk.editor_active_path(context.temp_allocator);
        if ap.count > 0 {
            load_view_file(self, ap, 0);
        }
        refresh_breakpoints(self);
    }
}

#local
wat_line_color :: (line: str) -> u32 {
    i := 0;
    while i < line.count && (line[i] == ' ' || line[i] == '\t') do i += 1;
    t := line[i .. line.count];
    if str.starts_with(t, ";;")                                  do return sdk.theme_color(.TextDisabled);
    if str.starts_with(t, "(func") || str.starts_with(t, ")")    do return sdk.theme_color(.Accent);
    if str.starts_with(t, "(local") || str.starts_with(t, "local.") || str.starts_with(t, "(param") do return sdk.theme_color(.Info);
    if str.starts_with(t, "call_indirect")                       do return sdk.theme_color(.Error);
    if str.starts_with(t, "call") || str.starts_with(t, "return") || str.starts_with(t, "br") || str.starts_with(t, "if") || str.starts_with(t, "loop") || str.starts_with(t, "block") || str.starts_with(t, "end") {
        return sdk.theme_color(.Success);
    }
    if str.starts_with(t, "i32.") || str.starts_with(t, "i64.") || str.starts_with(t, "f32.") || str.starts_with(t, "f64.") || str.starts_with(t, "memory.") {
        return sdk.theme_color(.Warning);
    }
    return sdk.theme_color(.TextPrimary);
}

@sdk.PluginInit
init :: (self: &DebuggerPlugin, window_id: u32) -> i32 {
    self.src_lines   = make([..] str);
    self.wat_lines   = make([..] str);
    self.out_lines   = make([..] str);
    self.all_bps     = make([..] BpItem);
    self.locals      = make([..] LocalVar);
    self.frames      = make([..] StackFrame);
    self.active_tab  = .Locals;
    self.current_wat_line = -1;
    self.needs_sync  = true;

    sdk.register_command("debugger.start",    "Debugger: Start / Continue (F5)", "");
    sdk.register_command("debugger.step",     "Debugger: Step Over (F10)",       "");
    sdk.register_command("debugger.step_in",  "Debugger: Step Into (F11)",       "");
    sdk.register_command("debugger.step_out", "Debugger: Step Out (Shift+F11)",  "");
    sdk.register_command("debugger.stop",     "Debugger: Stop Session",          "");
    return 0;
}

@sdk.PluginEvent
on_event :: (self: &DebuggerPlugin, window_id: u32, event: sdk.Event) {
    switch event {
        case .ActiveFileChanged as path {
            if self.status != .Paused && path.count > 0 {
                load_view_file(self, path, 0);
                refresh_breakpoints(self);
            }
        }
        case .BufferModified as bm {
            if bm.saved && str.equal(bm.path, self.view_path) {
                src := sdk.workspace_read_file(self.view_path, context.temp_allocator);
                split_into_lines(&self.src_lines, src);
            }
        }
        case .Command as cmd {
            if str.equal(cmd, "debugger.start") {
                if self.status == .Paused do sdk.debug_command(.Continue);
                else do sdk.debug_start(current_run_cmd(self));
                self.needs_sync = true;
            } elseif str.equal(cmd, "debugger.step") {
                sdk.debug_command(.StepOver);
                self.needs_sync = true;
            } elseif str.equal(cmd, "debugger.step_in") {
                sdk.debug_command(.StepInto);
                self.needs_sync = true;
            } elseif str.equal(cmd, "debugger.step_out") {
                sdk.debug_command(.StepOut);
                self.needs_sync = true;
            } elseif str.equal(cmd, "debugger.stop") {
                sdk.debug_command(.Stop);
                self.needs_sync = true;
            }
        }
        case .DebugStateChanged as js {
            if js.count > 0 {
                apply_state_json(self, js);
            } else {
                self.needs_sync = true;
            }
        }
        case _ {}
    }
}

@sdk.PluginRender
render :: (self: &DebuggerPlugin, window_id: u32, ctx: &abi.FrameContext) {
    if self.needs_sync {
        self.needs_sync = false;
        sync_all(self);
    }

    pad: f32 = 8.0f;
    w := ctx.width;
    h := ctx.height;
    y := pad;

    c_text   := sdk.theme_color(.TextPrimary);
    c_muted  := sdk.theme_color(.TextSecondary);
    c_dis    := sdk.theme_color(.TextDisabled);
    c_accent := sdk.theme_color(.Accent);
    c_ok     := sdk.theme_color(.Success);
    c_warn   := sdk.theme_color(.Warning);
    c_err    := sdk.theme_color(.Error);
    c_info   := sdk.theme_color(.Info);
    c_surf   := sdk.theme_color(.BgSurface);
    c_hdr    := sdk.theme_color(.BgHeader);
    c_border := sdk.theme_color(.Border);
    c_base   := sdk.theme_color(.BgBase);

    // ---- Row 1: Control Toolbar ----
    bx := pad;
    btn_h: f32 = 24.0f;
    gap: f32 = 5.0f;

    is_paused  := self.status == .Paused;
    is_running := self.status == .Running;

    if is_paused {
        sdk.on_click(1, bx, y, 56.0f, btn_h, "Cont", .Primary) {
            sdk.debug_command(.Continue);
        };
        bx += 56.0f + gap;
        sdk.on_click(2, bx, y, 52.0f, btn_h, "Over", .{}) {
            sdk.debug_command(.StepOver);
        };
        bx += 52.0f + gap;
        sdk.on_click(3, bx, y, 48.0f, btn_h, "Into", .{}) {
            sdk.debug_command(.StepInto);
        };
        bx += 48.0f + gap;
        sdk.on_click(4, bx, y, 44.0f, btn_h, "Out", .{}) {
            sdk.debug_command(.StepOut);
        };
        bx += 44.0f + gap;
        sdk.on_click(5, bx, y, 48.0f, btn_h, "Stop", .Danger) {
            sdk.debug_command(.Stop);
        };
        bx += 48.0f + gap;
    } elseif is_running {
        sdk.on_click(6, bx, y, 58.0f, btn_h, "Pause", .Primary) {
            sdk.debug_command(.Pause);
        };
        bx += 58.0f + gap;
        sdk.on_click(5, bx, y, 52.0f, btn_h, "Stop", .Danger) {
            sdk.debug_command(.Stop);
        };
        bx += 52.0f + gap;
    } else {
        sdk.on_click(1, bx, y, 82.0f, btn_h, "Debug (F5)", .Primary) {
            sdk.debug_start(current_run_cmd(self));
            self.needs_sync = true;
        };
        bx += 82.0f + gap;
    }

    // Status pill on right edge
    st_txt := "IDLE";
    st_bg  := c_border;
    st_fg  := c_text;
    if is_paused {
        st_txt = "BP" if str.equal(self.pause_reason, "breakpoint") else "PAUSED";
        st_bg  = c_warn;
        st_fg  = c_base;
    } elseif is_running {
        st_txt = "RUNNING";
        st_bg  = c_info;
        st_fg  = c_base;
    } elseif self.status == .Exited {
        st_txt = tprintf("EXIT {}", self.exit_code);
        st_bg  = c_ok if self.exit_code == 0 else c_err;
        st_fg  = c_base;
    }
    st_w := sdk.measure_text(st_txt, 11.0f) + 18.0f;
    sdk.pill(w - pad - st_w, y + 2.0f, st_txt, st_bg, st_fg);

    // Current paused function summary
    if is_paused && self.current_func.count > 0 && bx + 60.0f < (w - pad - st_w - 8.0f) {
        loc_txt := tprintf("{}() :{}", self.current_func, self.current_line);
        sdk.draw_text(bx + 4.0f, y + 5.0f, loc_txt, 12.0f, c_accent, abi.TextFlags.Mono | abi.TextFlags.Ellipsis);
    }
    y += btn_h + 6.0f;

    // ---- Row 2: Run Command Bar ----
    cmd_h: f32 = 24.0f;
    sdk.draw_text(pad + 2.0f, y + 5.0f, "Cmd:", 11.5f, c_muted, .Bold);
    cmd_x := pad + 36.0f;
    cmd_w := w - cmd_x - pad;
    if cmd_w < 100.0f do cmd_w = 100.0f;
    cst := sdk.input_text(10, cmd_x, y, cmd_w, cmd_h, self.cmd_buf, &self.cmd_len, "onyx run --param ... src/main.onyx");
    if sdk.is_changed(cst) {
        self.cmd_user_edited = true;
    }
    if sdk.is_submitted(cst) {
        sdk.debug_start(current_run_cmd(self));
        self.needs_sync = true;
    }
    y += cmd_h + 6.0f;

    // Reserve optional error banner at bottom
    err_h: f32 = 24.0f if self.last_error.count > 0 else 0.0f;
    body_h := h - y - pad - (err_h + 4.0f if err_h > 0.0f else 0.0f);
    if body_h < 100.0f do body_h = 100.0f;

    // ---- Main Split: Left Source (54%) | Right Tabbed Inspector (46%) ----
    split_gap: f32 = 6.0f;
    inner_w := w - pad * 2.0f;
    left_w  := (inner_w - split_gap) * 0.54f;
    right_w := inner_w - split_gap - left_w;
    if left_w < 140.0f  do left_w = 140.0f;
    if right_w < 140.0f do right_w = 140.0f;
    left_x  := pad;
    right_x := left_x + left_w + split_gap;

    // ---- LEFT PANE: Source Code with Breakpoint Gutter ----
    sdk.draw_rect(left_x, y, left_w, body_h, c_surf, 5.0f, c_border, 1.0f);
    hdr_h: f32 = 24.0f;
    sdk.draw_rect(left_x, y, left_w, hdr_h, c_hdr, 4.0f, c_border, 1.0f);
    src_hdr := self.view_path if self.view_path.count > 0 else "No file open";
    sdk.draw_text(left_x + 8.0f, y + 5.0f, src_hdr, 11.5f, c_text, abi.TextFlags.Mono | abi.TextFlags.Ellipsis);

    // Open in main editor button
    if self.view_path.count > 0 {
        sdk.on_click(11, left_x + left_w - 46.0f, y + 2.0f, 42.0f, 20.0f, "Open", .Ghost) {
            ln := cast(i32) self.view_line if self.view_line > 0 else 1;
            sdk.editor_open(self.view_path, ln, 1);
        };
    }

    src_y := y + hdr_h + 2.0f;
    src_h := body_h - hdr_h - 4.0f;
    line_h: f32 = 18.0f;
    content_h := cast(f32) self.src_lines.count * line_h + 16.0f;

    if self.auto_scroll_req && self.view_line > 0 {
        self.auto_scroll_req = false;
        target_y := cast(f32) (cast(i32) self.view_line - 1) * line_h - src_h * 0.4f;
        if target_y < 0.0f do target_y = 0.0f;
        self.src_scroll_y = target_y;
    }

    sdk.scroll_begin(20, left_x + 2.0f, src_y, left_w - 4.0f, src_h, content_h, &self.src_scroll_y);
    gutter_w: f32 = 44.0f;
    for i in 0 .. self.src_lines.count {
        ly := src_y + cast(f32) i * line_h;
        vis_y := ly - self.src_scroll_y;
        if vis_y + line_h < src_y || vis_y > src_y + src_h do continue;

        ln_num := cast(u32) (i + 1);
        is_cur := is_paused && ln_num == self.current_line && str.equal(self.view_path, self.source_path);
        is_frm := !is_cur && ln_num == self.view_line && self.view_line > 0;
        has_bp := has_bp_in_view(self, ln_num);

        if is_cur {
            sdk.draw_rect(left_x + 3.0f, ly, left_w - 8.0f, line_h, 0xF9E2AF2E, 2.0f);
        } elseif is_frm {
            sdk.draw_rect(left_x + 3.0f, ly, left_w - 8.0f, line_h, 0x89B4FA24, 2.0f);
        }

        // Clickable gutter toggles breakpoint!
        gst := sdk.button(cast(u32) (2000 + i), left_x + 2.0f, ly, gutter_w, line_h, "", .Ghost);
        if sdk.is_clicked(gst) && self.view_path.count > 0 {
            sdk.debug_toggle_breakpoint(self.view_path, ln_num);
            refresh_breakpoints(self);
        }

        if has_bp {
            sdk.draw_circle(left_x + 11.0f, ly + line_h * 0.5f, 4.2f, c_err);
        }
        if is_cur {
            sdk.draw_text(left_x + 17.0f, ly + 2.0f, ">", 11.5f, c_warn, .Bold);
        }

        lnum_str := tprintf("{:3}", ln_num);
        sdk.draw_text(left_x + 22.0f, ly + 2.0f, lnum_str, 11.0f, c_warn if is_cur else c_dis, .Mono);
        sdk.draw_text(left_x + gutter_w + 4.0f, ly + 2.0f, self.src_lines[i], 11.5f, c_text, abi.TextFlags.Mono | abi.TextFlags.Ellipsis);
    }
    sdk.scroll_end();

    // ---- RIGHT PANE: Tabbed Inspector ----
    sdk.draw_rect(right_x, y, right_w, body_h, c_surf, 5.0f, c_border, 1.0f);
    sdk.draw_rect(right_x, y, right_w, hdr_h, c_hdr, 4.0f, c_border, 1.0f);

    // Tab buttons
    tx := right_x + 4.0f;
    tab_h: f32 = 20.0f;
    tab_y := y + 2.0f;

    loc_lbl := tprintf("Locals({})", self.locals.count);
    stk_lbl := tprintf("Stack({})",  self.frames.count);
    bp_lbl  := tprintf("BPs({})",    self.all_bps.count);

    tabs := str.[ loc_lbl, stk_lbl, bp_lbl, "Out", "WAT" ];
    for ti in 0 .. 5 {
        tw := sdk.measure_text(tabs[ti], 10.5f) + 12.0f;
        if tx + tw > right_x + right_w - 2.0f do tw = (right_x + right_w - 2.0f) - tx;
        if tw < 26.0f do break;
        is_sel := cast(i32) self.active_tab == ti;
        sdk.on_click(cast(u32) (30 + ti), tx, tab_y, tw, tab_h, tabs[ti], .Active if is_sel else .Ghost) {
            self.active_tab = cast(InspectorTab) ti;
            self.right_scroll_y = 0.0f;
            if self.active_tab == .Wat && self.wat_lines.count == 0 && is_paused {
                sdk.debug_command(.StepInstruction);
            }
        };
        tx += tw + 3.0f;
    }

    ry := y + hdr_h + 4.0f;
    rh := body_h - hdr_h - 6.0f;

    switch self.active_tab {
        case .Locals {
            if self.locals.count == 0 {
                msg := "No locals in scope yet." if is_paused else "Pause at a breakpoint or step to inspect locals.";
                sdk.draw_text_wrapped(right_x + 10.0f, ry + 8.0f, right_w - 20.0f, msg, 12.0f, c_muted);
            } else {
                vrow_h: f32 = 22.0f;
                vc_h := cast(f32) self.locals.count * vrow_h + 12.0f;
                sdk.scroll_begin(21, right_x + 2.0f, ry, right_w - 4.0f, rh, vc_h, &self.right_scroll_y);
                for i in 0 .. self.locals.count {
                    v := &self.locals[i];
                    vy := ry + cast(f32) i * vrow_h;
                    vis := vy - self.right_scroll_y;
                    if vis + vrow_h < ry || vis > ry + rh do continue;

                    if (i % 2) == 1 {
                        sdk.draw_rect(right_x + 4.0f, vy, right_w - 10.0f, vrow_h, 0x1E1E2E55, 2.0f);
                    }
                    if v.changed {
                        sdk.draw_rect(right_x + 4.0f, vy, right_w - 10.0f, vrow_h, 0xF9E2AF1E, 2.0f);
                    }

                    vst := sdk.button(cast(u32) (4000 + i), right_x + 4.0f, vy, right_w - 10.0f, vrow_h, "", .Ghost);
                    if sdk.is_clicked(vst) {
                        sdk.set_clipboard(v.value);
                        sdk.notify(.Info, tprintf("Copied {} = {}", v.name, v.value));
                    }
                    if sdk.is_hovered(vst) {
                        sdk.tooltip(tprintf("{}: {} = {}", v.name, v.type, v.value));
                    }

                    name_w := right_w * 0.34f;
                    if name_w < 70.0f do name_w = 70.0f;
                    sdk.draw_text(right_x + 8.0f, vy + 4.0f, v.name, 11.5f, c_warn if v.changed else c_info, abi.TextFlags.Mono | abi.TextFlags.Bold);
                    sdk.draw_text(right_x + name_w, vy + 4.0f, tprintf("= {}", v.value), 11.5f, c_warn if v.changed else c_text, abi.TextFlags.Mono | abi.TextFlags.Ellipsis);
                }
                sdk.scroll_end();
            }
        }

        case .Stack {
            if self.frames.count == 0 {
                sdk.draw_text(right_x + 10.0f, ry + 8.0f, "Call stack is empty.", 12.0f, c_muted);
            } else {
                frow_h: f32 = 24.0f;
                fc_h := cast(f32) self.frames.count * frow_h + 12.0f;
                sdk.scroll_begin(22, right_x + 2.0f, ry, right_w - 4.0f, rh, fc_h, &self.right_scroll_y);
                for i in 0 .. self.frames.count {
                    fr := &self.frames[i];
                    fy := ry + cast(f32) i * frow_h;
                    fst := sdk.button(cast(u32) (5000 + i), right_x + 4.0f, fy, right_w - 10.0f, frow_h, "", .Active if i == 0 else .Ghost);
                    if sdk.is_clicked(fst) {
                        load_view_file(self, fr.path, fr.line);
                        sdk.editor_open(fr.path, cast(i32) fr.line, 1);
                    }
                    lbl := tprintf("#{} {}()  {}:{}", i, fr.func, fr.path, fr.line);
                    sdk.draw_text(right_x + 8.0f, fy + 5.0f, lbl, 11.5f, c_accent if i == 0 else c_text, abi.TextFlags.Mono | abi.TextFlags.Ellipsis);
                }
                sdk.scroll_end();
            }
        }

        case .Breakpoints {
            if self.all_bps.count == 0 {
                sdk.draw_text_wrapped(right_x + 10.0f, ry + 8.0f, right_w - 20.0f, "Click a line gutter or press F9 in the editor to add breakpoints.", 12.0f, c_muted);
            } else {
                brow_h: f32 = 24.0f;
                bc_h := cast(f32) self.all_bps.count * brow_h + 12.0f;
                sdk.scroll_begin(23, right_x + 2.0f, ry, right_w - 4.0f, rh, bc_h, &self.right_scroll_y);
                for i in 0 .. self.all_bps.count {
                    bp := &self.all_bps[i];
                    by := ry + cast(f32) i * brow_h;
                    bst := sdk.button(cast(u32) (6000 + i), right_x + 4.0f, by, right_w - 36.0f, brow_h, "", .Ghost);
                    if sdk.is_clicked(bst) {
                        load_view_file(self, bp.path, bp.line);
                        sdk.editor_open(bp.path, cast(i32) bp.line, 1);
                    }
                    sdk.draw_circle(right_x + 12.0f, by + brow_h * 0.5f, 4.0f, c_err);
                    sdk.draw_text(right_x + 22.0f, by + 5.0f, tprintf("{}:{}", bp.path, bp.line), 11.5f, c_text, abi.TextFlags.Mono | abi.TextFlags.Ellipsis);

                    sdk.on_click(cast(u32) (6500 + i), right_x + right_w - 28.0f, by + 2.0f, 22.0f, 20.0f, "x", .Danger) {
                        sdk.debug_toggle_breakpoint(bp.path, bp.line);
                        refresh_breakpoints(self);
                        break;
                    };
                }
                sdk.scroll_end();
            }
        }

        case .Output {
            if self.out_lines.count == 0 {
                sdk.draw_text(right_x + 10.0f, ry + 8.0f, "Program stdout / stderr will appear here.", 12.0f, c_muted);
            } else {
                olh: f32 = 17.0f;
                oc_h := cast(f32) self.out_lines.count * olh + 12.0f;
                sdk.scroll_begin(24, right_x + 2.0f, ry, right_w - 4.0f, rh, oc_h, &self.right_scroll_y);
                for i in 0 .. self.out_lines.count {
                    oy := ry + cast(f32) i * olh;
                    vis := oy - self.right_scroll_y;
                    if vis + olh < ry || vis > ry + rh do continue;
                    ln := self.out_lines[i];
                    col := c_err if (str.contains(ln, "error:") || str.contains(ln, "Error")) else c_text;
                    sdk.draw_text(right_x + 8.0f, oy + 1.0f, ln, 11.5f, col, abi.TextFlags.Mono | abi.TextFlags.Ellipsis);
                }
                sdk.scroll_end();
            }
        }

        case .Wat {
            if self.wat_lines.count == 0 {
                sdk.draw_text_wrapped(right_x + 10.0f, ry + 8.0f, right_w - 20.0f, "Disassemble the active paused function to inspect its WebAssembly Text (.wat).", 12.0f, c_muted);
                if is_paused {
                    sdk.on_click(40, right_x + 10.0f, ry + 54.0f, 120.0f, 26.0f, "Load WAT", .Primary) {
                        sdk.debug_command(.StepInstruction);
                    };
                }
            } else {
                wlh: f32 = 17.0f;
                wc_h := cast(f32) self.wat_lines.count * wlh + 12.0f;
                sdk.scroll_begin(25, right_x + 2.0f, ry, right_w - 4.0f, rh, wc_h, &self.right_scroll_y);
                for i in 0 .. self.wat_lines.count {
                    wy := ry + cast(f32) i * wlh;
                    vis := wy - self.right_scroll_y;
                    if vis + wlh < ry || vis > ry + rh do continue;
                    if i == self.current_wat_line {
                        sdk.draw_rect(right_x + 4.0f, wy, right_w - 10.0f, wlh, 0x89B4FA2E, 2.0f);
                    }
                    sdk.draw_text(right_x + 8.0f, wy + 1.0f, self.wat_lines[i], 11.0f, wat_line_color(self.wat_lines[i]), abi.TextFlags.Mono | abi.TextFlags.Ellipsis);
                }
                sdk.scroll_end();
            }
        }
    }

    // ---- Optional Error Banner at Bottom ----
    if err_h > 0.0f {
        ey := h - pad - err_h;
        sdk.draw_rect(pad, ey, inner_w, err_h, 0xF38BA822, 4.0f, c_err, 1.0f);
        sdk.draw_text(pad + 8.0f, ey + 5.0f, self.last_error, 11.5f, c_err, abi.TextFlags.Mono | abi.TextFlags.Ellipsis);
    }
}
