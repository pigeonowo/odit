    // Default: Catppuccin Mocha
    g_theme.name = "mocha";
    g_theme.colors[cast(u32) abi.ThemeColor.BgBase]        = 0x11111BFF;
    g_theme.colors[cast(u32) abi.ThemeColor.BgPanel]       = 0x181825FF;
    g_theme.colors[cast(u32) abi.ThemeColor.BgHeader]      = 0x1E1E2EFF;
    g_theme.colors[cast(u32) abi.ThemeColor.BgSurface]     = 0x242538FF;
    g_theme.colors[cast(u32) abi.ThemeColor.BgHover]       = 0x313244FF;
    g_theme.colors[cast(u32) abi.ThemeColor.BgSelection]   = 0x45475AFF;
    g_theme.colors[cast(u32) abi.ThemeColor.Border]        = 0x313244FF;
    g_theme.colors[cast(u32) abi.ThemeColor.BorderFocused] = 0x89B4FAFF;
    g_theme.colors[cast(u32) abi.ThemeColor.TextPrimary]   = 0xCDD6F4FF;
    g_theme.colors[cast(u32) abi.ThemeColor.TextSecondary] = 0x9399B2FF;
    g_theme.colors[cast(u32) abi.ThemeColor.TextDisabled]  = 0x6C7086FF;
    g_theme.colors[cast(u32) abi.ThemeColor.Accent]        = 0xB4BEFEFF;
    g_theme.colors[cast(u32) abi.ThemeColor.Success]       = 0xA6E3A1FF;
    g_theme.colors[cast(u32) abi.ThemeColor.Warning]       = 0xF9E2AFFF;
    g_theme.colors[cast(u32) abi.ThemeColor.Error]         = 0xF38BA8FF;
    g_theme.colors[cast(u32) abi.ThemeColor.Info]          = 0x89DCEBFF;

    g_theme.syn_default   = 0xCDD6F4FF;
    g_theme.syn_keyword   = 0xCBA6F7FF;
    g_theme.syn_directive = 0xFAB387FF;
    g_theme.syn_type      = 0xF9E2AFFF;
    g_theme.syn_string    = 0xA6E3A1FF;
    g_theme.syn_number    = 0xFAB387FF;
    g_theme.syn_comment   = 0x6C7086FF;
    g_theme.syn_operator  = 0x89DCEBFF;
    g_theme.syn_func      = 0x89B4FAFF;
    g_theme.syn_tag       = 0xF5C2E7FF;
}

theme_load_font :: (custom_font_path: str = "") {
    if g_theme.font_loaded {
        raylib.UnloadFont(g_theme.font_mono);
        g_theme.font_loaded = false;
    }

    empty_cp: [] i32 = .{ null, 0 };

    // Try user-configured font path first
    if custom_font_path.count > 0 {
        cpath := to_temp_cstr(custom_font_path);
        if raylib.FileExists(cpath) {
            raylib.LoadFontEx(cpath, 48, empty_cp, &g_theme.font_mono);
            if g_theme.font_mono.texture.id != 0 {
                raylib.SetTextureFilter(g_theme.font_mono.texture, .BILINEAR);
                g_theme.font_loaded = true;
                return;
            }
        }
    }

    // Fallback to bundled or system monospace fonts (rasterized at 48px for sharp scaling)
    font_candidates := .[
        "assets/fonts/JetBrainsMono-Regular.ttf\0",
        "assets/fonts/NotoSansMono-Regular.ttf\0",
        "/usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf\0",
        "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf\0",
    ];

    for path in font_candidates {
        cpath := cast(cstr) path.data;
        if raylib.FileExists(cpath) {
            raylib.LoadFontEx(cpath, 48, empty_cp, &g_theme.font_mono);
            if g_theme.font_mono.texture.id != 0 {
                raylib.SetTextureFilter(g_theme.font_mono.texture, .BILINEAR);
                g_theme.font_loaded = true;
                return;
            }
        }
    }

    raylib.GetFontDefault(&g_theme.font_mono);
}

theme_init :: (preset_name: str = "mocha", custom_font_path: str = "") {
    theme_apply_preset(preset_name);
    theme_load_font(custom_font_path);
}

theme_shutdown :: () {
    if g_theme.font_loaded {
        raylib.UnloadFont(g_theme.font_mono);
        g_theme.font_loaded = false;
    }
}

get_color :: (role: abi.ThemeColor) -> u32 {
    idx := cast(u32) role;
    if idx >= 16 do return 0xFFFFFFFF;
    return g_theme.colors[idx];
}

get_rl :: (role: abi.ThemeColor) -> raylib.Color {
    return rgba_to_rl(get_color(role));
}

/// Null-terminates an Onyx `str` into temporary memory for Raylib C calls.
to_temp_cstr :: (s: str) -> cstr {
    buf := make([] u8, s.count + 1, context.temp_allocator);
    if s.count > 0 {
        memory.copy(buf.data, s.data, s.count);
    }
    buf[s.count] = 0;
    return cast(cstr) buf.data;
}

measure_text :: (text: str, font_size: f32) -> f32 {
    if text.count == 0 do return 0.0;
    cs := to_temp_cstr(text);
    sz: raylib.Vector2;
    raylib.MeasureTextEx(g_theme.font_mono, cs, font_size, 0.5, &sz);
    return sz.x;
}

draw_text :: (x, y: f32, text: str, font_size: f32, rgba: u32) {
    if text.count == 0 do return;
    cs := to_temp_cstr(text);
    raylib.DrawTextEx(g_theme.font_mono, cs, .{ x, y }, font_size, 0.5, rgba_to_rl(rgba));
}

draw_rect :: (x, y, w, h: f32, fill_rgba: u32, radius: f32 = 0.0, border_rgba: u32 = 0, border_w: f32 = 0.0) {
    rec := raylib.Rectangle.{ x, y, w, h };
    if (fill_rgba & 0xFF) != 0 {
        if radius > 0.0 && w > 0.0 && h > 0.0 {
            min_dim := w if w < h else h;
            roundness := (radius * 2.0) / min_dim;
            if roundness > 1.0 do roundness = 1.0;
            raylib.DrawRectangleRounded(rec, roundness, 8, rgba_to_rl(fill_rgba));
        } else {
            raylib.DrawRectangleRec(rec, rgba_to_rl(fill_rgba));
        }
    }
    if border_w > 0.0 && (border_rgba & 0xFF) != 0 {
        if radius > 0.0 && w > 0.0 && h > 0.0 {
            min_dim := w if w < h else h;
            roundness := (radius * 2.0) / min_dim;
            if roundness > 1.0 do roundness = 1.0;
            raylib.DrawRectangleRoundedLines(rec, roundness, 8, border_w, rgba_to_rl(border_rgba));
        } else {
            raylib.DrawRectangleLinesEx(rec, border_w, rgba_to_rl(border_rgba));
        }
    }
}
