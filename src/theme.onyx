        g_theme.colors[cast(u32) abi.ThemeColor.BgHover]       = 0xBCC0CCFF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgSelection]   = 0xACB0BEFF;
        g_theme.colors[cast(u32) abi.ThemeColor.Border]        = 0xBCC0CCFF;
        g_theme.colors[cast(u32) abi.ThemeColor.BorderFocused] = 0x1E66F5FF;
        g_theme.colors[cast(u32) abi.ThemeColor.TextPrimary]   = 0x4C4F69FF;
        g_theme.colors[cast(u32) abi.ThemeColor.TextSecondary] = 0x6C6F85FF;
        g_theme.colors[cast(u32) abi.ThemeColor.TextDisabled]  = 0x9CA0B0FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Accent]        = 0x8839EFFF;
        g_theme.colors[cast(u32) abi.ThemeColor.Success]       = 0x40A02BFF;
        g_theme.colors[cast(u32) abi.ThemeColor.Warning]       = 0xDF8E1DFF;
        g_theme.colors[cast(u32) abi.ThemeColor.Error]         = 0xD20F39FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Info]          = 0x04A5E5FF;

        g_theme.syn_default   = 0x4C4F69FF;
        g_theme.syn_keyword   = 0x8839EFFF;
        g_theme.syn_directive = 0xFE640BFF;
        g_theme.syn_type      = 0xDF8E1DFF;
        g_theme.syn_string    = 0x40A02BFF;
        g_theme.syn_number    = 0xFE640BFF;
        g_theme.syn_comment   = 0x8C8FA1FF;
        g_theme.syn_operator  = 0x04A5E5FF;
        g_theme.syn_func      = 0x1E66F5FF;
        g_theme.syn_tag       = 0xEA76CBFF;
