package odit.theme

// =============================================================================
// Onyx Editor ("odit") — Theme Presets, Crisp Fonts & Safe Raylib Text Helpers
// =============================================================================

use core { memory, alloc }
use raylib
use odit.abi

Theme :: struct {
    name:          str;
    font_mono:     raylib.Font;
    font_loaded:   bool;
    colors:        [16] u32;

    // Syntax highlighting colors (0xRRGGBBAA)
    syn_default:   u32;
    syn_keyword:   u32;
    syn_directive: u32;
    syn_type:      u32;
    syn_string:    u32;
    syn_number:    u32;
    syn_comment:   u32;
    syn_operator:  u32;
    syn_func:      u32;
    syn_tag:       u32;
}

g_theme: Theme;

rgba_to_rl :: (c: u32) -> raylib.Color {
    return .{
        r = cast(u8) ((c >> 24) & 0xFF),
        g = cast(u8) ((c >> 16) & 0xFF),
        b = cast(u8) ((c >> 8)  & 0xFF),
        a = cast(u8) (c & 0xFF),
    };
}

theme_apply_preset :: (preset_name: str) {
    if str.equal(preset_name, "tokyo_night") {
        g_theme.name = "tokyo_night";
        g_theme.colors[cast(u32) abi.ThemeColor.BgBase]        = 0x1A1B26FF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgPanel]       = 0x16161EFF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgHeader]      = 0x1F2335FF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgSurface]     = 0x24283BFF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgHover]       = 0x292E42FF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgSelection]   = 0x364A82FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Border]        = 0x292E42FF;
        g_theme.colors[cast(u32) abi.ThemeColor.BorderFocused] = 0x7AA2F7FF;
        g_theme.colors[cast(u32) abi.ThemeColor.TextPrimary]   = 0xC0CAF5FF;
        g_theme.colors[cast(u32) abi.ThemeColor.TextSecondary] = 0x9AA5CEFF;
        g_theme.colors[cast(u32) abi.ThemeColor.TextDisabled]  = 0x565F89FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Accent]        = 0xBB9AF7FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Success]       = 0x9ECE6AFF;
        g_theme.colors[cast(u32) abi.ThemeColor.Warning]       = 0xE0AF68FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Error]         = 0xF7768EFF;
        g_theme.colors[cast(u32) abi.ThemeColor.Info]          = 0x7DCFFFFF;

        g_theme.syn_default   = 0xC0CAF5FF;
        g_theme.syn_keyword   = 0xBB9AF7FF;
        g_theme.syn_directive = 0xFF9E64FF;
        g_theme.syn_type      = 0x2AC3DEFF;
        g_theme.syn_string    = 0x9ECE6AFF;
        g_theme.syn_number    = 0xFF9E64FF;
        g_theme.syn_comment   = 0x565F89FF;
        g_theme.syn_operator  = 0x89DDFFFF;
        g_theme.syn_func      = 0x7AA2F7FF;
        g_theme.syn_tag       = 0xF7768EFF;
        return;
    }

    if str.equal(preset_name, "gruvbox") {
        g_theme.name = "gruvbox";
        g_theme.colors[cast(u32) abi.ThemeColor.BgBase]        = 0x1D2021FF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgPanel]       = 0x282828FF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgHeader]      = 0x32302FFF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgSurface]     = 0x3C3836FF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgHover]       = 0x504945FF;
        g_theme.colors[cast(u32) abi.ThemeColor.BgSelection]   = 0x665C54FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Border]        = 0x504945FF;
        g_theme.colors[cast(u32) abi.ThemeColor.BorderFocused] = 0xFABD2FFF;
        g_theme.colors[cast(u32) abi.ThemeColor.TextPrimary]   = 0xEBDBB2FF;
        g_theme.colors[cast(u32) abi.ThemeColor.TextSecondary] = 0xBDAE93FF;
        g_theme.colors[cast(u32) abi.ThemeColor.TextDisabled]  = 0x928374FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Accent]        = 0xFE8019FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Success]       = 0xB8BB26FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Warning]       = 0xFABD2FFF;
        g_theme.colors[cast(u32) abi.ThemeColor.Error]         = 0xFB4934FF;
        g_theme.colors[cast(u32) abi.ThemeColor.Info]          = 0x83A598FF;

        g_theme.syn_default   = 0xEBDBB2FF;
        g_theme.syn_keyword   = 0xFB4934FF;
        g_theme.syn_directive = 0xFE8019FF;
        g_theme.syn_type      = 0xFABD2FFF;
        g_theme.syn_string    = 0xB8BB26FF;
        g_theme.syn_number    = 0xD3869BFF;
        g_theme.syn_comment   = 0x928374FF;
        g_theme.syn_operator  = 0x8EC07CFF;
        g_theme.syn_func      = 0x83A598FF;
