@test.tag.{"services"}
@test.it.{"Workspace indexer discovers Onyx source files"}
(t: &test.T) {
    files := services.workspace_find_files(".", ".onyx", context.temp_allocator);
    t->expect_true(files.count >= 10);
}

@test.tag.{"services"}
@test.it.{"Docs index returns results for core procs and #directives"}
(t: &test.T) {
    fmt_js := services.docs_search_as_json("format", context.temp_allocator);
    t->expect_true(fmt_js.count > 20);
