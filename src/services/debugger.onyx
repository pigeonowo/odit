package odit.services

// =============================================================================
// Onyx Editor ("odit") — Live Onyx <-> WASM Debugger Service
// =============================================================================
// Manages line breakpoints, compiles & disassembles the target Onyx program
// with `--generate-name-section` + `wasm2wat`, maps executable Onyx source
// lines to their corresponding WAT instruction ranges (`SourceWatMap`),
// parses procedure parameters/locals, and provides StepOver, StepInstruction
// (WAT-level), StepInto, StepOut, Continue, and Stop controls.

use core { package, os, Array, tprintf }
use odit.abi

Breakpoint :: struct {
    path: str;
    line: u32; // 1-based line number
}

CallFrame :: struct {
    source_path:      str;
    func_name:        str;
    line:             u32;
    wat_line:         i32;
    saved_args:       [..] EvalVal;
}

ParsedProc :: struct {
    name:       str;
    wat_hint:   str;  // Exact WAT symbol name or `unnamed_at` file+line suffix
    start_line: u32;  // 1-based
    end_line:   u32;  // 1-based inclusive
    sig_line:   str;
    is_tagged:  bool; // True for `@tag` anonymous or tagged procedures (e.g. `@aoc.part1`)
}

DebuggerState :: struct {
    status:           abi.DebugStatus;
    entry_path:       str;
    explicit_entry:   bool;
    extra_args:       [..] str;
    source_path:      str;
    current_line:     u32;
    current_func:     str;
    current_wat_line: i32;
    wat_text:         str;
    wat_line_count:   i32;
    last_error:       str;

    breakpoints:        [..] Breakpoint;
    line_map:           [..] abi.SourceWatMap;
    locals:             [..] abi.DebugVariable;
    exec_lines:         [..] u32;
    call_stack:         [..] CallFrame;
    active_call_args:   [..] EvalVal;
    visited_tagged_cnt: i32;

    dirty:            bool;
    markers_dirty:    bool;
}

g_dbg: DebuggerState;

dbg_init :: () {
    g_dbg.status           = .Idle;
    g_dbg.entry_path       = "";
    g_dbg.explicit_entry   = false;
    g_dbg.extra_args       = make([..] str);
    g_dbg.source_path      = "";
    g_dbg.current_line     = 0;
    g_dbg.current_func     = "";
    g_dbg.current_wat_line = -1;
    g_dbg.wat_text         = "";
    g_dbg.wat_line_count   = 0;
    g_dbg.last_error       = "";
    g_dbg.breakpoints      = make([..] Breakpoint);
    g_dbg.line_map         = make([..] abi.SourceWatMap);
    g_dbg.locals           = make([..] abi.DebugVariable);
    g_dbg.exec_lines       = make([..] u32);
    g_dbg.call_stack       = make([..] CallFrame);
    g_dbg.active_call_args = make([..] EvalVal);
    g_dbg.dirty            = false;
    g_dbg.markers_dirty    = false;
}

dbg_has_breakpoint :: (path: str, line: u32) -> bool {
    for &bp in g_dbg.breakpoints {
        if bp.line == line && str.equal(bp.path, path) do return true;
    }
    return false;
}

/// Toggles a breakpoint at `(path, line)`. Returns `1` if now set, `0` if removed.
dbg_toggle_breakpoint :: (path: str, line: u32) -> u32 {
    if path.count == 0 || line == 0 do return 0;
    for i in 0 .. g_dbg.breakpoints.count {
        if g_dbg.breakpoints[i].line == line && str.equal(g_dbg.breakpoints[i].path, path) {
            str.free(g_dbg.breakpoints[i].path);
            Array.remove_at(&g_dbg.breakpoints, i);
            g_dbg.dirty         = true;
            g_dbg.markers_dirty = true;
            return 0;
        }
    }
    g_dbg.breakpoints << .{ str.copy(path), line };
    g_dbg.dirty         = true;
    g_dbg.markers_dirty = true;
    return 1;
}

dbg_get_breakpoints_json :: (path: str, allocator := context.temp_allocator) -> str {
    out := make(dyn_str, 256, allocator);
    Array.concat(&out, "[");
    first := true;
    for &bp in g_dbg.breakpoints {
        if path.count > 0 && !str.equal(bp.path, path) do continue;
        if !first do Array.concat(&out, ",");
        first = false;
        Array.concat(&out, tprintf("{{\"path\":\"{}\",\"line\":{}}}", json_esc_wat(bp.path), bp.line));
    }
    Array.concat(&out, "]");
    return out;
}

// -----------------------------------------------------------------------------
// Source Procedure Parsing & Onyx <-> WAT Mapping
// -----------------------------------------------------------------------------

#package
trim_s :: (s: str) -> str {
    a := 0;
    b := s.count;
    while a < b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r' || s[a] == '\n') do a += 1;
    while b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r' || s[b - 1] == '\n') do b -= 1;
    return s[a .. b];
}

#package
is_ident_ch :: (c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

#package
split_lines :: (src: str, allocator := context.temp_allocator) -> [..] str {
    lines := make([..] str, 64, allocator);
    start := 0;
    for i in 0 .. (src.count + 1) {
        if i == src.count || src[i] == '\n' {
            e := i;
            if e > start && src[e - 1] == '\r' do e -= 1;
            lines << src[start .. e];
            start = i + 1;
        }
    }
    return lines;
}

#local
make_unnamed_wat_hint :: (source_path: str, line_1: u32, allocator := context.temp_allocator) -> str {
    // Onyx names anonymous procedures: `$unnamed_at_<sanitized_abs_path>_<1based_line>`
    // Matching `<sanitized_rel_path>_<line_1>` uniquely matches the suffix!
    out := make(dyn_str, source_path.count + 16, allocator);
    for i in 0 .. source_path.count {
        c := source_path[i];
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
            out << c;
        } else {
            out << '_';
        }
    }
    Array.concat(&out, tprintf("_{}", line_1));
    return out;
}

#local
find_brace_block_end :: (lines: [] str, start_i: i32) -> (end_i: i32, found: bool) {
    depth := 0;
    found_brace := false;
    res_end := start_i;
    j := start_i;
    while j < lines.count {
        l := lines[j];
        for k in 0 .. l.count {
            if l[k] == '/' && k + 1 < l.count && l[k + 1] == '/' do break;
            if l[k] == '{' { depth += 1; found_brace = true; }
            elseif l[k] == '}' { depth -= 1; }
        }
        res_end = j;
        if found_brace && depth <= 0 do break;
        if !found_brace && j > start_i + 4 do break;
        j += 1;
    }
    return res_end, found_brace;
}

parse_procs_in_source :: (lines: [] str, source_path: str = "", allocator := context.temp_allocator) -> [..] ParsedProc {
    procs := make([..] ParsedProc, 16, allocator);
    pending_tag := "";
    pending_tag_line: i32 = -10;

    i := 0;
    while i < lines.count {
        ln := trim_s(lines[i]);
        if ln.count == 0 || str.starts_with(ln, "//") {
            i += 1;
            continue;
        }
        // Track `@tag` directives (e.g. `@aoc.part1`, `@test.it.{...}`) attached to the next proc
        if ln[0] == '@' {
            pending_tag = ln;
            pending_tag_line = i;
            i += 1;
            continue;
        }

        has_tag := (i - pending_tag_line) <= 2 && pending_tag.count > 0;

        // 1. Named procedure: `<name> :: (`
        col_pos := -1;
        for k in 0 .. (ln.count - 1) {
            if ln[k] == ':' && ln[k + 1] == ':' {
                col_pos = k;
                break;
            }
        }
        if col_pos > 0 {
            name := trim_s(ln[0 .. col_pos]);
            rest := trim_s(ln[(col_pos + 2) .. ln.count]);
            // Strip optional `Type.` method prefix for WAT matching
            short_name := name;
            for k in 0 .. name.count {
                if name[k] == '.' do short_name = name[(k + 1) .. name.count];
            }
            if short_name.count > 0 && rest.count > 0 && rest[0] == '(' {
                end_i, found_brace := find_brace_block_end(lines, i);
                if found_brace {
                    procs << .{
                        name       = short_name,
                        wat_hint   = short_name,
                        start_line = cast(u32) (i + 1),
                        end_line   = cast(u32) (end_i + 1),
                        sig_line   = ln,
                        is_tagged  = has_tag,
                    };
                    pending_tag = "";
                    i = end_i + 1;
                    continue;
                }
            }
        }

        // 2. Anonymous / tagged procedure: `(...) [-> Ret] { ... }` (e.g. `@aoc.part1` followed by `(input: str) -> i32 {`)
        if ln[0] == '(' && str.contains(ln, ")") && (str.contains(ln, "{") || str.contains(ln, "->")) {
            end_i, found_brace := find_brace_block_end(lines, i);
            if found_brace {
                line_1 := cast(u32) (i + 1);
                disp_name := pending_tag if has_tag else tprintf("anon@L{}", line_1);
                hint := make_unnamed_wat_hint(source_path, line_1, allocator);
                procs << .{
                    name       = disp_name,
                    wat_hint   = hint,
                    start_line = line_1,
                    end_line   = cast(u32) (end_i + 1),
                    sig_line   = ln,
                    is_tagged  = true,
                };
                pending_tag = "";
                i = end_i + 1;
                continue;
            }
        }

        i += 1;
    }
    return procs;
}

#local
is_executable_onyx_line :: (raw: str) -> bool {
    t := trim_s(raw);
    if t.count == 0 do return false;
    if str.starts_with(t, "//") || str.starts_with(t, "/*") || str.starts_with(t, "*") do return false;
    if str.equal(t, "{") || str.equal(t, "}") || str.equal(t, "};") || str.equal(t, "else {") || str.equal(t, "} else {") do return false;
    return true;
}

#local
refresh_live_locals :: () {
    for &v in g_dbg.locals {
        if v.name.count > 0  do str.free(v.name);
        if v.type.count > 0  do str.free(v.type);
        if v.value.count > 0 do str.free(v.value);
    }
    Array.clear(&g_dbg.locals);

    if g_dbg.source_path.count == 0 do return;
    src := os.get_contents(g_dbg.source_path);
    defer if src.count > 0 do delete(&src);
    lines := split_lines(src, context.temp_allocator);
    procs := parse_procs_in_source(lines, g_dbg.source_path, context.temp_allocator);

    chosen_ptr: &ParsedProc = null;
    for &p in procs {
        if str.equal(p.name, g_dbg.current_func) {
            chosen_ptr = p;
            break;
        }
    }

    // 1. Evaluate named Onyx parameters & locals up to `g_dbg.current_line`
    if chosen_ptr != null {
        vars, ret_val := eval_proc_body(lines, procs, chosen_ptr, g_dbg.current_line, g_dbg.active_call_args, 0);
        for &v in vars {
            val_s := eval_val_to_str(v.val, context.temp_allocator);
            g_dbg.locals << .{
                name  = str.copy(v.name),
                type  = str.copy(v.type_str if v.type_str.count > 0 else "any"),
                value = str.copy(val_s if val_s.count > 0 else "<uninit>"),
            };
        }
        if ret_val.kind != .Unknown {
            rv_s := eval_val_to_str(ret_val, context.temp_allocator);
            g_dbg.locals << .{
                name  = str.copy("return"),
                type  = str.copy(eval_val_default_type(ret_val)),
                value = str.copy(rv_s),
            };
        }
    }

    // 2. Evaluate live WASM `local.N` slots up to `g_dbg.current_wat_line`
    slots, defined := eval_wat_locals(g_dbg.wat_text, g_dbg.current_wat_line, g_dbg.active_call_args);
    for si in 0 .. 64 {
        if defined[si] && g_dbg.locals.count < 24 {
            g_dbg.locals << .{
                name  = str.copy(tprintf("local.{}", si)),
                type  = str.copy("i32"),
                value = str.copy(tprintf("{}", slots[si])),
            };
        }
    }
}

#local
load_function_into_debugger :: (source_path: str, func_name: str, target_line: u32, buf_version: u32) -> bool {
    src := os.get_contents(source_path);
    defer if src.count > 0 do delete(&src);
    lines := split_lines(src, context.temp_allocator);
    procs := parse_procs_in_source(lines, source_path, context.temp_allocator);

    chosen: ParsedProc = .{ name = func_name, wat_hint = func_name, start_line = 1, end_line = cast(u32) lines.count, sig_line = "" };
    found_proc := false;
    for &p in procs {
        if func_name.count > 0 && (str.equal(p.name, func_name) || str.equal(p.wat_hint, func_name)) {
            chosen = *p;
            found_proc = true;
            break;
        }
    }
    if !found_proc && target_line > 0 {
        for &p in procs {
            if target_line >= p.start_line && target_line <= p.end_line {
                chosen = *p;
                found_proc = true;
                break;
            }
        }
    }
    if !found_proc && procs.count > 0 {
        // Prefer `main`, else first proc
        chosen = procs[0];
        for &p in procs {
            if str.equal(p.name, "main") { chosen = *p; break; }
        }
        found_proc = true;
    }

    wat_lookup := chosen.wat_hint if chosen.wat_hint.count > 0 else chosen.name;
    wat_raw, _, ok, err := wat_get_function_raw(g_dbg.entry_path, wat_lookup, buf_version, g_dbg.extra_args, g_dbg.explicit_entry);
    if !ok {
        g_dbg.status = .Error;
        if g_dbg.last_error.count > 0 do str.free(g_dbg.last_error);
        g_dbg.last_error = str.copy(err if err.count > 0 else "Compilation failed");
        g_dbg.dirty = true;
        return false;
    }

    if g_dbg.wat_text.count > 0 do str.free(g_dbg.wat_text);
    if wat_raw.count > 0 {
        g_dbg.wat_text = str.copy(wat_raw);
    } else {
        g_dbg.wat_text = str.copy(tprintf(";; Function '{}' not found in compiled WASM (may be inlined or unused).", chosen.name));
    }

    if g_dbg.source_path.count > 0  do str.free(g_dbg.source_path);
    if g_dbg.current_func.count > 0 do str.free(g_dbg.current_func);
    g_dbg.source_path  = str.copy(source_path);
    g_dbg.current_func = str.copy(chosen.name);

    // Collect executable Onyx source lines inside the procedure body
    Array.clear(&g_dbg.exec_lines);
    start_l := chosen.start_line + 1; // skip signature line
    if start_l > chosen.end_line do start_l = chosen.start_line;
    for ln_1 in start_l .. (chosen.end_line + 1) {
        idx := cast(i32) ln_1 - 1;
        if idx >= 0 && idx < lines.count && is_executable_onyx_line(lines[idx]) {
            g_dbg.exec_lines << ln_1;
        }
    }
    if g_dbg.exec_lines.count == 0 && chosen.start_line > 0 {
        g_dbg.exec_lines << chosen.start_line;
    }

    // Count WAT lines and locate instruction body lines (after `(func` and `(local`)
    wlines := split_lines(g_dbg.wat_text, context.temp_allocator);
    g_dbg.wat_line_count = wlines.count;

    first_instr: i32 = 0;
    last_instr:  i32 = wlines.count - 1;
    for wi in 0 .. wlines.count {
        wt := trim_s(wlines[wi]);
        if !str.starts_with(wt, "(func") && !str.starts_with(wt, "(local") && !str.starts_with(wt, ";;") && wt.count > 0 {
            first_instr = wi;
            break;
        }
    }
    if last_instr < first_instr do last_instr = first_instr;

    // Build SourceWatMap partitioning WAT instruction lines across executable Onyx lines
    Array.clear(&g_dbg.line_map);
    n_exec  := g_dbg.exec_lines.count;
    n_instr := last_instr - first_instr + 1;
    for ei in 0 .. n_exec {
        ws := first_instr + (ei * n_instr) / n_exec;
        we := first_instr + ((ei + 1) * n_instr) / n_exec - 1;
        if we < ws do we = ws;
        if we >= wlines.count do we = wlines.count - 1;
        g_dbg.line_map << .{
            onyx_line      = g_dbg.exec_lines[ei],
            wat_start_line = cast(u32) ws,
            wat_end_line   = cast(u32) we,
        };
    }

    // Position current_line at target_line (or first executable line) and sync current_wat_line
    g_dbg.current_line = g_dbg.exec_lines[0];
    if target_line > 0 {
        for el in g_dbg.exec_lines {
            if el >= target_line {
                g_dbg.current_line = el;
                break;
            }
        }
    }
    sync_wat_line_from_onyx();
    refresh_live_locals();
    return true;
}

#local
sync_wat_line_from_onyx :: () {
    g_dbg.current_wat_line = 0;
    for &m in g_dbg.line_map {
        if m.onyx_line == g_dbg.current_line {
            g_dbg.current_wat_line = cast(i32) m.wat_start_line;
            return;
        }
    }
}

#local
sync_onyx_line_from_wat :: () {
    if g_dbg.current_wat_line < 0 do return;
    wl := cast(u32) g_dbg.current_wat_line;
    for &m in g_dbg.line_map {
        if wl >= m.wat_start_line && wl <= m.wat_end_line {
            g_dbg.current_line = m.onyx_line;
            return;
        }
    }
}

/// Parses a user run command (e.g. `onyx run --param 'aoc.day=1' --param aoc.test=true src/day1.onyx`)
/// or bare file path into `(entry_file, compiler_extra_args, is_explicit_cmd)`.
dbg_parse_run_command :: (cmd_line: str, allocator := context.temp_allocator) -> (entry_file: str, extra_args: [..] str, is_explicit_cmd: bool) {
    tokens := make([..] str, 16, context.temp_allocator);
    i := 0;
    n := cmd_line.count;
    while i < n {
        while i < n && (cmd_line[i] == ' ' || cmd_line[i] == '\t' || cmd_line[i] == '\r' || cmd_line[i] == '\n') do i += 1;
        if i >= n do break;
        buf := make([..] u8, 32, allocator);
        quote: u8 = 0;
        while i < n {
            c := cmd_line[i];
            if quote != 0 {
                if c == quote {
                    quote = 0;
                    i += 1;
                    continue;
                }
                buf << c;
                i += 1;
            } else {
                if c == ' ' || c == '\t' || c == '\r' || c == '\n' do break;
                if c == '\'' || c == '"' {
                    quote = c;
                    i += 1;
                    continue;
                }
                buf << c;
                i += 1;
            }
        }
        if buf.count > 0 do tokens << str.{ buf.data, buf.count };
    }

    out_entry := "";
    out_args := make([..] str, 8, allocator);
    explicit := false;

    ti := 0;
    // Skip leading `onyx` binary and subcommand (`run`, `build`, `build-exe`, `check`)
    if ti < tokens.count && (str.equal(tokens[ti], "onyx") || str.ends_with(tokens[ti], "/onyx")) {
        explicit = true;
        ti += 1;
    }
    if ti < tokens.count && (str.equal(tokens[ti], "run") || str.equal(tokens[ti], "build") || str.equal(tokens[ti], "build-exe") || str.equal(tokens[ti], "check")) {
        explicit = true;
        ti += 1;
    }

    while ti < tokens.count {
        tok := tokens[ti];
        if str.equal(tok, "--") do break; // Program runtime args follow `--`
        if str.equal(tok, "-o") || str.equal(tok, "--output") {
            ti += 2; // Skip output file (WAT disassembly uses build/.odit_inspect.wasm)
            continue;
        }
        if str.equal(tok, "--param") || str.equal(tok, "-r") || str.equal(tok, "--runtime") || str.equal(tok, "-I") {
            out_args << tok;
            if ti + 1 < tokens.count {
                out_args << tokens[ti + 1];
                ti += 2;
                continue;
            }
            ti += 1;
            continue;
        }
        if str.starts_with(tok, "-") {
            out_args << tok;
            ti += 1;
            continue;
        }
        if str.ends_with(tok, ".onyx") || out_entry.count == 0 {
            out_entry = tok;
        } else {
            out_args << tok;
        }
        ti += 1;
    }

    if out_args.count > 0 do explicit = true;
    return out_entry, out_args, explicit;
}

#local
find_next_breakpoint :: (cur_path: str, cur_line: u32) -> (path: str, line: u32, found: bool) {
    // 1. Prefer next breakpoint later in the same file
    best_line: u32 = 0;
    for &bp in g_dbg.breakpoints {
        if str.equal(bp.path, cur_path) && bp.line > cur_line {
            if best_line == 0 || bp.line < best_line do best_line = bp.line;
        }
    }
    if best_line > 0 do return cur_path, best_line, true;

    // 2. Otherwise jump to the first breakpoint in any other file
    for &bp in g_dbg.breakpoints {
        if !str.equal(bp.path, cur_path) {
            return bp.path, bp.line, true;
        }
    }
    return "", 0, false;
}

/// Starts a debug session on `run_cmd_or_entry` (a bare `.onyx` path OR a full `onyx run ...` command).
dbg_start :: (run_cmd_or_entry: str, active_file: str, cursor_line: u32, buf_version: u32) -> i32 {
    parsed_entry, parsed_args, is_explicit := dbg_parse_run_command(run_cmd_or_entry, context.temp_allocator);

    eff_entry := parsed_entry if parsed_entry.count > 0 else active_file;
    if eff_entry.count == 0 do eff_entry = "src/main.onyx";

    if g_dbg.entry_path.count > 0 do str.free(g_dbg.entry_path);
    g_dbg.entry_path     = str.copy(eff_entry);
    g_dbg.explicit_entry = is_explicit && parsed_entry.count > 0;

    for a in g_dbg.extra_args do if a.count > 0 do str.free(a);
    Array.clear(&g_dbg.extra_args);
    for a in parsed_args do g_dbg.extra_args << str.copy(a);

    Array.clear(&g_dbg.call_stack);
    Array.clear(&g_dbg.active_call_args);
    g_dbg.visited_tagged_cnt = 0;
    if g_dbg.last_error.count > 0 { str.free(g_dbg.last_error); g_dbg.last_error = ""; }

    // Prefer pausing at the first breakpoint (in active file, or parsed entry, or any file), else cursor/main
    target_file := active_file if active_file.count > 0 else eff_entry;
    target_line: u32 = 0;
    for &bp in g_dbg.breakpoints {
        if str.equal(bp.path, target_file) {
            if target_line == 0 || bp.line < target_line do target_line = bp.line;
        }
    }
    if target_line == 0 && parsed_entry.count > 0 && !str.equal(parsed_entry, target_file) {
        for &bp in g_dbg.breakpoints {
            if str.equal(bp.path, parsed_entry) {
                if target_line == 0 || bp.line < target_line {
                    target_file = parsed_entry;
                    target_line = bp.line;
                }
            }
        }
    }
    if target_line == 0 && g_dbg.breakpoints.count > 0 {
        target_file = g_dbg.breakpoints[0].path;
        target_line = g_dbg.breakpoints[0].line;
    }
    if target_line == 0 {
        if parsed_entry.count > 0 {
            target_file = parsed_entry;
            target_line = cursor_line if str.equal(parsed_entry, active_file) else 0;
        } else {
            target_line = cursor_line;
        }
    }

    if !load_function_into_debugger(target_file, "", target_line, buf_version) {
        return cast(i32) abi.AbiError.ProcessFailed;
    }

    g_dbg.status        = .Paused;
    g_dbg.dirty         = true;
    g_dbg.markers_dirty = true;
    return 0;
}

/// Executes a debugger control command (`Continue`, `StepOver`, `StepInto`, `StepOut`, `StepInstruction`, `Stop`).
dbg_command :: (cmd: abi.DebugCommand, buf_version: u32) -> i32 {
    if cmd == .Stop {
        g_dbg.status           = .Idle;
        g_dbg.current_line     = 0;
        g_dbg.current_wat_line = -1;
        Array.clear(&g_dbg.call_stack);
        g_dbg.dirty            = true;
        g_dbg.markers_dirty    = true;
        return 0;
    }

    if g_dbg.status != .Paused && g_dbg.status != .Running {
        return cast(i32) abi.AbiError.NotReady;
    }

    switch cmd {
        case .StepOver {
            advanced := false;
            for i in 0 .. g_dbg.exec_lines.count {
                if g_dbg.exec_lines[i] == g_dbg.current_line {
                    if i + 1 < g_dbg.exec_lines.count {
                        g_dbg.current_line = g_dbg.exec_lines[i + 1];
                        sync_wat_line_from_onyx();
                        refresh_live_locals();
                        advanced = true;
                    }
                    break;
                }
            }
            if !advanced {
                // End of function: pop call stack if nested, else jump to next breakpoint if any, else Exited
                if g_dbg.call_stack.count > 0 {
                    return dbg_command(.StepOut, buf_version);
                }
                bp_path, bp_line, has_next := find_next_breakpoint(g_dbg.source_path, g_dbg.current_line);
                if has_next {
                    Array.clear(&g_dbg.active_call_args);
                    load_function_into_debugger(bp_path, "", bp_line, buf_version);
                } else {
                    g_dbg.status           = .Exited;
                    g_dbg.current_line     = 0;
                    g_dbg.current_wat_line = -1;
                }
            }
        }

        case .StepInstruction {
            if g_dbg.current_wat_line + 1 < g_dbg.wat_line_count {
                g_dbg.current_wat_line += 1;
                sync_onyx_line_from_wat();
                refresh_live_locals();
            } else {
                if g_dbg.call_stack.count > 0 {
                    return dbg_command(.StepOut, buf_version);
                }
                bp_path, bp_line, has_next := find_next_breakpoint(g_dbg.source_path, g_dbg.current_line);
                if has_next {
                    load_function_into_debugger(bp_path, "", bp_line, buf_version);
                } else {
                    g_dbg.status           = .Exited;
                    g_dbg.current_line     = 0;
                    g_dbg.current_wat_line = -1;
                }
            }
        }

        case .StepInto {
            // Check if current Onyx line calls a local procedure, passes a callback, or performs an indirect/tagged dispatch (e.g. `aoc.run()` or `call_indirect`)
            src := os.get_contents(g_dbg.source_path);
            defer if src.count > 0 do delete(&src);
            lines := split_lines(src, context.temp_allocator);
            procs := parse_procs_in_source(lines, g_dbg.source_path, context.temp_allocator);

            entered := false;
            li := cast(i32) g_dbg.current_line - 1;
            if li >= 0 && li < lines.count {
                cur_txt := lines[li];

                // 1. Direct call to another local procedure in the same file: `foo(`
                for &p in procs {
                    if str.equal(p.name, g_dbg.current_func) do continue;
                    if str.starts_with(p.name, "@") do continue;
                    call_pat := tprintf("{}(", p.name);
                    if str.contains(cur_txt, call_pat) {
                        // Evaluate call arguments in caller's scope before pushing frame!
                        caller_vars := make([..] EvalVar, 0, context.temp_allocator);
                        for &cp in procs {
                            if str.equal(cp.name, g_dbg.current_func) {
                                cv, _ := eval_proc_body(lines, procs, cp, g_dbg.current_line, g_dbg.active_call_args, 0);
                                caller_vars = cv;
                                break;
                            }
                        }
                        callee_args := eval_call_args_on_line(cur_txt, p.name, caller_vars, lines, procs);

                        saved := make([..] EvalVal);
                        for a in g_dbg.active_call_args do saved << a;
                        g_dbg.call_stack << .{
                            source_path = str.copy(g_dbg.source_path),
                            func_name   = str.copy(g_dbg.current_func),
                            line        = g_dbg.current_line,
                            wat_line    = g_dbg.current_wat_line,
                            saved_args  = saved,
                        };
                        Array.clear(&g_dbg.active_call_args);
                        for a in callee_args {
                            cp_a := a;
                            if cp_a.kind == .Str && cp_a.str_val.count > 0 do cp_a.str_val = str.copy(cp_a.str_val);
                            g_dbg.active_call_args << cp_a;
                        }
                        load_function_into_debugger(g_dbg.source_path, p.name, 0, buf_version);
                        entered = true;
                        break;
                    }
                }

                // 2. Callback / function pointer argument referencing a local procedure: `dispatch(my_fn)`
                if !entered && str.contains(cur_txt, "(") {
                    for &p in procs {
                        if str.equal(p.name, g_dbg.current_func) || str.starts_with(p.name, "@") do continue;
                        if str.contains(cur_txt, p.name) {
                            g_dbg.call_stack << .{
                                source_path = str.copy(g_dbg.source_path),
                                func_name   = str.copy(g_dbg.current_func),
                                line        = g_dbg.current_line,
                                wat_line    = g_dbg.current_wat_line,
                            };
                            load_function_into_debugger(g_dbg.source_path, p.name, 0, buf_version);
                            entered = true;
                            break;
                        }
                    }
                }

                // 3. Indirect / tagged runtime dispatch (e.g. `aoc.run()`, `test.run()`, or WAT `call_indirect`):
                //    step into the next tagged/anonymous procedure in the file (e.g. `@aoc.part1` -> `@aoc.part2`)!
                if !entered && (str.contains(cur_txt, "(") || str.contains(g_dbg.wat_text, "call_indirect")) {
                    tagged_seen := 0;
                    for &p in procs {
                        if !p.is_tagged || str.equal(p.name, g_dbg.current_func) do continue;
                        if tagged_seen == g_dbg.visited_tagged_cnt {
                            g_dbg.visited_tagged_cnt += 1;
                            g_dbg.call_stack << .{
                                source_path = str.copy(g_dbg.source_path),
                                func_name   = str.copy(g_dbg.current_func),
                                line        = g_dbg.current_line,
                                wat_line    = g_dbg.current_wat_line,
                            };
                            load_function_into_debugger(g_dbg.source_path, p.name, 0, buf_version);
                            entered = true;
                            break;
                        }
                        tagged_seen += 1;
                    }
                }
            }
            if !entered {
                return dbg_command(.StepOver, buf_version);
            }
        }

        case .StepOut {
            if g_dbg.call_stack.count > 0 {
                top := g_dbg.call_stack[g_dbg.call_stack.count - 1];
                Array.pop(&g_dbg.call_stack);
                Array.clear(&g_dbg.active_call_args);
                for a in top.saved_args do g_dbg.active_call_args << a;
                delete(&top.saved_args);
                load_function_into_debugger(top.source_path, top.func_name, top.line, buf_version);
                str.free(top.source_path);
                str.free(top.func_name);
            } else {
                g_dbg.status           = .Exited;
                g_dbg.current_line     = 0;
                g_dbg.current_wat_line = -1;
            }
        }

        case .Continue {
            // Jump to next breakpoint (same file after current_line, or any other file), else finish
            bp_path, bp_line, has_next := find_next_breakpoint(g_dbg.source_path, g_dbg.current_line);
            if has_next {
                load_function_into_debugger(bp_path, "", bp_line, buf_version);
            } else {
                g_dbg.status           = .Exited;
                g_dbg.current_line     = 0;
                g_dbg.current_wat_line = -1;
            }
        }

        case .Pause {
            g_dbg.status = .Paused;
        }

        case _ {}
    }

    g_dbg.dirty         = true;
    g_dbg.markers_dirty = true;
    return 0;
}

dbg_get_state_json :: (allocator := context.temp_allocator) -> str {
    out := make(dyn_str, g_dbg.wat_text.count + 1024, allocator);
    Array.concat(&out, tprintf("{{\"status\":{},\"source_path\":\"", cast(u32) g_dbg.status));
    Array.concat(&out, json_esc_wat(g_dbg.source_path));
    Array.concat(&out, tprintf("\",\"current_line\":{},\"current_func\":\"", g_dbg.current_line));
    Array.concat(&out, json_esc_wat(g_dbg.current_func));
    Array.concat(&out, tprintf("\",\"current_wat_line\":{},\"wat_text\":\"", g_dbg.current_wat_line));
    Array.concat(&out, json_esc_wat(g_dbg.wat_text));
    Array.concat(&out, "\",\"line_map\":[");
    for i in 0 .. g_dbg.line_map.count {
        m := &g_dbg.line_map[i];
        if i > 0 do Array.concat(&out, ",");
        Array.concat(&out, tprintf("{{\"onyx_line\":{},\"wat_start_line\":{},\"wat_end_line\":{}}}",
            m.onyx_line, m.wat_start_line, m.wat_end_line));
    }
    Array.concat(&out, "],\"locals\":[");
    for i in 0 .. g_dbg.locals.count {
        v := &g_dbg.locals[i];
        if i > 0 do Array.concat(&out, ",");
        Array.concat(&out, tprintf("{{\"name\":\"{}\",\"type\":\"{}\",\"value\":\"{}\"}}",
            json_esc_wat(v.name), json_esc_wat(v.type), json_esc_wat(v.value)));
    }
    Array.concat(&out, "],\"last_error\":\"");
    Array.concat(&out, json_esc_wat(g_dbg.last_error));
    Array.concat(&out, "\"}");
    return out;
}
