package odit.editor

// =============================================================================
// Onyx Editor ("odit") — Code Editor View (Syntax Highlighting + Modal & Ctrl)
// =============================================================================

use core { package, math }
use raylib
use odit.theme
use odit.settings
use odit.abi
use odit.wm
use odit.lsp

EditMode :: enum {
    Normal;
    Insert;
}

EditorView :: struct {
    buf:            TextBuffer;
    mode:           EditMode;
    modal_enabled:  bool; // Toggleable via Ctrl+P ("Editor: Toggle Modal Mode")
    scroll_y:       f32;
    scroll_x:       f32;
    font_size:      f32;
    line_height:    f32;
    char_width:     f32;
    gutter_width:   f32;
    blink_timer:    f32;
    pending_d:       bool; // For `dd` in Normal mode
    pending_g:       bool; // For `gg` / `gd` in Normal mode
    pending_y:       bool; // For `yy` in Normal mode
    mouse_selecting: bool; // Active left-mouse drag selection
    last_version:    u32;
    last_line:       i32;
    last_col:        i32;
}

EditorUpdateEvents :: struct {
    buffer_modified:        bool;
    buffer_saved:           bool;
    cursor_moved:           bool;
    req_hover:              bool;
    req_definition:         bool;
    req_completion:         bool;
    toggle_breakpoint_line: u32;
}

editor_sync_settings :: (ed: &EditorView) {
    ed.modal_enabled = settings.g_settings.modal_editing;
    ed.font_size     = settings.g_settings.editor_font_size;
    ed.line_height   = ed.font_size * settings.g_settings.line_height_factor;
    ed.char_width    = theme.measure_text("M", ed.font_size);
    if ed.char_width < 6.0f do ed.char_width = ed.font_size * 0.6f;
    if settings.g_settings.show_line_numbers {
        ed.gutter_width = 24.0f + ed.char_width * 4.2f;
    } else {
        ed.gutter_width = 22.0f;
    }
}

editor_init :: (ed: &EditorView) {
    buffer_init(&ed.buf);
    ed.mode         = .Normal;
    ed.scroll_y     = 0.0;
    ed.scroll_x     = 0.0;
    ed.blink_timer  = 0.0;
    ed.pending_d    = false;
    ed.last_version = ed.buf.version;
    ed.last_line    = 0;
    ed.last_col     = 0;
    editor_sync_settings(ed);
}

editor_mode_label :: (ed: &EditorView) -> str {
    if !ed.modal_enabled do return "INSERT";
    return "INSERT" if ed.mode == .Insert else "NORMAL";
}

editor_line_extra_h :: (ed: &EditorView, li: i32) -> f32 {
    if li < 0 || li >= ed.buf.lines.count do return 0.0f;
    ln := &ed.buf.lines[li];
    ls := str.{ ln.data, ln.count };
    url, ok := parse_inline_gif_url(ls);
    if !ok do return 0.0f;
    e := gif_cache_request(url);
    _, gh := gif_display_dims(e);
    return gh + 14.0f;
}

editor_line_top_y :: (ed: &EditorView, target_li: i32) -> f32 {
    y: f32 = 0.0f;
    lim := target_li if target_li <= ed.buf.lines.count else ed.buf.lines.count;
    for i in 0 .. lim {
        y += ed.line_height + editor_line_extra_h(ed, i);
    }
    return y;
}

editor_ensure_cursor_visible :: (ed: &EditorView, view_h: f32) {
    cy := editor_line_top_y(ed, ed.buf.cursor_line);
    margin := ed.line_height * 2.0;
    if cy < ed.scroll_y + margin {
        ed.scroll_y = cy - margin;
    }
    if cy + ed.line_height > ed.scroll_y + view_h - margin {
        ed.scroll_y = cy + ed.line_height - view_h + margin;
    }
    if ed.scroll_y < 0.0 do ed.scroll_y = 0.0;
}

editor_ensure_cursor_visible_x :: (ed: &EditorView, view_w: f32) {
    code_w := view_w - ed.gutter_width - 16.0f;
    if code_w < 40.0f do code_w = 40.0f;
    if ed.buf.cursor_line < 0 || ed.buf.cursor_line >= ed.buf.lines.count do return;

    ln := &ed.buf.lines[ed.buf.cursor_line];
    ls := str.{ ln.data, ln.count };
    col := ed.buf.cursor_col if ed.buf.cursor_col <= ls.count else ls.count;
    if col < 0 do col = 0;
    cx := theme.measure_text(ls[0 .. col], ed.font_size);

    pad_x := ed.char_width * 2.5f;
    if pad_x > code_w * 0.35f do pad_x = code_w * 0.35f;

    if cx < ed.scroll_x + pad_x {
        ed.scroll_x = cx - pad_x;
    }
    if cx > ed.scroll_x + code_w - pad_x {
        ed.scroll_x = cx - code_w + pad_x;
    }
    if ed.scroll_x < 0.0f do ed.scroll_x = 0.0f;
}

#local
key_trig :: (k: raylib.KeyboardKey) -> bool {
    return raylib.IsKeyPressed(k) || raylib.IsKeyPressedRepeat(k);
}

#local
clipboard_get_str :: (allocator := context.temp_allocator) -> str {
    cp := raylib.GetClipboardText();
    if cp.data == 0 do return "";
    n := core.cptr.extract_str(cp, .[]);
    if n == 0 do return "";
    buf := make([] u8, cast(i32) n, allocator);
    core.cptr.extract_str(cp, buf);
    return buf;
}

#local
clipboard_set_str :: (txt: str) {
    raylib.SetClipboardText(core.cptr.make(theme.to_temp_cstr(txt)));
}

#local
mouse_pos_to_line_col :: (ed: &EditorView, rect: wm.PaneRect, mpos: raylib.Vector2) -> (line: i32, col: i32) {
    rel_y := (mpos.y - rect.y) + ed.scroll_y - 6.0f;
    clicked_line: i32 = 0;
    if rel_y > 0.0f {
        acc_y: f32 = 0.0f;
        clicked_line = ed.buf.lines.count - 1;
        for li in 0 .. ed.buf.lines.count {
            row_total := ed.line_height + editor_line_extra_h(ed, li);
            if rel_y < acc_y + row_total {
                clicked_line = li;
                break;
            }
            acc_y += row_total;
        }
    }
    if clicked_line < 0 do clicked_line = 0;
    if clicked_line >= ed.buf.lines.count do clicked_line = ed.buf.lines.count - 1;

    rel_x := (mpos.x - (rect.x + ed.gutter_width + 8.0f)) + ed.scroll_x;
    clicked_col: i32 = 0;
    if clicked_line >= 0 && clicked_line < ed.buf.lines.count && rel_x > 0.0f {
        ln_b := &ed.buf.lines[clicked_line];
        ln_s := str.{ ln_b.data, ln_b.count };
        best_col: i32 = 0;
        best_dist: f32 = rel_x;
        for c in 1 .. (ln_s.count + 1) {
            px := theme.measure_text(ln_s[0 .. c], ed.font_size);
            d := px - rel_x;
            if d < 0.0f do d = -d;
            if d < best_dist {
                best_dist = d;
                best_col = c;
            }
            if px > rel_x + ed.char_width do break;
        }
        clicked_col = best_col;
    }
    return clicked_line, clicked_col;
}

editor_update :: (ed: &EditorView, rect: wm.PaneRect, focused: bool, dt: f32, block_input: bool, lsp_c: &lsp.LspClient = null) -> EditorUpdateEvents {
    ev: EditorUpdateEvents;
    ed.blink_timer += dt;
    gif_cache_update(dt);
    editor_sync_settings(ed);

    if block_input do return ev;

    mpos := raylib.GetMousePosition();
    hovered := wm.hit_rect(mpos.x, mpos.y, rect);

    // Mouse wheel scroll (Shift+Wheel scrolls horizontally for narrow panes)
    if hovered {
        wheel := raylib.GetMouseWheelMove();
        if wheel != 0.0 {
            shift := raylib.IsKeyDown(.LEFT_SHIFT) || raylib.IsKeyDown(.RIGHT_SHIFT);
            if shift {
                ed.scroll_x -= wheel * ed.char_width * 5.0f;
                if ed.scroll_x < 0.0f do ed.scroll_x = 0.0f;
            } else {
                ed.scroll_y -= wheel * ed.line_height * 3.0;
                total_h := editor_line_top_y(ed, ed.buf.lines.count);
                max_s := total_h - rect.h * 0.5;
                if max_s < 0.0 do max_s = 0.0;
                if ed.scroll_y < 0.0 do ed.scroll_y = 0.0;
                if ed.scroll_y > max_s do ed.scroll_y = max_s;
            }
        }
    }

    // Mouse click: toggle breakpoint if clicking in gutter, else place cursor & start drag selection
    if hovered && raylib.IsMouseButtonPressed(.LEFT) {
        if lsp_c != null {
            lsp_c.hover_visible = false;
            lsp_c.comp_open = false;
        }
        clicked_line, clicked_col := mouse_pos_to_line_col(ed, rect, mpos);
        if mpos.x < rect.x + ed.gutter_width {
            ev.toggle_breakpoint_line = cast(u32) (clicked_line + 1);
        } else {
            shift_click := raylib.IsKeyDown(.LEFT_SHIFT) || raylib.IsKeyDown(.RIGHT_SHIFT);
            if shift_click {
                buffer_start_selection(&ed.buf);
            } else {
                buffer_clear_selection(&ed.buf);
            }
            ed.buf.cursor_line = clicked_line;
            ed.buf.cursor_col  = clicked_col;
            buffer_clamp_cursor(&ed.buf);
            if !shift_click {
                ed.buf.sel_anchor_line = ed.buf.cursor_line;
                ed.buf.sel_anchor_col  = ed.buf.cursor_col;
                ed.buf.has_sel         = true;
            }
            ed.mouse_selecting = true;
            ed.blink_timer = 0.0;
        }
    }
    if ed.mouse_selecting {
        if raylib.IsMouseButtonDown(.LEFT) {
            dl, dc := mouse_pos_to_line_col(ed, rect, mpos);
            ed.buf.cursor_line = dl;
            ed.buf.cursor_col  = dc;
            buffer_clamp_cursor(&ed.buf);
        } else {
            ed.mouse_selecting = false;
            if ed.buf.sel_anchor_line == ed.buf.cursor_line && ed.buf.sel_anchor_col == ed.buf.cursor_col {
                buffer_clear_selection(&ed.buf);
            }
        }
    }

    if !focused do return ev;

    ctrl := raylib.IsKeyDown(.LEFT_CONTROL) || raylib.IsKeyDown(.RIGHT_CONTROL);

    // Handle active LSP completion menu navigation first
    if lsp_c != null && lsp_c.comp_open && lsp_c.completions.count > 0 {
        if raylib.IsKeyPressed(.ESCAPE) {
            lsp_c.comp_open = false;
            return ev;
        }
        if key_trig(.DOWN) {
            lsp_c.comp_selected = (lsp_c.comp_selected + 1) % lsp_c.completions.count;
            return ev;
        }
        if key_trig(.UP) {
            lsp_c.comp_selected = (lsp_c.comp_selected - 1 + lsp_c.completions.count) % lsp_c.completions.count;
            return ev;
        }
        if raylib.IsKeyPressed(.ENTER) || raylib.IsKeyPressed(.TAB) {
            item := &lsp_c.completions[lsp_c.comp_selected];
            apply_completion_insert(&ed.buf, item.insert_text);
            lsp_c.comp_open = false;
            ev.buffer_modified = true;
            ed.last_version = ed.buf.version;
            return ev;
        }
    }

    // Global editor shortcuts (work in BOTH Normal and Insert modes)
    if ctrl && raylib.IsKeyPressed(.S) {
        if buffer_save_file(&ed.buf) {
            ev.buffer_saved = true;
            ev.buffer_modified = true;
        }
        return ev;
    }
    if ctrl && raylib.IsKeyPressed(.Z) {
        if buffer_undo(&ed.buf) {
            ev.buffer_modified = true;
            editor_ensure_cursor_visible(ed, rect.h);
        }
        return ev;
    }
    if ctrl && raylib.IsKeyPressed(.A) {
        buffer_select_all(&ed.buf);
        return ev;
    }
    if ctrl && raylib.IsKeyPressed(.C) {
        txt := buffer_get_selected_text(&ed.buf, context.temp_allocator);
        clipboard_set_str(txt);
        return ev;
    }
    if ctrl && raylib.IsKeyPressed(.X) {
        txt := buffer_get_selected_text(&ed.buf, context.temp_allocator);
        clipboard_set_str(txt);
        if !buffer_delete_selection(&ed.buf) {
            buffer_delete_line(&ed.buf);
        }
        ev.buffer_modified = true;
        ed.last_version = ed.buf.version;
        editor_ensure_cursor_visible(ed, rect.h);
        return ev;
    }
    if ctrl && raylib.IsKeyPressed(.V) {
        clip := clipboard_get_str(context.temp_allocator);
        if clip.count > 0 {
            buffer_insert_text(&ed.buf, clip);
            ev.buffer_modified = true;
            ed.last_version = ed.buf.version;
            editor_ensure_cursor_visible(ed, rect.h);
            editor_ensure_cursor_visible_x(ed, rect.w);
        }
        return ev;
    }
    if raylib.IsKeyPressed(.F12) {
        ev.req_definition = true;
        return ev;
    }
    if ctrl && raylib.IsKeyPressed(.SPACE) {
        ev.req_completion = true;
        return ev;
    }

    // Navigation keys work in both modes (hold Shift to extend selection)
    shift_nav := raylib.IsKeyDown(.LEFT_SHIFT) || raylib.IsKeyDown(.RIGHT_SHIFT);
    if key_trig(.UP) {
        if shift_nav do buffer_start_selection(&ed.buf); else do buffer_clear_selection(&ed.buf);
        ed.buf.cursor_line -= 1;
        buffer_clamp_cursor(&ed.buf);
        editor_ensure_cursor_visible(ed, rect.h);
        ed.blink_timer = 0.0;
    }
    if key_trig(.DOWN) {
        if shift_nav do buffer_start_selection(&ed.buf); else do buffer_clear_selection(&ed.buf);
        ed.buf.cursor_line += 1;
        buffer_clamp_cursor(&ed.buf);
        editor_ensure_cursor_visible(ed, rect.h);
        ed.blink_timer = 0.0;
    }
    if key_trig(.LEFT) {
        if shift_nav do buffer_start_selection(&ed.buf); else do buffer_clear_selection(&ed.buf);
        if ed.buf.cursor_col > 0 {
            ed.buf.cursor_col -= 1;
        } elseif ed.buf.cursor_line > 0 {
            ed.buf.cursor_line -= 1;
            ed.buf.cursor_col = ed.buf.lines[ed.buf.cursor_line].count;
        }
        ed.blink_timer = 0.0;
    }
    if key_trig(.RIGHT) {
        if shift_nav do buffer_start_selection(&ed.buf); else do buffer_clear_selection(&ed.buf);
        cur_len := ed.buf.lines[ed.buf.cursor_line].count;
        if ed.buf.cursor_col < cur_len {
            ed.buf.cursor_col += 1;
        } elseif ed.buf.cursor_line + 1 < ed.buf.lines.count {
            ed.buf.cursor_line += 1;
            ed.buf.cursor_col = 0;
        }
        ed.blink_timer = 0.0;
    }
    if raylib.IsKeyPressed(.HOME) {
        if shift_nav do buffer_start_selection(&ed.buf); else do buffer_clear_selection(&ed.buf);
        ed.buf.cursor_col = 0;
        ed.blink_timer = 0.0;
    }
    if raylib.IsKeyPressed(.END) {
        if shift_nav do buffer_start_selection(&ed.buf); else do buffer_clear_selection(&ed.buf);
        ed.buf.cursor_col = ed.buf.lines[ed.buf.cursor_line].count;
        ed.blink_timer = 0.0;
    }
    if raylib.IsKeyPressed(.PAGE_UP) {
        if shift_nav do buffer_start_selection(&ed.buf); else do buffer_clear_selection(&ed.buf);
        ed.buf.cursor_line -= cast(i32) (rect.h / ed.line_height);
        buffer_clamp_cursor(&ed.buf);
        editor_ensure_cursor_visible(ed, rect.h);
    }
    if raylib.IsKeyPressed(.PAGE_DOWN) {
        if shift_nav do buffer_start_selection(&ed.buf); else do buffer_clear_selection(&ed.buf);
        ed.buf.cursor_line += cast(i32) (rect.h / ed.line_height);
        buffer_clamp_cursor(&ed.buf);
        editor_ensure_cursor_visible(ed, rect.h);
    }

    in_insert := (!ed.modal_enabled) || ed.mode == .Insert;

    if in_insert {
        if ed.modal_enabled && raylib.IsKeyPressed(.ESCAPE) {
            ed.mode = .Normal;
            ed.pending_d = false;
            // Drain char queue so Esc doesn't leak
            while raylib.GetCharPressed() > 0 {}
        } else {
            // Printable character input
            while true {
                ch := raylib.GetCharPressed();
                if ch <= 0 do break;
                if !ctrl && ch >= 32 && ch < 127 {
                    buffer_delete_selection(&ed.buf);
                    buffer_insert_char(&ed.buf, cast(u8) ch);
                    ed.blink_timer = 0.0;
                    editor_ensure_cursor_visible(ed, rect.h);
                }
            }
            if key_trig(.ENTER) || key_trig(.KP_ENTER) {
                buffer_delete_selection(&ed.buf);
                buffer_insert_newline(&ed.buf, settings.g_settings.auto_indent);
                ed.blink_timer = 0.0;
                editor_ensure_cursor_visible(ed, rect.h);
            }
            if key_trig(.TAB) {
                buffer_delete_selection(&ed.buf);
                spaces := settings.g_settings.tab_size;
                if spaces < 1 do spaces = 2;
                for _ in 0 .. spaces do buffer_insert_char(&ed.buf, ' ');
                ed.blink_timer = 0.0;
            }
            if key_trig(.BACKSPACE) {
                if !buffer_delete_selection(&ed.buf) {
                    buffer_backspace(&ed.buf);
                }
                ed.blink_timer = 0.0;
                editor_ensure_cursor_visible(ed, rect.h);
            }
            if key_trig(.DELETE) {
                if !buffer_delete_selection(&ed.buf) {
                    buffer_delete_char(&ed.buf);
                }
                ed.blink_timer = 0.0;
            }
        }
    } else {
        // MODAL NORMAL MODE
        if raylib.IsKeyPressed(.ESCAPE) && lsp_c != null {
            lsp_c.hover_visible = false;
            lsp_c.comp_open = false;
        }
        while true {
            ch := raylib.GetCharPressed();
            if ch <= 0 do break;
            if ctrl do continue;

            if ed.pending_d {
                ed.pending_d = false;
                if ch == 'd' {
                    buffer_delete_line(&ed.buf);
                    editor_ensure_cursor_visible(ed, rect.h);
                }
                continue;
            }
            if ed.pending_g {
                ed.pending_g = false;
                if ch == 'g' {
                    ed.buf.cursor_line = 0;
                    ed.buf.cursor_col  = 0;
                    editor_ensure_cursor_visible(ed, rect.h);
                } elseif ch == 'd' {
                    ev.req_definition = true;
                }
                continue;
            }

            if ed.pending_y {
                ed.pending_y = false;
                if ch == 'y' {
                    txt := buffer_get_selected_text(&ed.buf, context.temp_allocator);
                    clipboard_set_str(txt);
                }
                continue;
            }

            switch ch {
                case 'y' {
                    ed.pending_y = true;
                }
                case 'p' {
                    clip := clipboard_get_str(context.temp_allocator);
                    if clip.count > 0 {
                        buffer_insert_text(&ed.buf, clip);
                        editor_ensure_cursor_visible(ed, rect.h);
                    }
                }
                case 'K' {
                    ev.req_hover = true;
                }
                case 'h' {
                    ed.buf.cursor_col -= 1;
                    buffer_clamp_cursor(&ed.buf);
                }
                case 'j' {
                    ed.buf.cursor_line += 1;
                    buffer_clamp_cursor(&ed.buf);
                    editor_ensure_cursor_visible(ed, rect.h);
                }
                case 'k' {
                    ed.buf.cursor_line -= 1;
                    buffer_clamp_cursor(&ed.buf);
                    editor_ensure_cursor_visible(ed, rect.h);
                }
                case 'l' {
                    ed.buf.cursor_col += 1;
                    buffer_clamp_cursor(&ed.buf);
                }
                case '0' {
                    ed.buf.cursor_col = 0;
                }
                case '$' {
                    ed.buf.cursor_col = ed.buf.lines[ed.buf.cursor_line].count;
                }
                case 'g' {
                    ed.pending_g = true;
                }
                case 'G' {
                    ed.buf.cursor_line = ed.buf.lines.count - 1;
                    ed.buf.cursor_col  = 0;
                    editor_ensure_cursor_visible(ed, rect.h);
                }
                case 'i' {
                    buffer_push_undo(&ed.buf);
                    ed.mode = .Insert;
                }
                case 'a' {
                    buffer_push_undo(&ed.buf);
                    if ed.buf.cursor_col < ed.buf.lines[ed.buf.cursor_line].count {
                        ed.buf.cursor_col += 1;
                    }
                    ed.mode = .Insert;
                }
                case 'o' {
                    ed.buf.cursor_col = ed.buf.lines[ed.buf.cursor_line].count;
                    buffer_insert_newline(&ed.buf);
                    ed.mode = .Insert;
                    editor_ensure_cursor_visible(ed, rect.h);
                }
                case 'O' {
                    ed.buf.cursor_col = 0;
                    buffer_insert_newline(&ed.buf);
                    ed.buf.cursor_line -= 1;
                    ed.buf.cursor_col = 0;
                    ed.mode = .Insert;
                    editor_ensure_cursor_visible(ed, rect.h);
                }
                case 'x' {
                    buffer_push_undo(&ed.buf);
                    buffer_delete_char(&ed.buf);
                }
                case 'd' {
                    ed.pending_d = true;
                }
                case 'u' {
                    buffer_undo(&ed.buf);
                    editor_ensure_cursor_visible(ed, rect.h);
                }
                case 'w' {
                    ln := &ed.buf.lines[ed.buf.cursor_line];
                    c := ed.buf.cursor_col;
                    while c < ln.count && ln.data[c] != ' ' do c += 1;
                    while c < ln.count && ln.data[c] == ' ' do c += 1;
                    ed.buf.cursor_col = c;
                }
                case 'b' {
                    ln := &ed.buf.lines[ed.buf.cursor_line];
                    c := ed.buf.cursor_col;
                    if c > 0 do c -= 1;
                    while c > 0 && ln.data[c] == ' ' do c -= 1;
                    while c > 0 && ln.data[c - 1] != ' ' do c -= 1;
                    ed.buf.cursor_col = c;
                }
                case _ {}
            }
            ed.blink_timer = 0.0;
        }
    }

    if ed.buf.version != ed.last_version {
        ed.last_version = ed.buf.version;
        ev.buffer_modified = true;
    }
    if ed.buf.cursor_line != ed.last_line || ed.buf.cursor_col != ed.last_col {
        ed.last_line = ed.buf.cursor_line;
        ed.last_col  = ed.buf.cursor_col;
        editor_ensure_cursor_visible_x(ed, rect.w);
        ev.cursor_moved = true;
    }

    return ev;
}

#local
apply_completion_insert :: (b: &TextBuffer, text: str) {
    buffer_push_undo(b);
    buffer_clamp_cursor(b);
    ln := &b.lines[b.cursor_line];
    // Backtrack over partial identifier before cursor so completion replaces prefix cleanly
    start := b.cursor_col;
    while start > 0 {
        ch := ln.data[start - 1];
        is_id := (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
        if !is_id do break;
        start -= 1;
    }
    while b.cursor_col > start {
        buffer_backspace(b);
    }
    for i in 0 .. text.count {
        buffer_insert_char(b, text[i]);
    }
}

editor_draw :: (ed: &EditorView, rect: wm.PaneRect, focused: bool, lsp_c: &lsp.LspClient = null) {
    raylib.BeginScissorMode(cast(i32) rect.x, cast(i32) rect.y, cast(i32) rect.w, cast(i32) rect.h);
    defer raylib.EndScissorMode();

    // Background & gutter strip
    theme.draw_rect(rect.x, rect.y, rect.w, rect.h, theme.get_color(.BgBase));
    theme.draw_rect(rect.x, rect.y, ed.gutter_width, rect.h, theme.get_color(.BgPanel));
    raylib.DrawLine(
        cast(i32) (rect.x + ed.gutter_width), cast(i32) rect.y,
        cast(i32) (rect.x + ed.gutter_width), cast(i32) (rect.y + rect.h),
        theme.get_rl(.Border)
    );

    first_vis := cast(i32) (ed.scroll_y / ed.line_height);
    if first_vis < 0 do first_vis = 0;
    vis_count := cast(i32) (rect.h / ed.line_height) + 3;
    last_vis  := first_vis + vis_count;
    if last_vis > ed.buf.lines.count do last_vis = ed.buf.lines.count;

    code_clip_x := rect.x + ed.gutter_width + 1.0f;
    code_clip_w := rect.w - ed.gutter_width - 1.0f;
    if code_clip_w < 1.0f do code_clip_w = 1.0f;

    code_x := rect.x + ed.gutter_width + 8.0f - ed.scroll_x;
    spans: [128] TokenSpan;

    cur_screen_x := code_x;
    cur_screen_y := rect.y + 6.0f;
    max_vis_line_w: f32 = 0.0f;

    // Pass 1: Gutter markers & line numbers (never overwritten by horizontally scrolled code)
    acc_y1: f32 = 0.0f;
    for li in 0 .. ed.buf.lines.count {
        extra_h := editor_line_extra_h(ed, li);
        ly := rect.y + 6.0f + acc_y1 - ed.scroll_y;
        acc_y1 += ed.line_height + extra_h;
        if ly + ed.line_height + extra_h < rect.y do continue;
        if ly > rect.y + rect.h do break;

        line_1 := cast(u32) (li + 1);
        for &m in ed.buf.gutter_markers {
            if m.line == line_1 && (m.path.count == 0 || str.equal(m.path, ed.buf.path)) {
                raylib.DrawCircle(cast(i32) (rect.x + 11.0f), cast(i32) (ly + ed.line_height * 0.45f), 4.5f, theme.rgba_to_rl(m.rgba));
            }
        }
        if settings.g_settings.show_line_numbers {
            lnum := core.tprintf("{}", line_1);
            ln_fs := ed.font_size * 0.85f;
            ln_w := theme.measure_text(lnum, ln_fs);
            ln_col := theme.get_color(.TextPrimary) if li == ed.buf.cursor_line else theme.get_color(.TextDisabled);
            theme.draw_text(rect.x + ed.gutter_width - ln_w - 8.0f, ly + (ed.line_height - ln_fs) * 0.45f, lnum, ln_fs, ln_col);
        }
    }

    // Pass 2: Clipped code viewport (prevents horizontally scrolled text from bleeding into gutter)
    raylib.BeginScissorMode(cast(i32) code_clip_x, cast(i32) rect.y, cast(i32) code_clip_w, cast(i32) rect.h);

    sel_sl, sel_sc, sel_el, sel_ec, has_sel := buffer_get_selection_bounds(&ed.buf);

    acc_y2: f32 = 0.0f;
    for li in 0 .. ed.buf.lines.count {
        extra_h := editor_line_extra_h(ed, li);
        ly := rect.y + 6.0f + acc_y2 - ed.scroll_y;
        acc_y2 += ed.line_height + extra_h;
        if ly + ed.line_height + extra_h < rect.y do continue;
        if ly > rect.y + rect.h do break;

        line_1 := cast(u32) (li + 1);

        // Highlight active line
        if settings.g_settings.highlight_current_line && li == ed.buf.cursor_line {
            theme.draw_rect(code_clip_x, ly - 1.0f, code_clip_w, ed.line_height, theme.get_color(.BgHeader));
        }

        // Syntax-highlighted source line (each span positioned by exact prefix width so cursor never drifts!)
        line_bytes := &ed.buf.lines[li];
        line_str := str.{ line_bytes.data, line_bytes.count };

        // Selection highlight rectangle
        if has_sel && li >= sel_sl && li <= sel_el {
            c0 := sel_sc if li == sel_sl else 0;
            c1 := sel_ec if li == sel_el else line_str.count;
            if c0 > line_str.count do c0 = line_str.count;
            if c1 > line_str.count do c1 = line_str.count;
            sx0 := code_x + theme.measure_text(line_str[0 .. c0], ed.font_size);
            sx1 := code_x + theme.measure_text(line_str[0 .. c1], ed.font_size);
            if li < sel_el do sx1 += ed.char_width * 0.6f;
            if sx1 > sx0 {
                theme.draw_rect(sx0, ly - 1.0f, sx1 - sx0, ed.line_height, theme.get_color(.BgSelection));
            }
        }
        line_end_x := code_x;
        if line_str.count > 0 {
            n_spans := lex_onyx_line(line_str, spans);
            for si in 0 .. n_spans {
                sp := spans[si];
                chunk := line_str[sp.start .. sp.end];
                sx := code_x + theme.measure_text(line_str[0 .. sp.start], ed.font_size);
                theme.draw_text(sx, ly + 1.0f, chunk, ed.font_size, token_color(sp.kind));
            }
            lw := theme.measure_text(line_str, ed.font_size);
            if lw > max_vis_line_w do max_vis_line_w = lw;
            line_end_x = code_x + lw;
        }

        // Diagnostic underlines & inline message from Onyx LSP
        if lsp_c != null {
            for &d in lsp_c.diagnostics {
                if d.line == line_1 && str.equal(d.path, ed.buf.path) {
                    d_col := theme.get_color(.Error) if d.severity == 1 else theme.get_color(.Warning);
                    c0 := cast(i32) d.column - 1;
                    if c0 < 0 do c0 = 0;
                    if c0 > line_str.count do c0 = line_str.count;
                    ux := code_x + theme.measure_text(line_str[0 .. c0], ed.font_size);
                    uw := cast(f32) (d.length if d.length > 0 else 1) * ed.char_width;
                    if uw < ed.char_width do uw = ed.char_width;
                    raylib.DrawLineEx(.{ ux, ly + ed.line_height - 2.0f }, .{ ux + uw, ly + ed.line_height - 2.0f }, 2.0f, theme.rgba_to_rl(d_col));

                    // Show compact inline message at end of line
                    msg_fs := ed.font_size * 0.8f;
                    msg_x := line_end_x + 18.0f;
                    if msg_x < rect.x + rect.w - 40.0f {
                        theme.draw_text(msg_x, ly + (ed.line_height - msg_fs) * 0.5f, core.tprintf("<< {}", d.message), msg_fs, d_col);
                    }
                    break;
                }
            }
        }

        // Inline Tenor / GIF preview card right below `// [TENOR](https://...)` comments
        if extra_h > 0.0f {
            gif_url, ok_g := parse_inline_gif_url(line_str);
            if ok_g {
                ge := gif_cache_request(gif_url);
                gw, gh := gif_display_dims(ge);
                gx := code_x + 4.0f;
                gy := ly + ed.line_height + 4.0f;
                theme.draw_rect(gx - 3.0f, gy - 3.0f, gw + 6.0f, gh + 6.0f, theme.get_color(.BgSurface), 6.0f, theme.get_color(.Border), 1.0f);
                if ge.state == .Ready && ge.has_tex {
                    src_r := raylib.Rectangle.{ 0, 0, cast(f32) ge.tex.width, cast(f32) ge.tex.height };
                    dst_r := raylib.Rectangle.{ gx, gy, gw, gh };
                    raylib.DrawTexturePro(ge.tex, src_r, dst_r, .{ 0, 0 }, 0.0f, .{ 255, 255, 255, 255 });
                } elseif ge.state == .Downloading {
                    theme.draw_text(gx + 8.0f, gy + 7.0f, "Loading Tenor GIF...", 13.0f, theme.get_color(.Info));
                } else {
                    theme.draw_text(gx + 8.0f, gy + 7.0f, "Could not load GIF", 13.0f, theme.get_color(.Error));
                }
            }
        }

        // Cursor rendering
        if li == ed.buf.cursor_line {
            prefix := line_str[0 .. ed.buf.cursor_col] if ed.buf.cursor_col <= line_str.count else line_str;
            cur_x := code_x + theme.measure_text(prefix, ed.font_size);
            cur_screen_x = cur_x;
            cur_screen_y = ly;
            if focused && (cast(i32) (ed.blink_timer * 2.0f) % 2) == 0 {
                in_insert := (!ed.modal_enabled) || ed.mode == .Insert;
                if in_insert {
                    theme.draw_rect(cur_x, ly, 2.0f, ed.line_height - 2.0f, theme.get_color(.Success));
                } else {
                    theme.draw_rect(cur_x, ly, ed.char_width, ed.line_height - 2.0f, 0xB4BEFEAA);
                }
            }
        }
    }

    // Subtle horizontal scrollbar indicator when visible lines overflow pane width
    max_content_w := max_vis_line_w + 32.0f;
    if max_content_w > code_clip_w && code_clip_w > 30.0f {
        max_sx := max_content_w - code_clip_w;
        if ed.scroll_x > max_sx do ed.scroll_x = max_sx;
        bar_w := code_clip_w * (code_clip_w / max_content_w);
        if bar_w < 28.0f do bar_w = 28.0f;
        bar_x := code_clip_x + (ed.scroll_x / max_sx) * (code_clip_w - bar_w);
        theme.draw_rect(bar_x, rect.y + rect.h - 6.0f, bar_w, 4.0f, 0x6C708699, 2.0f);
    }

    // Restore full pane scissor for floating hover/completion popups
    raylib.BeginScissorMode(cast(i32) rect.x, cast(i32) rect.y, cast(i32) rect.w, cast(i32) rect.h);

    // Floating LSP Hover Tooltip (`K`)
    if lsp_c != null && lsp_c.hover_visible && lsp_c.hover_text.count > 0 {
        draw_hover_popup(rect, cur_screen_x, cur_screen_y, ed.line_height, lsp_c.hover_text);
    }

    // Floating LSP Completion Popup (`Ctrl+Space`)
    if lsp_c != null && lsp_c.comp_open && lsp_c.completions.count > 0 {
        draw_completion_popup(rect, cur_screen_x, cur_screen_y, ed.line_height, lsp_c);
    }
}

#local
draw_hover_popup :: (rect: wm.PaneRect, cx, cy, line_h: f32, text: str) {
    s := settings.g_settings.ui_scale;
    fs := 13.0f * s;
    lh := fs * 1.35f;

    // Split into up to 8 lines & measure box width
    lines: [8] str;
    n_lines := 0;
    max_w: f32 = 160.0f;
    start := 0;
    for i in 0 .. (text.count + 1) {
        if i == text.count || text[i] == '\n' {
            if n_lines < 8 {
                ln := text[start .. i];
                lines[n_lines] = ln;
                n_lines += 1;
                w := theme.measure_text(ln, fs);
                if w > max_w do max_w = w;
            }
            start = i + 1;
        }
    }
    if n_lines == 0 do return;

    box_w := max_w + 22.0f;
    if box_w > rect.w - 20.0f do box_w = rect.w - 20.0f;
    box_h := cast(f32) n_lines * lh + 16.0f;

    bx := cx;
    if bx + box_w > rect.x + rect.w - 8.0f do bx = rect.x + rect.w - box_w - 8.0f;
    if bx < rect.x + 8.0f do bx = rect.x + 8.0f;

    by := cy - box_h - 6.0f;
    if by < rect.y + 6.0f do by = cy + line_h + 4.0f;

    theme.draw_rect(bx, by, box_w, box_h, theme.get_color(.BgSurface), 6.0f, theme.get_color(.BorderFocused), 1.5f);
    for i in 0 .. n_lines {
        theme.draw_text(bx + 10.0f, by + 8.0f + cast(f32) i * lh, lines[i], fs, theme.get_color(.TextPrimary));
    }
}

#local
draw_completion_popup :: (rect: wm.PaneRect, cx, cy, line_h: f32, lsp_c: &lsp.LspClient) {
    s := settings.g_settings.ui_scale;
    fs := 13.0f * s;
    row_h := 24.0f * s;
    vis := lsp_c.completions.count if lsp_c.completions.count < 8 else 8;
    box_w := 320.0f * s;
    if box_w > rect.w - 20.0f do box_w = rect.w - 20.0f;
    box_h := cast(f32) vis * row_h + 8.0f;

    bx := cx;
    if bx + box_w > rect.x + rect.w - 8.0f do bx = rect.x + rect.w - box_w - 8.0f;
    by := cy + line_h + 2.0f;
    if by + box_h > rect.y + rect.h - 6.0f do by = cy - box_h - 4.0f;

    theme.draw_rect(bx, by, box_w, box_h, theme.get_color(.BgPanel), 6.0f, theme.get_color(.BorderFocused), 1.5f);

    start_i := 0;
    if lsp_c.comp_selected >= vis {
        start_i = lsp_c.comp_selected - vis + 1;
    }

    for r in 0 .. vis {
        idx := start_i + r;
        if idx >= lsp_c.completions.count do break;
        item := &lsp_c.completions[idx];
        ry := by + 4.0f + cast(f32) r * row_h;
        if idx == lsp_c.comp_selected {
            theme.draw_rect(bx + 4.0f, ry, box_w - 8.0f, row_h - 1.0f, theme.get_color(.BgSelection), 4.0f);
        }
        theme.draw_text(bx + 10.0f, ry + (row_h - fs) * 0.5f, item.label, fs, theme.get_color(.TextPrimary));
        if item.detail.count > 0 {
            dw := theme.measure_text(item.detail, fs * 0.85f);
            if bx + box_w - dw - 10.0f > bx + 120.0f {
                theme.draw_text(bx + box_w - dw - 10.0f, ry + (row_h - fs * 0.85f) * 0.5f, item.detail, fs * 0.85f, theme.get_color(.TextSecondary));
            }
        }
    }
}
