package odit.settings

// =============================================================================
// Onyx Editor ("odit") — Persistent User Settings (`odit.json`)
// =============================================================================

use core { package, os, printf, Array }
use core.encoding.json

PluginSetting :: struct {
    key:         str;
    label:       str;
    kind:        u32; // abi.SettingKind: 0=String, 1=Bool, 2=Int, 3=Float
    default_val: str;
    value:       str;
    registered:  bool; // true once a plugin has registered label/kind
}

Settings :: struct {
    // Typography & Scaling
    editor_font_size:       f32;  // px (default 18.0, range 10..36)
    ui_scale:               f32;  // multiplier for chrome/plugins (default 1.15, range 0.8..2.0)
    line_height_factor:     f32;  // line height = font_size * factor (default 1.4, range 1.1..2.0)
    font_path:              str;  // optional custom .ttf path (empty = auto-detect)

    // Appearance
    theme:                  str;  // "mocha" | "tokyo_night" | "gruvbox" | "light"

    // Editor Behavior
    tab_size:               i32;  // spaces per Tab (2, 4, or 8; default 4)
    modal_editing:          bool; // Vim-style Normal/Insert vs Always-Insert (default true)
    show_line_numbers:      bool; // Show gutter line numbers (default true)
    highlight_current_line: bool; // Subtle highlight on active line (default true)
    auto_indent:            bool; // Preserve leading indent on Enter (default true)

    // Layout & Performance
    split_ratio:            f32;  // Editor vs Plugin pane ratio (default 0.58)
    target_fps:             i32;  // Raylib FPS cap (default 60)
}

SETTINGS_FILE :: "odit.json"

g_settings:        Settings;
g_settings_path:   str = SETTINGS_FILE;
g_plugin_settings: [..] PluginSetting;
g_ps_inited:       bool = false;

#local
ensure_ps_init :: () {
    if !g_ps_inited {
        g_plugin_settings = make([..] PluginSetting);
        g_ps_inited = true;
    }
}

#local
json_esc_setting :: (s: str, allocator := context.temp_allocator) -> str {
    out := make(dyn_str, s.count + 16, allocator);
    for i in 0 .. s.count {
        c := s[i];
        if c == '"'       do Array.concat(&out, "\\\"");
        elseif c == '\\'  do Array.concat(&out, "\\\\");
        elseif c == '\n'  do Array.concat(&out, "\\n");
        elseif c >= 32    do out << c;
    }
    return out;
}

/// Registers a plugin setting (preserving any previously saved value in `odit.json`).
settings_register_plugin :: (key: str, label: str, kind: u32, default_val: str) -> u32 {
    ensure_ps_init();
    if key.count == 0 do return 0;
    for i in 0 .. g_plugin_settings.count {
        ps := &g_plugin_settings[i];
        if str.equal(ps.key, key) {
            if label.count > 0 {
                if ps.label.count > 0 do str.free(ps.label);
                ps.label = str.copy(label);
            }
            ps.kind = kind;
            if ps.default_val.count > 0 do str.free(ps.default_val);
            ps.default_val = str.copy(default_val);
            if ps.value.count == 0 && default_val.count > 0 {
                ps.value = str.copy(default_val);
            }
            ps.registered = true;
            return cast(u32) (i + 1);
        }
    }
    g_plugin_settings << .{
        key         = str.copy(key),
        label       = str.copy(label if label.count > 0 else key),
        kind        = kind,
        default_val = str.copy(default_val),
        value       = str.copy(default_val),
        registered  = true,
    };
    return cast(u32) g_plugin_settings.count;
}

settings_get_plugin :: (key: str) -> str {
    ensure_ps_init();
    for &ps in g_plugin_settings {
        if str.equal(ps.key, key) do return ps.value;
    }
    return "";
}

settings_set_plugin :: (key: str, val: str) -> bool {
    ensure_ps_init();
    if key.count == 0 do return false;
    for &ps in g_plugin_settings {
        if str.equal(ps.key, key) {
            if ps.value.count > 0 do str.free(ps.value);
            ps.value = str.copy(val);
            settings_save();
            return true;
        }
    }
    g_plugin_settings << .{
        key         = str.copy(key),
        label       = str.copy(key),
        kind        = 0,
        default_val = str.copy(val),
        value       = str.copy(val),
        registered  = false,
    };
    settings_save();
    return true;
}

#local
load_plugin_settings_from_json :: (contents: str) {
    ensure_ps_init();
    // Locate `"plugin_settings": { ... }`
    needle := "\"plugin_settings\"";
    pos := -1;
    if contents.count >= needle.count {
        for i in 0 .. (contents.count - needle.count + 1) {
            ok := true;
            for j in 0 .. needle.count {
                if contents[i + j] != needle[j] { ok = false; break; }
            }
            if ok { pos = i + needle.count; break; }
        }
    }
    if pos < 0 do return;

    while pos < contents.count && contents[pos] != '{' do pos += 1;
    if pos >= contents.count do return;
    pos += 1; // skip '{'

    while pos < contents.count {
        while pos < contents.count && (contents[pos] == ' ' || contents[pos] == '\t' || contents[pos] == '\n' || contents[pos] == '\r' || contents[pos] == ',') do pos += 1;
        if pos >= contents.count || contents[pos] == '}' do break;
        if contents[pos] != '"' { pos += 1; continue; }

        // Read key
        pos += 1;
        ks := pos;
        while pos < contents.count && contents[pos] != '"' do pos += 1;
        key := contents[ks .. pos];
        if pos < contents.count do pos += 1;

        while pos < contents.count && contents[pos] != ':' do pos += 1;
        if pos < contents.count do pos += 1;
        while pos < contents.count && (contents[pos] == ' ' || contents[pos] == '\t') do pos += 1;
        if pos >= contents.count do break;

        // Read value (supports both quoted strings `"0.5"` and unquoted JSON primitives `0.5`, `true`, `10`)
        vbuf := make([..] u8, 32, context.temp_allocator);
        if contents[pos] == '"' {
            pos += 1;
            while pos < contents.count && contents[pos] != '"' {
                if contents[pos] == '\\' && pos + 1 < contents.count {
                    pos += 1;
                }
                vbuf << contents[pos];
                pos += 1;
            }
            if pos < contents.count do pos += 1;
        } else {
            while pos < contents.count && contents[pos] != ',' && contents[pos] != '}' && contents[pos] != '\n' && contents[pos] != '\r' && contents[pos] != ' ' && contents[pos] != '\t' {
                vbuf << contents[pos];
                pos += 1;
            }
        }
        val := str.{ vbuf.data, vbuf.count };

        // Store or update
        found := false;
        for &ps in g_plugin_settings {
            if str.equal(ps.key, key) {
                if ps.value.count > 0 do str.free(ps.value);
                ps.value = str.copy(val);
                found = true;
                break;
            }
        }
        if !found && key.count > 0 {
            g_plugin_settings << .{
                key         = str.copy(key),
                label       = str.copy(key),
                kind        = 0,
                default_val = str.copy(val),
                value       = str.copy(val),
                registered  = false,
            };
        }
    }
}

settings_set_path :: (path: str) {
    if path.count > 0 do g_settings_path = str.copy(path);
}

settings_defaults :: () -> Settings {
    return .{
        editor_font_size       = 18.0f,
        ui_scale               = 1.15f,
        line_height_factor     = 1.4f,
        font_path              = "",
        theme                  = "mocha",
        tab_size               = 4,
        modal_editing          = true,
        show_line_numbers      = true,
        highlight_current_line = true,
        auto_indent            = true,
        split_ratio            = 0.58f,
        target_fps             = 60,
    };
}

settings_clamp :: (s: &Settings) {
    if s.editor_font_size < 10.0f do s.editor_font_size = 10.0f;
    if s.editor_font_size > 36.0f do s.editor_font_size = 36.0f;

    if s.ui_scale < 0.8f do s.ui_scale = 0.8f;
    if s.ui_scale > 2.0f do s.ui_scale = 2.0f;

    if s.line_height_factor < 1.1f do s.line_height_factor = 1.1f;
    if s.line_height_factor > 2.0f do s.line_height_factor = 2.0f;

    if s.tab_size < 1 do s.tab_size = 2;
    if s.tab_size > 8 do s.tab_size = 8;

    if s.split_ratio < 0.25f do s.split_ratio = 0.25f;
    if s.split_ratio > 0.85f do s.split_ratio = 0.85f;

    if s.target_fps < 30 do s.target_fps = 30;
    if s.target_fps > 240 do s.target_fps = 240;

    if s.theme.count == 0 do s.theme = "mocha";
}

settings_load :: (path: str = "") -> bool {
    eff := path if path.count > 0 else g_settings_path;
    g_settings = settings_defaults();

    if !os.file_exists(eff) {
        return false;
    }

    contents := os.get_contents(eff);
    if contents.count == 0 do return false;
    defer delete(&contents);

    switch json.decode_as(contents, Settings) {
        case .Ok as loaded {
            g_settings = loaded;
            g_settings.theme     = str.copy(loaded.theme if loaded.theme.count > 0 else "mocha");
            g_settings.font_path = str.copy(loaded.font_path);
            settings_clamp(&g_settings);
            load_plugin_settings_from_json(contents);
            return true;
        }
        case .Err {
            printf("[odit] Warning: could not parse {}, using defaults\n", eff);
            return false;
        }
    }
}

settings_save :: (path: str = "") -> bool {
    ensure_ps_init();
    eff := path if path.count > 0 else g_settings_path;
    settings_clamp(&g_settings);
    out := make(dyn_str, 512, context.temp_allocator);
    Array.concat(&out, core.tprintf("""{{
    "editor_font_size": {},
    "ui_scale": {},
    "line_height_factor": {},
    "font_path": "{}",
    "theme": "{}",
    "tab_size": {},
    "modal_editing": {},
    "show_line_numbers": {},
    "highlight_current_line": {},
    "auto_indent": {},
    "split_ratio": {},
    "target_fps": {}""",
        g_settings.editor_font_size,
        g_settings.ui_scale,
        g_settings.line_height_factor,
        g_settings.font_path,
        g_settings.theme,
        g_settings.tab_size,
        "true" if g_settings.modal_editing else "false",
        "true" if g_settings.show_line_numbers else "false",
        "true" if g_settings.highlight_current_line else "false",
        "true" if g_settings.auto_indent else "false",
        g_settings.split_ratio,
        g_settings.target_fps,
    ));
    if g_plugin_settings.count > 0 {
        Array.concat(&out, ",\n    \"plugin_settings\": {\n");
        for i in 0 .. g_plugin_settings.count {
            ps := &g_plugin_settings[i];
            Array.concat(&out, core.tprintf("        \"{}\": \"{}\"{}\n",
                json_esc_setting(ps.key),
                json_esc_setting(ps.value),
                "," if i + 1 < g_plugin_settings.count else ""
            ));
        }
        Array.concat(&out, "    }\n}\n");
    } else {
        Array.concat(&out, "\n}\n");
    }
    return os.File.write_contents(eff, out);
}

settings_reset :: () {
    g_settings = settings_defaults();
    settings_save();
}

settings_cycle_theme :: () -> str {
    next := "mocha";
    if str.equal(g_settings.theme, "mocha")            do next = "tokyo_night";
    elseif str.equal(g_settings.theme, "tokyo_night")  do next = "gruvbox";
    elseif str.equal(g_settings.theme, "gruvbox")      do next = "light";
    else                                               do next = "mocha";
    g_settings.theme = str.copy(next);
    return g_settings.theme;
}
